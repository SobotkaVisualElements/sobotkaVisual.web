---
import BaseLayout from './BaseLayout.astro';
import type { Project } from '../lib/projects';
import Blocks from '../components/blocks/Blocks.astro';
import LayerTile from '../components/ui/LayerTile.astro';
import VideoLoop from '../components/ui/VideoLoop.astro';
import { nbspHtml } from '../lib/typo';
import { collabInfo } from '../lib/collab';

interface Props {
	project: Project;
	next?: Project;
}

const { project, next } = Astro.props;
// treść z panelu: krótkie słowa i liczby nie zostają same na końcu linii
const body = nbspHtml(await Astro.slots.render('default'));
const { title, description, category, tech, year, role, client, url, repo, cover, coverFocalX, coverFocalY } = project.data;

const facts = [
	role && { label: 'Zakres', value: role },
	client && { label: 'Klient', value: client },
	...(collabInfo(project.data)
		? [{ label: 'Współpraca stała', value: [collabInfo(project.data)!.range, collabInfo(project.data)!.len].filter(Boolean).join(' · '), status: collabInfo(project.data)! }]
		: [{ label: 'Rok', value: String(year) }]),
	{ label: 'Kategoria', value: category },
].filter(Boolean) as { label: string; value: string; status?: any }[];

// data realizacji (pole „Data realizacji” w panelu); bez niej tylko rok
const d: any = project.data;
const made: Date | undefined = d.date instanceof Date && !isNaN(+d.date) ? d.date : undefined;
const madeISO = made ? made.toISOString().slice(0, 10) : String(year);
const madeLabel = made ? made.toLocaleDateString('pl-PL', { month: 'long', year: 'numeric' }) : String(year);
const site = 'https://sobotkavisual.pl';
const pageUrl = `${site}/work/${project.id}/`;
const abs = (u?: string) => (u ? (u.startsWith('http') ? u : site + u) : undefined);
const img = abs(cover || d.poster || d.layers?.find((l: any) => l?.image)?.image);
// dane strukturalne: realizacja jako CreativeWork autorstwa studia + okruszki
const ld = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CreativeWork',
			'@id': `${pageUrl}#realizacja`,
			name: title,
			headline: title,
			description,
			url: pageUrl,
			...(img ? { image: img } : {}),
			dateCreated: madeISO,
			genre: category,
			inLanguage: 'pl',
			...(role ? { keywords: role } : {}),
			creator: { '@type': 'Organization', '@id': `${site}/#firma`, name: 'Sobotka Visual Creations' },
			...(client ? { mentions: { '@type': 'Organization', name: client } } : {}),
			...(/^[\w-]{11}$/.test(d.youtube || '') ? { video: { '@type': 'VideoObject', name: title, description, embedUrl: `https://www.youtube.com/embed/${d.youtube}`, ...(img ? { thumbnailUrl: img } : {}), uploadDate: madeISO } } : {}),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site}/` },
				{ '@type': 'ListItem', position: 2, name: 'Realizacje', item: `${site}/work/` },
				{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
			],
		},
	],
};
---

<BaseLayout title={title} description={description} type="article" image={img}>
	<script type="application/ld+json" set:html={JSON.stringify(ld)} />
	<article data-pagefind-body data-pagefind-filter="type:Work">
		<header class="border-b-2 border-line bg-paper">
			<div class="mx-auto max-w-[860px] px-6 pt-16 pb-10">
				<a
					href="/work"
					class="inline-flex items-center gap-1 text-sm font-bold text-orange-deep hover:text-orange"
				>
					← Wszystkie realizacje
				</a>

				<div class="mt-6 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.1em] text-orange-deep">
					<span>{category}</span>
					<span class="text-ink/30" aria-hidden="true">·</span>
					<time class="text-ink/60" datetime={madeISO}>{madeLabel}</time>
					{(project.data as any).clientLogo && (
						<img src={(project.data as any).clientLogo} alt={client ? `Logo: ${client}` : 'Logo klienta'} class:list={['ml-auto h-11 w-auto max-w-[170px] object-contain', (project.data as any).clientLogoTone !== 'oryginalne' && 'logo-dark']} />
					)}
				</div>

				<h1 class="mt-3 text-[clamp(2rem,5vw,3.1rem)] font-bold leading-[1.06] tracking-[-0.02em] text-balance text-ink" set:html={nbspHtml(title.replace(/&/g, "&amp;").replace(/</g, "&lt;"))} />
				<p class="mt-4 max-w-[640px] text-lg text-ink/70 text-pretty" set:html={nbspHtml(description.replace(/&/g, "&amp;").replace(/</g, "&lt;"))} />
				{((project.data as any).youtube || (project.data as any).video || (project.data as any).videoUrl) ? (
					<div class="liquid-card liquid-light mt-8 rounded-[24px] p-3">
						<div class="overflow-hidden rounded-[16px]">
							<VideoLoop youtube={/\.(mp4|webm|mov|m4v)(\?|#|$)/i.test((project.data as any).youtube || '') ? '' : (project.data as any).youtube} file={(project.data as any).videoUrl || (/\.(mp4|webm|mov|m4v)(\?|#|$)/i.test((project.data as any).youtube || '') ? (project.data as any).youtube : '') || (project.data as any).video} poster={cover} title={title} eager />
						</div>
					</div>
				) : ((project.data as any).layers?.some((l: any) => l?.image) || cover) && (
					<div class="liquid-card liquid-light mt-8 rounded-[24px] p-3">
						<div class="overflow-hidden rounded-[16px]">
							<LayerTile layers={(project.data as any).layers} image={cover} strength={(project.data as any).parallaxStrength ?? 100} focalX={coverFocalX} focalY={coverFocalY} alt={title} placeholder="light" eager />
						</div>
					</div>
				)}

				{
					(url || repo) && (
						<div class="mt-6 flex flex-wrap gap-3">
							{url && (
								<a
									href={url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 rounded-full bg-orange px-5 py-2.5 text-sm font-bold text-cloud shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-px hover:-translate-y-px hover:shadow-pop"
								>
									Zobacz projekt →
								</a>
							)}
							{repo && (
								<a
									href={repo}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 rounded-full border-2 border-ink px-5 py-2.5 text-sm font-bold text-ink transition-colors hover:bg-orange-soft"
								>
									Repository
								</a>
							)}
						</div>
					)
				}
			</div>
		</header>

		<div class="mx-auto max-w-[860px] px-6 py-12">
			<dl class="mb-10 grid gap-6 rounded-card border-2 border-ink bg-cloud p-6 shadow-pop-sm sm:grid-cols-4">
				{
					facts.map((fact) => (
						<div>
							<dt class="text-xs font-bold uppercase tracking-wider text-ink/60">
								{fact.label}
							</dt>
							<dd class="mt-1 font-semibold text-ink">
								{fact.status && <span class:list={['collab-pill', fact.status.active ? 'is-on' : 'is-off']}><i></i>{fact.status.status}</span>}
								{fact.value}
							</dd>
						</div>
					))
				}
			</dl>

			{
				tech.length > 0 && (
					<div class="mb-10 flex flex-wrap gap-2">
						{tech.map((t) => (
							<span class="rounded-md bg-orange-soft px-2.5 py-1 text-sm font-semibold text-orange-deep">
								{t}
							</span>
						))}
					</div>
				)
			}

			<div class="prose prose-pl max-w-none" set:html={body} />
			{(project.data as any).blocks?.length > 0 && <Blocks blocks={(project.data as any).blocks} theme="light" />}
		</div>
	</article>

	{
		next && (
			<nav class="mx-auto max-w-[860px] px-6 pb-20" aria-label="Następna realizacja">
				<a
					href={`/work/${next.id}`}
					class="group flex items-center justify-between gap-4 rounded-card border-2 border-ink bg-cloud p-6 shadow-pop-sm transition-[transform,box-shadow] hover:-translate-y-0.5 hover:shadow-pop"
				>
					<span>
						<span class="text-xs font-bold uppercase tracking-wider text-ink/60">
							Następna realizacja
						</span>
						<span class="mt-1 block text-xl font-bold text-ink group-hover:text-navy">
							{next.data.title}
						</span>
					</span>
					<span class="text-2xl text-orange-deep transition-transform group-hover:translate-x-1" aria-hidden="true">
						→
					</span>
				</a>
			</nav>
		)
	}
</BaseLayout>
