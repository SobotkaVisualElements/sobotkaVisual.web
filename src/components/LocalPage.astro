---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props {
	h1: string; title: string; description: string; miasto?: string;
	intro: string; problemy: string[]; zakres: { name: string; price: string }[]; faq: { q: string; a: string }[];
}
const { h1, title, description, miasto, intro, problemy, zakres, faq } = Astro.props;
---
<BaseLayout title={title} description={description}>
	<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
		<div class="relative z-2 mx-auto max-w-[900px] px-6 pt-24 pb-16 sm:px-8">
			{miasto && <span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">{miasto}</span>}
			<h1 class="mt-3 text-[34px] leading-[1.06] font-bold tracking-[-0.02em] md:text-[50px]">{h1}</h1>
			<p class="mt-5 max-w-[640px] text-[18px] leading-[1.6] text-sky-mist">{intro}</p>
			<div class="mt-8 flex flex-wrap gap-3.5">
				<a href="/generator" class="btn-saber rounded-full bg-orange px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Wyceń w 60 sekund</a>
				<a href="/work" class="btn-saber rounded-full border-2 border-cloud/70 px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Zobacz realizacje</a>
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
		<div class="relative z-2 mx-auto max-w-[900px] px-6 py-16 sm:px-8">
			<h2 class="text-[30px] font-bold tracking-[-0.02em]">Z czym najczęściej przychodzą klienci</h2>
			<div class="mt-7 grid gap-4 sm:grid-cols-2">
				{problemy.map((p) => (
					<div class="liquid-card glass rounded-2xl p-5 text-[15px] leading-relaxed text-sky-mist">{p}</div>
				))}
			</div>

			<h2 class="mt-14 text-[30px] font-bold tracking-[-0.02em]">Zakres i ceny</h2>
			<div class="mt-6 glass overflow-hidden rounded-2xl">
				{zakres.map((z) => (
					<div class="flex items-center justify-between gap-4 border-b border-white/8 px-5 py-4 text-[15px] last:border-0">
						<span class="text-cloud">{z.name}</span>
						<span class="shrink-0 font-semibold text-orange-glow">{z.price}</span>
					</div>
				))}
			</div>
			<a href="/generator" class="liquid-card mt-8 flex flex-col items-center gap-4 rounded-[24px] border-2 border-orange bg-linear-100 from-orange-deep via-orange to-orange-bright px-7 py-8 text-center shadow-[0_18px_50px_-12px_rgba(237,36,78,.65)] sm:flex-row sm:justify-between sm:text-left">
				<span>
					<span class="block font-display text-[24px] leading-tight font-bold text-cloud">Policz swój pakiet</span>
					<span class="mt-1 block text-[15px] text-white/85">Ustaw zakres suwakami — rabat rośnie do 30%.</span>
				</span>
				<span class="shrink-0 rounded-full bg-cloud px-6 py-3 font-bold text-navy-deep">Otwórz generator →</span>
			</a>

			<h2 class="mt-14 text-[30px] font-bold tracking-[-0.02em]">Pytania i odpowiedzi</h2>
			<div class="mt-6 flex flex-col gap-3.5">
				{faq.map((f) => (
					<div class="glass rounded-2xl p-5">
						<h3 class="font-display text-[17px] font-semibold text-cloud">{f.q}</h3>
						<p class="mt-2 text-[15px] leading-relaxed text-sky-mist">{f.a}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
	})} />
</BaseLayout>
