---
/*
 * Podstrona usługi w mieście (np. /uslugi/montaz-wideo-opole/).
 * Zasada: czytelność przede wszystkim (projektujemy też dla osób 40+): duży tekst, wyraźne przyciski, telefon zawsze pod ręką.
 * Pierwszy ekran: panorama miasta (wektor), ikona usługi, najważniejsze fakty. Niżej: ceny, oferta, proces, realizacje, FAQ.
 * Treść każdej podstrony jest w jej pliku — ten szablon jest wspólny dla wszystkich miast.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CityPanorama from './ui/CityPanorama.astro';
import IsoIcon from './iso/IsoIcon.astro';
import OfferButton from './ui/OfferButton.astro';
import Carousel3D from './ui/Carousel3D.astro';
import BookingCta from './ui/BookingCta.astro';
import Process from './landing/Process.astro';
import { getPublishedProjects } from '../lib/projects';
import home from '../data/home.json';
import { miasta, miastoBy, zdalnie } from '../data/miasta';

interface Props {
	h1: string; title: string; description: string; miasto?: string;
	intro: string; problemy: string[]; zakres: { name: string; price: string }[]; faq: { q: string; a: string }[];
}
const { h1, title, description, miasto, intro, problemy, zakres, faq } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
// prawdziwe miasto (a nie np. „YouTube” albo „Kluby sportowe”)
const isCity = !!miasto && !/youtube|klub/i.test(miasto);

// rodzaj usługi z nagłówka → ikona, gotowa oferta w generatorze i strona usługi
const M = miastoBy(miasto);
const t = h1.toLowerCase();
const S = /transmis/.test(t) ? { icon: 'wykres', gen: 'tryb=jednorazowa&x=trans', svc: '/uslugi/oprawa-transmisyjna/', name: 'oprawę transmisji' }
	: /animac|motion/.test(t) ? { icon: 'rakieta', gen: 'tryb=jednorazowa&animacja=2&rolkaani=1', svc: '/uslugi/animacja-motion-design/', name: 'animację' }
	: /film/.test(t) ? { icon: 'kamera', gen: 'tryb=jednorazowa&zdjecia=1&wizerunek=1', svc: '/uslugi/montaz-wideo/', name: 'film' }
	: /rolk|social/.test(t) ? { icon: 'telefon', gen: 'pakiet=start', svc: '/uslugi/rolki-i-krotkie-formy/', name: 'rolki' }
	: /graf|projektow|miniatur/.test(t) ? { icon: 'tablet', gen: 'tryb=jednorazowa&miniatury=6&grafika=6', svc: '/uslugi/oprawa-graficzna/', name: 'grafikę' }
	: { icon: 'monitor', gen: 'tryb=jednorazowa&montaz=1&dzwiek=1', svc: '/uslugi/montaz-wideo/', name: 'montaż' };
const gen = `/generator?${S.gen}&utm_source=miasto&utm_campaign=${encodeURIComponent(here.split('/').pop() || '')}`;

const fakty = ['Działamy od 2020 roku', M ? `Dojazd: ${M.dojazd}` : 'Zdalnie w całej Polsce', 'Odpowiedź w 24 h', 'Ceny jawne, bez gwiazdek'];

const projects = (await getPublishedProjects()).slice(0, 8);
const work = projects.map((p: any) => ({ href: `/work/${p.id}`, title: p.data.title, category: p.data.category, logo: p.data.clientLogo, logoTone: p.data.clientLogoTone,
	img: p.data.cover || p.data.layers?.find((l: any) => l?.image)?.image || p.data.poster || '' }));

// dojazd do tego miasta + linki do innych miast i usług (wspólne dane: src/data/miasta.ts)
const others = miasta.flatMap((m) => m.pages.map(([h, l]) => [h, `${l} ${m.name}`] as [string, string])).filter(([h]) => h !== here);
// na widoku tylko kilka sensownych linków: inne usługi w tym samym mieście + ta sama usługa w najbliższych miastach; reszta pod „Pokaż wszystkie”
const sameCity = M ? M.pages.filter(([h]) => h !== here).map(([h, l]) => [h, `${l} ${M.name}`] as [string, string]) : [];
const near = M ? miasta.filter((m) => m !== M).map((m) => ({ m, d: Math.hypot((m.lon - M.lon) * 0.62, m.lat - M.lat) })).sort((a, b) => a.d - b.d).slice(0, 3)
	.map(({ m }) => { const p = m.pages.find(([, l]) => l.toLowerCase().startsWith(S.name.slice(0, 4))) ?? m.pages[0]; return [p[0], `${p[1]} ${m.name}`] as [string, string]; }) : [];
const shown = [...sameCity, ...near].slice(0, 7);
const rest = others.filter(([h]) => !shown.some(([x]) => x === h));
---
<BaseLayout title={title} description={description}>
	<!-- 1. PIERWSZY EKRAN: panorama miasta -->
	<section class="lp-hero relative overflow-hidden text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-25"></span>
		<div class="lp-pano" aria-hidden="true"><CityPanorama miasto={miasto} /></div>
		<div class="relative z-2 mx-auto grid max-w-[1200px] items-center gap-8 px-6 pt-24 sm:px-8 lg:grid-cols-[1.35fr_1fr]">
			<div>
				<nav class="lp-crumbs" aria-label="Okruszki"><a href="/">Strona główna</a><span>›</span><a href="/uslugi/">Usługi</a><span>›</span><b>{h1}</b></nav>
				{miasto && <span class="lp-city">{isCity ? `📍 ${miasto} i okolice` : miasto}</span>}
				<h1 class="mt-3 text-[38px] leading-[1.05] font-bold tracking-[-0.02em] md:text-[58px]">{h1}</h1>
				<p class="mt-5 max-w-[620px] text-[19px] leading-[1.65] text-sky-mist">{intro}</p>
				<ul class="lp-facts">{fakty.map((x) => <li><span aria-hidden="true">✓</span>{x}</li>)}</ul>
				<div class="mt-8 flex flex-wrap gap-3.5">
					<a href={gen} class="lp-btn lp-btn-acc btn-saber">Policz cenę w 60 sekund →</a>
					<a href="tel:+48668472759" class="lp-btn lp-btn-ghost">📞 668 472 759</a>
				</div>
			</div>
			<div class="lp-ico hidden lg:block" aria-hidden="true"><IsoIcon name={S.icon} /></div>
		</div>
	</section>

	<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
		<div class="relative z-2 mx-auto max-w-[960px] px-6 py-16 sm:px-8">
			<!-- 2. PROBLEMY -->
			<h2 class="lp-h2">Z czym najczęściej przychodzą klienci{M ? ` z ${M.gen}` : ''}</h2>
			<div class="mt-7 grid gap-4 sm:grid-cols-2">
				{problemy.map((p) => (
					<div class="lp-prob liquid-card glass"><span class="lp-prob-i" aria-hidden="true">!</span><p>{p}</p></div>
				))}
			</div>
			<p class="lp-answer">Każdy z tych problemów rozwiązujemy w jednym miejscu: nagranie, montaż, animacja i grafika bez szukania podwykonawców.</p>

			<!-- 3. CENY -->
			<h2 class="lp-h2 mt-16" id="ceny">Zakres i ceny</h2>
			<p class="mt-2 text-[16px] text-sky-mist">Ceny końcowe — nie doliczamy VAT (zwolnienie z VAT). Dokładną kwotę dla swojego zakresu zobaczysz w generatorze — bez dzwonienia i czekania.</p>
			<div class="lp-table glass mt-6">
				{zakres.map((z) => (
					<div class="lp-row"><span>{z.name}</span><b>{z.price}</b></div>
				))}
			</div>
			{M && (
				<div class:list={['lp-travel', M.free && 'is-free']}>
					<span class="lp-travel-ico" aria-hidden="true">🚗</span>
					<div>
						<b>Dojazd do {M.gen}: {M.dojazd}</b>
						<p>{M.km === 'na miejscu' ? 'Jesteśmy na miejscu.' : `${M.km}.`} {M.note}</p>
					</div>
					<a href="/obszar-dzialania/">Mapa dojazdu →</a>
				</div>
			)}
			<OfferButton href={gen} label="Sprawdź swoją ofertę" lead={`Chcesz zobaczyć cenę za ${S.name} dla siebie?`} note="Generator ustawi się sam — możesz zmienić każdą pozycję. Rabat rośnie do 30%." />
		</div>
	</section>

	<!-- 4. JAK PRACUJEMY -->
	<Process />

	<!-- 5. REALIZACJE -->
	{work.length > 0 && (
		<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep py-16 text-cloud">
			<div class="mx-auto max-w-[960px] px-6 text-center sm:px-8">
				<h2 class="lp-h2">Zobacz, co ostatnio zrobiliśmy</h2>
				<p class="mt-2 text-[17px] text-sky-mist">Przewiń albo kliknij strzałki. Każda realizacja ma swój opis.</p>
			</div>
			<div class="mt-8"><Carousel3D items={work} orientation="poziom" tone="dark" label="Realizacje" /></div>
		</section>
	)}

	<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
		<div class="relative z-2 mx-auto max-w-[960px] px-6 py-16 sm:px-8">
			<!-- 6. DARMOWA PRÓBKA -->
			<a href="/#probna" class="lp-sample">
				<span class="lp-sample-ico" aria-hidden="true"><IsoIcon name="telefon" mode="static" /></span>
				<span>
					<b>Nie wiesz, czy to dla Ciebie? Sprawdź nas za darmo.</b>
					<small>Wyślij do 3 minut nagrania — zmontujemy z niego jedną rolkę bez zobowiązań.</small>
				</span>
				<span class="lp-sample-cta">Chcę darmową rolkę →</span>
			</a>

			<!-- 7. FAQ (otwarte — bez klikania) -->
			<h2 class="lp-h2 mt-16">Pytania i odpowiedzi</h2>
			<div class="mt-6 flex flex-col gap-3.5">
				{faq.map((f) => (
					<div class="lp-faq glass">
						<h3>{f.q}</h3>
						<p>{f.a}</p>
					</div>
				))}
			</div>

			<!-- 8. KONTAKT -->
			<div class="lp-contact">
				<h2 class="lp-h2">Porozmawiajmy o Twoim projekcie</h2>
				<p class="mt-3 text-[18px] text-sky-mist">Zadzwoń albo napisz — odpowiadamy w 24 godziny w dni robocze.</p>
				<a href="tel:+48668472759" class="lp-phone">668 472 759</a>
				<a href="mailto:kontakt@sobotkavisual.pl" class="lp-mail">kontakt@sobotkavisual.pl</a>
				{(home as any).booking?.url && <div class="mt-6"><BookingCta /></div>}
			</div>

			<!-- 9. INNE MIASTA I USŁUGI -->
			<nav class="lp-links" aria-label="Inne usługi i miasta">
				<h2>{M ? `Też w okolicy ${M.gen}` : 'Inne usługi i miasta'}</h2>
				<ul>{shown.map(([h, l]) => <li><a href={`${h}/`}>{l}</a></li>)}<li><a href="/obszar-dzialania/" class="is-acc">Mapa: gdzie działamy →</a></li></ul>
				<details class="lp-more">
					<summary>Pokaż wszystkie miasta i usługi ({rest.length + zdalnie.length})</summary>
					<ul>{rest.map(([h, l]) => <li><a href={`${h}/`}>{l}</a></li>)}{zdalnie.map(([h, l]) => <li><a href={h}>{l} — cała Polska</a></li>)}</ul>
				</details>
			</nav>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
	})} />
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://sobotkavisual.pl/" },
			{ "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://sobotkavisual.pl/uslugi/" },
			{ "@type": "ListItem", "position": 3, "name": h1 }
		]
	})} />
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Service",
		"name": h1,
		"serviceType": h1,
		"provider": { "@type": "ProfessionalService", "name": "Sobotka Visual Creations", "@id": "https://sobotkavisual.pl/#firma", "telephone": "+48668472759" },
		"areaServed": isCity ? { "@type": "City", "name": miasto } : undefined,
		"description": intro,
		"offers": zakres.map((z) => ({ "@type": "Offer", "name": z.name, "priceCurrency": "PLN", "description": z.price }))
	})} />
</BaseLayout>

<style is:global>
	.lp-hero { background: linear-gradient(180deg, #120a4a 0%, #1b0545 55%, #0a0630 100%); padding-bottom: clamp(170px, 24vw, 330px); }
	.lp-pano { position: absolute; left: 0; right: 0; bottom: 0; height: clamp(180px, 26vw, 360px); pointer-events: none; }
	.lp-crumbs { display: flex; flex-wrap: wrap; gap: .45rem; font-size: 14px; color: rgba(214,222,255,.7); }
	.lp-crumbs a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.25); }
	.lp-crumbs a:hover { color: #fff; }
	.lp-crumbs b { font-weight: 600; color: #fff; }
	.lp-city { display: inline-block; margin-top: 18px; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 700; color: #fff; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); }
	.lp-facts { margin-top: 22px; display: grid; gap: 10px 18px; grid-template-columns: repeat(2, minmax(0, max-content)); font-size: 16px; font-weight: 600; }
	.lp-facts li { display: flex; gap: 8px; align-items: center; }
	.lp-facts span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: rgba(46,229,157,.18); color: #2ee59d; font-size: 12px; font-weight: 900; }
	.lp-btn { display: inline-flex; align-items: center; min-height: 56px; padding: 0 1.6rem; border-radius: 999px; font-weight: 800; font-size: 17px; transition: transform .2s; }
	.lp-btn:hover { transform: translateY(-2px); }
	.lp-btn-acc { background: var(--color-orange, #ed244e); color: #fff; box-shadow: 0 14px 34px -12px rgba(237,36,78,.8); }
	.lp-btn-ghost { border: 2px solid rgba(255,255,255,.6); color: #fff; }
	.lp-ico { width: min(380px, 100%); justify-self: center; }
	.lp-ico .iso { width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgba(0,0,0,.45)); }
	.lp-h2 { font-size: clamp(28px, 3.4vw, 36px); font-weight: 800; letter-spacing: -.02em; line-height: 1.15; text-wrap: balance; }
	.lp-prob { display: flex; gap: 14px; align-items: flex-start; padding: 20px 22px; border-radius: 18px; }
	.lp-prob p { font-size: 17px; line-height: 1.55; color: #fff; }
	.lp-prob-i { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255,90,120,.18); color: #ff8aa0; font-weight: 900; }
	.lp-answer { margin-top: 20px; padding: 18px 22px; border-left: 4px solid #2ee59d; border-radius: 6px 16px 16px 6px; background: rgba(46,229,157,.07); font-size: 17px; line-height: 1.55; color: #fff; }
	.lp-table { border-radius: 18px; overflow: hidden; }
	.lp-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; border-bottom: 1px solid rgba(255,255,255,.08); font-size: 17px; }
	.lp-row:last-child { border-bottom: 0; }
	.lp-row:nth-child(2n) { background: rgba(255,255,255,.025); }
	.lp-row b { flex: none; font-size: 18px; font-weight: 800; color: #ff8aa0; white-space: nowrap; }
	.lp-travel { margin-top: 18px; display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 16px 20px; border-radius: 16px; background: rgba(255,198,92,.07); border: 1px solid rgba(255,198,92,.35); }
	.lp-travel.is-free { background: rgba(46,229,157,.07); border-color: rgba(46,229,157,.4); }
	.lp-travel-ico { font-size: 26px; }
	.lp-travel b { display: block; font-size: 18px; color: #fff; }
	.lp-travel p { margin-top: 2px; font-size: 16px; color: var(--color-sky-mist, #c3c0dc); }
	.lp-travel a { font-weight: 700; font-size: 15px; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
	@media (max-width: 767px) { .lp-travel { grid-template-columns: auto 1fr; } .lp-travel a { grid-column: 1 / -1; } }
	.lp-sample { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; padding: 22px 26px; border-radius: 22px; color: #fff;
		background: linear-gradient(150deg, #6d4dff, #b03cff 60%, #ff5fd2); box-shadow: 0 0 50px -14px rgba(176,60,255,.85); transition: transform .25s; }
	.lp-sample:hover { transform: translateY(-3px); }
	.lp-sample-ico { width: 84px; height: 84px; margin: -18px 0 -18px -8px; }
	.lp-sample-ico .iso { width: 100%; height: 100%; }
	.lp-sample b { display: block; font-size: 20px; line-height: 1.3; }
	.lp-sample small { display: block; margin-top: 4px; font-size: 16px; color: rgba(255,255,255,.88); }
	.lp-sample-cta { padding: 13px 20px; border-radius: 999px; background: #fff; color: #3a1d9e; font-weight: 800; white-space: nowrap; }
	.lp-faq { padding: 22px 24px; border-radius: 18px; }
	.lp-faq h3 { font-size: 19px; font-weight: 700; color: #fff; }
	.lp-faq p { margin-top: 8px; font-size: 17px; line-height: 1.65; color: var(--color-sky-mist, #c3c0dc); }
	.lp-contact { margin-top: 64px; padding: 40px 28px; border-radius: 26px; text-align: center; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); }
	.lp-phone { display: block; margin-top: 18px; font-size: clamp(36px, 6vw, 56px); font-weight: 900; letter-spacing: -.02em; color: #fff; }
	.lp-phone:hover { color: #ff8aa0; }
	.lp-mail { display: inline-block; margin-top: 6px; font-size: 18px; text-decoration: underline; text-underline-offset: 4px; color: var(--color-sky-mist, #c3c0dc); }
	.lp-links { margin-top: 56px; }
	.lp-links h2 { font-size: 20px; font-weight: 800; }
	.lp-links ul { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; }
	.lp-links a { display: inline-block; padding: 9px 15px; border-radius: 999px; font-size: 15px; border: 1px solid rgba(255,255,255,.16); color: var(--color-sky-mist, #c3c0dc); transition: border-color .2s, color .2s; }
	.lp-links a:hover { border-color: #ff8aa0; color: #fff; }
	.lp-links a.is-acc { border-color: rgba(46,229,157,.5); color: #fff; }
	.lp-more { margin-top: 14px; }
	.lp-more summary { display: inline-flex; cursor: pointer; font-size: 15px; font-weight: 700; color: var(--color-sky-mist, #c3c0dc); text-decoration: underline; text-underline-offset: 4px; list-style: none; }
	.lp-more summary::-webkit-details-marker { display: none; }
	.lp-more summary::after { content: ' ▾'; }
	.lp-more[open] summary::after { content: ' ▴'; }
	.lp-more ul a { padding: 6px 12px; font-size: 14px; }
	@media (max-width: 767px) {
		.lp-facts { grid-template-columns: 1fr; }
		.lp-btn { width: 100%; justify-content: center; }
		.lp-travel { margin-top: 18px; display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 16px 20px; border-radius: 16px; background: rgba(255,198,92,.07); border: 1px solid rgba(255,198,92,.35); }
	.lp-travel.is-free { background: rgba(46,229,157,.07); border-color: rgba(46,229,157,.4); }
	.lp-travel-ico { font-size: 26px; }
	.lp-travel b { display: block; font-size: 18px; color: #fff; }
	.lp-travel p { margin-top: 2px; font-size: 16px; color: var(--color-sky-mist, #c3c0dc); }
	.lp-travel a { font-weight: 700; font-size: 15px; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
	@media (max-width: 767px) { .lp-travel { grid-template-columns: auto 1fr; } .lp-travel a { grid-column: 1 / -1; } }
	.lp-sample { grid-template-columns: 1fr; text-align: center; }
		.lp-sample-ico { margin: -40px auto 0; }
		.lp-row { flex-direction: column; align-items: flex-start; gap: 4px; }
	}
</style>
