---
import home from '../../data/home.json';
const clients: { name: string; logo: string; height?: number }[] = (home as any).clients ?? [
	{ name: 'Delta HR', logo: '/delta-hr.svg', height: 24 },
	{ name: 'Przemysław Langier', logo: '/langier.svg', height: 32 },
	{ name: 'Betters', logo: '/betters.svg', height: 28 },
];
const h = { h1prefix: 'Bądź', h1accent: 'wyjątkowy', lead: 'Motion design, montaż i color grading dla marek, które chcą pokazać światu swój potencjał.', ctaPrimaryLabel: 'Bezpłatna wycena', ctaPrimaryHref: '/#kontakt', ctaSecondaryLabel: 'Zobacz realizacje', ctaSecondaryHref: '/work', video: '', poster: '', videoOpacity: 30, clientsLabel: 'Zaufali nam', ...(home as any).hero };
if ((h as any).videoUrl) h.video = (h as any).videoUrl; // film z Cloudflare R2 ma pierwszeństwo
---
<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
	{h.video && (
		<video
			class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover md:block"
			style={`opacity:${(h.videoOpacity ?? 30) / 100}`}
			autoplay muted loop playsinline preload="metadata" poster={h.poster || undefined}
		>
			<source src={h.video} />
		</video>
	)}
	{h.poster && !h.video && (
		<img src={h.poster} alt="" class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover" style={`opacity:${(h.videoOpacity ?? 30) / 100}`} />
	)}
	<span class="pointer-events-none absolute inset-0 z-0 bg-grid opacity-35"></span>
	<span data-speed="0.06" class="pointer-events-none absolute -top-[90px] -right-[70px] z-0 size-[660px] bg-radial from-orange/40 to-transparent to-62%"></span>
	<span data-speed="-0.04" class="pointer-events-none absolute -bottom-40 -left-[120px] z-0 size-[620px] bg-radial from-[rgb(39_24_126/0.55)] to-transparent to-64%"></span>

	<div class="relative z-2 mx-auto max-w-[1200px] px-8 pt-24 pb-14">
		<div class="max-w-[660px]">
			<img src="/logo.svg" alt="Sobotka Visual Creations" class="h-9 w-auto md:h-11" />
			<h1 class="mt-8 text-[40px] leading-[1.03] tracking-[-0.03em] md:text-[56px]">
				{h.h1prefix} <span class="text-orange">{h.h1accent}</span>
			</h1>
			<p class="mt-6 max-w-[560px] text-[19px] leading-[1.55] text-sky">
				{h.lead}
			</p>
			<div class="mt-9 flex flex-wrap gap-3.5">
				<a href={h.ctaPrimaryHref || "/generator"} class="btn-saber rounded-full bg-orange px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">{h.ctaPrimaryLabel}</a>
				<a href={h.ctaSecondaryHref || "/work"} class="btn-saber rounded-full border-2 border-cloud/70 px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">{h.ctaSecondaryLabel}</a>
			</div>
		</div>
	</div>

	<div class="relative z-2 mx-auto max-w-[1200px] px-8 pb-16">
		<p class="mb-6 text-center text-[13px] font-bold tracking-[0.14em] text-white/55 uppercase">{h.clientsLabel}</p>
		<div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-6">
			{clients.filter((c) => c.logo).map((c) => (
				<img src={c.logo} alt={c.name} style={`height:${c.height ?? 28}px`} class="w-auto opacity-70 transition-opacity hover:opacity-100" loading="lazy" />
			))}
		</div>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": ["ProfessionalService", "LocalBusiness"],
			"@id": "https://sobotkavisual.pl/#firma",
			"name": "Sobotka Visual Creations",
			"alternateName": "SVC",
			"image": "https://sobotkavisual.pl/og-default.jpg",
			"logo": "https://sobotkavisual.pl/logo.svg",
			"url": "https://sobotkavisual.pl",
			"sameAs": [
				"https://www.youtube.com/@SobotkaVisualCreations",
				"https://www.instagram.com/sobotkavisualcreations/",
				"https://www.tiktok.com/@sobotkavisualcreations",
				"https://www.facebook.com/profile.php?id=100087789733469",
				"https://maps.app.goo.gl/en8FZ9tCZeGwYP7a6"
			],
			"hasMap": "https://maps.app.goo.gl/en8FZ9tCZeGwYP7a6",
			"email": "kontakt@sobotkavisual.pl",
			"telephone": "+48668472759",
			"priceRange": "2500-12900 PLN",
			"currenciesAccepted": "PLN",
			"description": "Studio motion designu i montażu wideo z Opola. Animacje, rolki, oprawa transmisyjna i grafika dla firm, twórców internetowych i klubów sportowych.",
			"slogan": "Bądź wyjątkowy",
			"address": { "@type": "PostalAddress", "addressLocality": "Opole", "addressRegion": "opolskie", "addressCountry": "PL" },
			"geo": { "@type": "GeoCoordinates", "latitude": 50.6751, "longitude": 17.9213 },
			"areaServed": [
				{ "@type": "AdministrativeArea", "name": "województwo opolskie" },
				{ "@type": "AdministrativeArea", "name": "województwo śląskie" },
				{ "@type": "AdministrativeArea", "name": "województwo dolnośląskie" },
				{ "@type": "Country", "name": "Polska" }
			],
			"founder": { "@type": "Person", "name": "Krzysztof Sobotka", "jobTitle": "3D Visual & Motion Artist", "alumniOf": "Akademia Sztuk Pięknych we Wrocławiu" },
			"knowsAbout": ["montaż wideo", "motion design", "animacja 2D", "animacja 2.5D", "color grading", "oprawa transmisyjna", "projektowanie graficzne", "rolki", "social media"],
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "Pakiety abonamentowe",
				"itemListElement": [
					{ "@type": "Offer", "name": "START", "price": "2500", "priceCurrency": "PLN", "description": "Stała obecność w social media bez materiałów wideo." },
					{ "@type": "Offer", "name": "PRO", "price": "7200", "priceCurrency": "PLN", "description": "Pełne zaplecze produkcji wideo i grafiki." },
					{ "@type": "Offer", "name": "STUDIO", "price": "12900", "priceCurrency": "PLN", "description": "Najwyższy poziom: wideo, animacje, dzień zdjęciowy, strategia." }
				]
			}
		},
		{
			"@type": "Service",
			"@id": "https://sobotkavisual.pl/#uslugi",
			"serviceType": "Montaż wideo, motion design i animacja",
			"provider": { "@id": "https://sobotkavisual.pl/#firma" },
			"areaServed": { "@type": "Country", "name": "Polska" },
			"description": "Montaż długich form, animacje i motion design, rolki pionowe, miniatury, oprawa transmisyjna oraz produkcja wideo.",
			"offers": { "@type": "Offer", "priceCurrency": "PLN", "lowPrice": "180", "highPrice": "12900", "url": "https://sobotkavisual.pl/generator" }
		},
		{
			"@type": "FAQPage",
			"@id": "https://sobotkavisual.pl/#faq",
			"mainEntity": [
				{ "@type": "Question", "name": "Jak wygląda współpraca?", "acceptedAnswer": { "@type": "Answer", "text": "Ustalamy zakres i pakiet, podpisujemy umowę, a potem co miesiąc produkujemy materiały według harmonogramu. Klient akceptuje i publikuje — całą produkcję bierzemy na siebie." } },
				{ "@type": "Question", "name": "Jaki jest minimalny okres współpracy?", "acceptedAnswer": { "@type": "Answer", "text": "Pakiety abonamentowe to minimum 6 miesięcy. Realizacje jednorazowe wyceniamy osobno." } },
				{ "@type": "Question", "name": "Dla kogo są pakiety?", "acceptedAnswer": { "@type": "Answer", "text": "Dla marek, firm i twórców internetowych, a także klubów sportowych i instytucji. Siatka jest ta sama, zmieniają się akcenty i nazwy materiałów pod daną branżę." } },
				{ "@type": "Question", "name": "Kto ma prawa do materiałów?", "acceptedAnswer": { "@type": "Answer", "text": "Gotowe materiały przechodzą na klienta z chwilą zapłaty. System oprawy pozostaje na licencji czasowej — pełne prawa po 12 miesiącach współpracy." } },
				{ "@type": "Question", "name": "Czy do cen trzeba doliczyć VAT?", "acceptedAnswer": { "@type": "Answer", "text": "Nie. Jesteśmy zwolnieni z VAT, więc cena z cennika i generatora to kwota na fakturze. U firm, które podają ceny netto, do kwoty dochodzi jeszcze 23% VAT." } },
				{ "@type": "Question", "name": "Ile kosztuje montaż wideo?", "acceptedAnswer": { "@type": "Answer", "text": "Montaż długiej formy 10–20 minut kosztuje od 1250 zł, rolka pionowa od 390 zł, a abonament miesięczny zaczyna się od 2500 zł. Dokładną wycenę można złożyć w generatorze na stronie." } }
			]
		},
		{
			"@type": "WebSite",
			"@id": "https://sobotkavisual.pl/#strona",
			"url": "https://sobotkavisual.pl",
			"name": "Sobotka Visual Creations",
			"inLanguage": "pl-PL",
			"publisher": { "@id": "https://sobotkavisual.pl/#firma" }
		}
