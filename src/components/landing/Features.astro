---
const features = [
	{ title: 'Montaż wideo', body: 'Długie formy z dynamicznym cięciem, napisami, korekcją dźwięku i color gradingiem.', icon: '🎬' },
	{ title: 'Animacja i motion', body: 'Wektorowa i 2.5D — od pojedynczych elementów oprawy po pełne animowane trailery.', icon: '✦' },
	{ title: 'Rolki i krótkie formy', body: 'Pionowe rolki, shorty i TikToki z wypaloną grafiką, gotowe pod algorytm.', icon: '▶' },
	{ title: 'Oprawa graficzna', body: 'Miniatury, okładki i spójny system graficzny, który buduje rozpoznawalność.', icon: '🎨' },
	{ title: 'Oprawa transmisyjna', body: 'Intro, outro, animowane statystyki, formacje i skład — pełna szata meczowa.', icon: '📺' },
	{ title: 'Dźwięk i produkcja', body: 'Opracowanie dźwięku, lektor, dzień zdjęciowy — kompletne zaplecze produkcyjne.', icon: '🎙️' },
];
---

<section
	id="uslugi"
	class="border-y-4 border-ink bg-linear-160 from-orange-bright from-0% via-orange via-55% to-orange-deep"
>
	<div class="mx-auto max-w-[1200px] px-8 pt-18 pb-21">
		<div class="mx-auto mb-12 max-w-[640px] text-center">
			<h2 class="font-bold tracking-[-0.02em] text-ink">
				<span class="block text-[56px] leading-[1]">Wszystko,</span>
				<span class="mt-1 block text-[27px] leading-tight">czego potrzebują Twoje media</span>
			</h2>
			<p class="mt-5 text-lg text-[#3a1503]">
				Od pojedynczej rolki po pełne zaplecze produkcyjne. Jedno miejsce, jedna spójna jakość.
			</p>
		</div>
		<div class="grid gap-6 md:grid-cols-3">
			{
				features.map((f, i) => (
					<div
						class:list={[
							'group rounded-card border-2 border-ink bg-cloud p-7 shadow-pop transition-[transform,box-shadow] duration-180 hover:translate-y-[-4px] hover:rotate-0 hover:shadow-pop-lg',
							i % 2 === 0 ? '-rotate-1' : 'rotate-1',
						]}
					>
						<span class="mb-4.5 flex size-14 items-center justify-center rounded-chip bg-linear-150 from-orange to-orange/45 text-[26px] shadow-[3px_3px_0_var(--color-ink)] transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-6">
							{f.icon}
						</span>
						<h3 class="text-[21px] font-semibold text-ink">{f.title}</h3>
						<p class="mt-2 text-[15px] leading-normal text-slate-600">{f.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
