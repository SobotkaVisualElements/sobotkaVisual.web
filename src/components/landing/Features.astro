---
import home from '../../data/home.json';
import LayerTile from '../ui/LayerTile.astro';
import SvcIcon from '../ui/SvcIcon.astro';
import IsoIcon from '../iso/IsoIcon.astro';
// animowane ikony izometryczne (jak na landingu izometrycznym) — przypisane do usług
const isoFor: Record<string, string> = { montaz: 'monitor', motion: 'rakieta', rolki: 'telefon', grafika: 'tablet', transmisja: 'wykres', dzwiek: 'kamera' };
const t = { titleBig: 'Wszystko,', titleSmall: 'czego potrzebują Twoje media', lead: 'Od pojedynczej rolki po pełne zaplecze produkcyjne. Jedno miejsce, jedna spójna jakość.', ...(home as any).uslugi };
const fallback = [
	{ title: 'Montaż wideo', body: 'Długie formy z dynamicznym cięciem, napisami, korekcją dźwięku i color gradingiem.', icon: 'montaz' },
	{ title: 'Animacja i motion', body: 'Wektorowa i 2.5D — od pojedynczych elementów oprawy po pełne animowane trailery.', icon: 'motion' },
	{ title: 'Rolki i krótkie formy', body: 'Pionowe rolki, shorty i TikToki z wypaloną grafiką, gotowe pod algorytm.', icon: 'rolki' },
	{ title: 'Oprawa graficzna', body: 'Miniatury, okładki i spójny system graficzny, który buduje rozpoznawalność.', icon: 'grafika' },
	{ title: 'Oprawa transmisyjna', body: 'Intro, outro, animowane statystyki, formacje i skład — pełna szata meczowa.', icon: 'transmisja' },
	{ title: 'Dźwięk i produkcja', body: 'Opracowanie dźwięku, lektor, dzień zdjęciowy — kompletne zaplecze produkcyjne.', icon: 'dzwiek' },
];
const svcLink: Record<string, string> = { montaz: '/uslugi/montaz-wideo/', motion: '/uslugi/animacja-motion-design/', rolki: '/uslugi/rolki-i-krotkie-formy/', grafika: '/uslugi/oprawa-graficzna/', transmisja: '/uslugi/oprawa-transmisyjna/', dzwiek: '/uslugi/dzwiek-i-produkcja/' };
const features: any[] = (home as any).features?.length ? (home as any).features : fallback;
---
<section id="uslugi" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 pt-18 pb-21">
		<div class="mx-auto mb-12 max-w-[640px] text-center">
			<h2 class="font-bold tracking-[-0.02em] text-cloud">
				<span class="block text-[56px] leading-[1]">{t.titleBig}</span>
				<span class="mt-1 block text-[27px] leading-tight">{t.titleSmall}</span>
			</h2>
			<p class="mt-5 text-lg text-sky-mist">{t.lead}</p>
		</div>
		<div class="grid gap-6 md:grid-cols-3">
			{features.map((f) => {
				const hasLayers = (f.layers ?? []).some((l: any) => l?.image);
				const inner = (
					<>
						<h3 class="text-[21px] font-semibold text-cloud">{(f.href || svcLink[f.icon]) ? <a href={f.href || svcLink[f.icon]} class="after:absolute after:inset-0 after:z-10">{f.title}</a> : f.title}</h3>
						<p class="mt-2 text-[15px] leading-normal text-sky-mist">{f.body}</p>
						{(f.href || svcLink[f.icon]) && <span class="mt-4 inline-block text-sm font-bold text-orange-glow transition-transform group-hover:translate-x-1">Zobacz usługę →</span>}
					</>
				);
				return hasLayers ? (
					<div class="liquid-card glass group overflow-hidden rounded-2xl p-4">
						<div class="relative overflow-hidden rounded-xl">
							<LayerTile layers={f.layers} strength={f.strength ?? 100} alt={f.title} />
							<span class="absolute bottom-3 left-3 z-10 flex size-12 items-center justify-center rounded-xl border border-white/25 bg-navy-deep/55 p-2.5 text-cloud backdrop-blur-md">
								<SvcIcon name={f.icon || 'montaz'} />
							</span>
						</div>
						<div class="px-3 pt-5 pb-3">{inner}</div>
					</div>
				) : (
					<div data-layers data-strength={f.strength ?? 100} class="liquid-card glass group rounded-2xl p-7">
						<span data-depth="25" data-scale="100" class="svc-iso mb-3 block">
							<IsoIcon name={isoFor[f.icon] || 'monitor'} />
						</span>
						{inner}
					</div>
				);
			})}
		</div>
	</div>
</section>
<style is:global>
	.svc-iso { width: 118px; height: 118px; margin: -14px 0 0 -14px; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
	.svc-iso .iso { width: 100%; height: 100%; }
	.group:hover .svc-iso { transform: translateY(-4px) scale(1.04); }
	@media (max-width: 767px) { .svc-iso { width: 100px; height: 100px; } }
</style>
