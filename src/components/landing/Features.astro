---
import home from '../../data/home.json';
const t = { titleBig: 'Wszystko,', titleSmall: 'czego potrzebują Twoje media', lead: 'Od pojedynczej rolki po pełne zaplecze produkcyjne. Jedno miejsce, jedna spójna jakość.', ...(home as any).uslugi };
const features = [
	{ title: 'Montaż wideo', body: 'Długie formy z dynamicznym cięciem, napisami, korekcją dźwięku i color gradingiem.', icon: '🎬' },
	{ title: 'Animacja i motion', body: 'Wektorowa i 2.5D — od pojedynczych elementów oprawy po pełne animowane trailery.', icon: '✦' },
	{ title: 'Rolki i krótkie formy', body: 'Pionowe rolki, shorty i TikToki z wypaloną grafiką, gotowe pod algorytm.', icon: '▶' },
	{ title: 'Oprawa graficzna', body: 'Miniatury, okładki i spójny system graficzny, który buduje rozpoznawalność.', icon: '🎨' },
	{ title: 'Oprawa transmisyjna', body: 'Intro, outro, animowane statystyki, formacje i skład — pełna szata meczowa.', icon: '📺' },
	{ title: 'Dźwięk i produkcja', body: 'Opracowanie dźwięku, lektor, dzień zdjęciowy — kompletne zaplecze produkcyjne.', icon: '🎙️' },
];
---
<section id="uslugi" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 pt-18 pb-21">
		<div class="mx-auto mb-12 max-w-[640px] text-center">
			<h2 class="font-bold tracking-[-0.02em] text-cloud">
				<span class="block text-[56px] leading-[1]">{t.titleBig}</span>
				<span class="mt-1 block text-[27px] leading-tight">{t.titleSmall}</span>
			</h2>
			<p class="mt-5 text-lg text-sky-mist">Od pojedynczej rolki po pełne zaplecze produkcyjne. Jedno miejsce, jedna spójna jakość.</p>
		</div>
		<div class="grid gap-6 md:grid-cols-3">
			{features.map((f) => (
				<div class="liquid-card glass group rounded-2xl p-7">
					<span class="mb-4.5 flex size-14 items-center justify-center rounded-chip bg-linear-150 from-orange to-orange/45 text-[26px] transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-6">
						{f.icon}
					</span>
					<h3 class="text-[21px] font-semibold text-cloud">{f.title}</h3>
					<p class="mt-2 text-[15px] leading-normal text-sky-mist">{f.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
