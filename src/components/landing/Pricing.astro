---
import SectionHeader from './SectionHeader.astro';
const tiers = [
	{ name: 'START', sub: 'Stała obecność, bez materiałów wideo.', price: '2 500', cta: 'Wybieram START', featured: false,
	  features: ['min. 6 miesięcy','6 krótkich form pionowych','6 grafik i miniatur','1 nowy element animowany','1 runda poprawek','Raport miesięczny'] },
	{ name: 'PRO', sub: 'Pełne zaplecze działu marketingu.', price: '7 200', cta: 'Wybieram PRO', featured: true,
	  features: ['min. 6 miesięcy','4 materiały wideo','8 krótkich form pionowych','8 grafik i miniatur','3 nowe elementy animowane','Rozwijany system graficzny','Harmonogram publikacji i raport'] },
	{ name: 'STUDIO', sub: 'Najwyższy poziom, priorytet i strategia.', price: '12 900', cta: 'Wybieram STUDIO', featured: false,
	  features: ['min. 6 miesięcy','6 materiałów wideo','12 krótkich form pionowych','16 grafik i miniatur','5 nowych elementów animowanych','Dzień zdjęciowy w miesiącu','2 rundy poprawek w cenie','Priorytet 24 h i strategia'] },
];
---
<section id="oferta" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader eyebrow="Oferta" title="Trzy pakiety, jeden cel: Twoja marka rośnie" on="navy" class="max-w-[640px] mb-11" />
		<div class="grid items-start gap-6 md:grid-cols-3">
			{tiers.map((tier) => (
				<div class:list={[
					'liquid-card glass rounded-[22px] p-8',
					tier.featured && 'border-orange/45 shadow-[0_0_45px_-8px_rgba(237,36,78,.5)]',
				]}>
					{tier.featured && (
						<span class="mb-3 inline-block rounded-full bg-orange px-3.5 py-1.5 text-xs font-bold tracking-[0.05em] text-cloud">NAJCZĘŚCIEJ WYBIERANY</span>
					)}
					<h3 class="text-xl font-semibold text-cloud">{tier.name}</h3>
					<p class="mt-1.5 text-sm text-sky-mist">{tier.sub}</p>
					<div class="mt-5.5 flex items-baseline gap-1.5">
						<span class="font-display text-[46px] font-bold text-cloud">{tier.price}<span class="text-[22px] font-semibold">zł</span></span>
						<span class="text-[15px] text-sky-mist">/mies.</span>
					</div>
					<a href="/#kontakt" class:list={[
						'btn-saber mt-6 block rounded-full py-[13px] text-center text-[15px] font-bold transition-transform hover:-translate-y-0.5',
						tier.featured ? 'bg-orange text-cloud' : 'border-2 border-cloud/60 text-cloud',
					]}>{tier.cta}</a>
					<ul class="mt-6 flex flex-col gap-3 text-[15px] text-sky-mist">
						{tier.features.map((f) => (
							<li class="flex gap-2.5"><span class="font-extrabold text-orange-glow">✓</span>{f}</li>
						))}
					</ul>
				</div>
			))}
		</div>
		<div class="mt-10 text-center">
			<a href="/generator" class="btn-saber inline-block rounded-full glass px-8 py-4 font-bold text-cloud transition-transform hover:-translate-y-0.5">Zaprojektuj własny pakiet →</a>
			<p class="mx-auto mt-4 max-w-[620px] text-sm text-sky-mist">Modele współpracy (retainer lub pakiet + niższy abonament) oraz pilotaż firma SVC ustala indywidualnie.</p>
		</div>
	</div>
</section>
