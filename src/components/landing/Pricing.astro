---
import SectionHeader from './SectionHeader.astro';

const tiers = [
	{
		name: 'START',
		sub: 'Stała obecność, bez materiałów wideo.',
		price: '2 500',
		cta: 'Wybieram START',
		featured: false,
		features: [
			'min. 6 miesięcy',
			'6 krótkich form pionowych',
			'6 grafik i miniatur',
			'1 nowy element animowany',
			'1 runda poprawek',
			'Raport miesięczny',
		],
	},
	{
		name: 'PRO',
		sub: 'Pełne zaplecze działu marketingu.',
		price: '7 200',
		cta: 'Wybieram PRO',
		featured: true,
		features: [
			'min. 6 miesięcy',
			'4 materiały wideo',
			'8 krótkich form pionowych',
			'8 grafik i miniatur',
			'3 nowe elementy animowane',
			'Rozwijany system graficzny',
			'Harmonogram publikacji i raport',
		],
	},
	{
		name: 'STUDIO',
		sub: 'Najwyższy poziom, priorytet i strategia.',
		price: '12 900',
		cta: 'Wybieram STUDIO',
		featured: false,
		features: [
			'min. 6 miesięcy',
			'6 materiałów wideo',
			'12 krótkich form pionowych',
			'16 grafik i miniatur',
			'5 nowych elementów animowanych',
			'Dzień zdjęciowy w miesiącu',
			'2 rundy poprawek w cenie',
			'Priorytet 24 h i strategia',
		],
	},
];
---

<section
	id="oferta"
	class="border-y-4 border-ink bg-linear-160 from-orange-bright from-0% via-orange via-60% to-orange-deep"
>
	<div class="mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader
			eyebrow="Oferta"
			title="Trzy pakiety, jeden cel: Twoja marka rośnie"
			on="orange"
			class="max-w-[640px] mb-11"
		/>
		<div class="grid items-start gap-6 md:grid-cols-3">
			{
				tiers.map((tier) => (
					<div
						class:list={[
							tier.featured
								? 'relative scale-[1.03] rounded-[22px] border-2 border-ink bg-navy p-8.5 text-cloud shadow-pop-lg'
								: 'rounded-[22px] border-2 border-ink bg-cloud p-8 shadow-pop',
						]}
					>
						{tier.featured && (
							<span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full border-2 border-cloud bg-orange px-3.5 py-1.5 text-xs font-bold tracking-[0.05em] whitespace-nowrap text-cloud">
								NAJCZĘŚCIEJ WYBIERANY
							</span>
						)}
						<h3
							class:list={['text-xl font-semibold', tier.featured ? 'text-cloud' : 'text-navy']}
						>
							{tier.name}
						</h3>
						<p
							class:list={['mt-1.5 text-sm', tier.featured ? 'text-sky-mist' : 'text-slate-500']}
						>
							{tier.sub}
						</p>
						<div class="mt-5.5 flex items-baseline gap-1.5">
							<span
								class:list={[
									'font-display text-[46px] font-bold',
									tier.featured ? 'text-cloud' : 'text-ink',
								]}
							>
								{tier.price}
								<span class="text-[22px] font-semibold">zł</span>
							</span>
							<span
								class:list={['text-[15px]', tier.featured ? 'text-sky-mist' : 'text-slate-500']}
							>
								/mies.
							</span>
						</div>
						<a
							href="/#kontakt"
							class:list={[
								'mt-6 block rounded-full py-[13px] text-center text-[15px] font-bold transition-[background-color,transform] duration-150',
								tier.featured
									? 'bg-orange text-cloud hover:-translate-y-0.5'
									: 'border-2 border-navy bg-cloud text-navy hover:bg-sky',
							]}
						>
							{tier.cta}
						</a>
						<ul
							class:list={[
								'mt-6 flex flex-col gap-3 text-[15px]',
								tier.featured ? 'text-[#e0d7ff]' : 'text-slate-700',
							]}
						>
							{tier.features.map((feature) => (
								<li class="flex gap-2.5">
									<span
										class:list={[
											'font-extrabold',
											tier.featured ? 'text-orange-glow' : 'text-orange',
										]}
									>
										✓
									</span>
									{feature}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="mx-auto mt-9 max-w-[620px] text-center text-sm text-[#3a1503]">
			Modele współpracy (retainer lub pakiet + niższy abonament) oraz pilotaż ustalamy indywidualnie. Napisz po szczegóły.
		</p>
	</div>
</section>
