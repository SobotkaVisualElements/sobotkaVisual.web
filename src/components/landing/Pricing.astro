---
import SectionHeader from './SectionHeader.astro';
import SaveBadge from '../ui/SaveBadge.astro';
import Zap from '../ui/Zap.astro';
import IsoIcon from '../iso/IsoIcon.astro';
const iPrice = ['tablet', 'rakieta', 'moneta'];
// jasne warunki pod cennikiem (panel: Strona główna → Warunki pod cennikiem)
const warunki: any[] = (home as any).warunki?.length ? (home as any).warunki : [
	{ t: 'Bez ukrytych dopłat', d: 'Cena z generatora to kwota na fakturze. Nie doliczamy 23% VAT — jesteśmy zwolnieni z VAT.' },
	{ t: 'Gotowe pliki są Twoje', d: 'Używasz ich gdzie chcesz, bez limitu czasu.' },
	{ t: 'Możesz bez abonamentu', d: 'Pojedyncze zlecenia i dzień contentowy też.' },
	{ t: 'Odpowiedź w 24 h', d: 'W dni robocze, bez spamu i nachodzenia.' },
];
import { packageDeal, zl } from '../../lib/pricing';
import home from '../../data/home.json';
// panel → Strona główna → Oferta (pakiety)
const cfg: any = { saveLabel: 'Zyskujesz', compareLabel: 'wartość przy zamawianiu osobno', showLandings: false, ...((home as any).oferta ?? {}) };
const tiers = [
	{ name: 'START', slug: 'start', sub: 'Stała obecność, bez materiałów wideo.', price: '2 500', cta: 'Wybieram START', featured: false,
	  features: ['min. 6 miesięcy','6 krótkich form pionowych','6 grafik i miniatur','1 nowy element animowany','1 runda poprawek','Raport miesięczny'] },
	{ name: 'PRO', slug: 'pro', sub: 'Pełne zaplecze produkcji wideo i grafiki.', price: '7 200', cta: 'Wybieram PRO', featured: true,
	  features: ['min. 6 miesięcy','4 materiały wideo','8 krótkich form pionowych','8 grafik i miniatur','3 nowe elementy animowane','Rozwijany system graficzny','Harmonogram publikacji i raport'] },
	{ name: 'STUDIO', slug: 'studio', sub: 'Najwyższy poziom, priorytet i strategia.', price: '12 900', cta: 'Wybieram STUDIO', featured: false,
	  features: ['min. 6 miesięcy','6 materiałów wideo','12 krótkich form pionowych','16 grafik i miniatur','5 nowych elementów animowanych','Dzień zdjęciowy w miesiącu','2 rundy poprawek w cenie','Priorytet 24 h i strategia'] },
];
---
<section id="oferta" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader eyebrow="Oferta" title="Trzy pakiety, jeden cel: Twoja marka rośnie" on="navy" class="max-w-[640px] mb-11" />
		<div class="grid items-start gap-6 md:grid-cols-3">
			{tiers.map((tier, i) => (
				<div class:list={[
					'price-card liquid-card glass relative rounded-[22px] p-8',
					tier.featured && 'is-feat',
				]}>
					<span class="price-iso" aria-hidden="true"><IsoIcon name={iPrice[i % 3]} /></span>
					{tier.featured && (
						<span class="feat-pill mb-3 inline-block rounded-full bg-orange px-3.5 py-1.5 text-xs font-bold tracking-[0.05em] text-cloud">NAJCZĘŚCIEJ WYBIERANY</span>
					)}
					<h3 class="text-xl font-semibold text-cloud">{tier.name}</h3>
					<p class="mt-1.5 text-sm text-sky-mist">{tier.sub}</p>
					{(() => { const d = packageDeal(tier.slug); return d && <span class="deal-ribbon">Przecena <b>−{d.disc}%</b></span>; })()}
					<SaveBadge price={packageDeal(tier.slug)?.final ?? tier.price} value={cfg.values?.[tier.slug] || packageDeal(tier.slug)?.value || 0} per="/ mies." label={cfg.saveLabel} compare={cfg.compareLabel} />
					{(() => { const d = packageDeal(tier.slug); return (
						<div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
							<span class="text-sm text-sky-mist">Twoja cena</span>
							<span class="flex items-baseline gap-2 whitespace-nowrap">
								{d && d.final < d.list && <span class="text-sm text-slate-500 line-through">{zl(d.list)}</span>}
								<span class="font-display text-[40px] leading-none font-bold text-cloud">{d ? zl(d.final) : `${tier.price}\u00a0zł`}</span><span class="text-[15px] text-sky-mist">/mies.</span>
							</span>
						</div>
					); })()}
					<a href={`/generator?pakiet=${tier.slug}`} class:list={[
						'btn-saber mt-6 block rounded-full py-[13px] text-center text-[15px] font-bold transition-transform hover:-translate-y-0.5',
						tier.featured ? 'feat-btn bg-cloud text-[#3a1d9e]' : 'border-2 border-cloud/60 text-cloud',
					]}>{tier.cta}</a>
					<ul class="mt-6 flex flex-col gap-3 text-[15px] text-sky-mist">
						{tier.features.map((f) => (
							<li class="flex gap-2.5"><span class="font-extrabold text-orange-glow">✓</span>{f}</li>
						))}
					</ul>
				</div>
			))}
		</div>
		<a href="/generator" data-zap="2.2" class="gen-banner liquid-card relative mt-12 flex flex-col items-center gap-4 rounded-[26px] border-2 border-orange bg-linear-100 from-orange-deep via-orange to-orange-bright px-8 py-9 text-center shadow-[0_18px_50px_-12px_rgba(237,36,78,.7)] sm:flex-row sm:justify-between sm:text-left">
			<Zap color="#ff5a78" core="#fff4f6" />
			<span class="relative z-2">
				<span class="block font-display text-[26px] leading-tight font-bold text-cloud sm:text-[32px]">Zaprojektuj własny pakiet</span>
				<span class="mt-1.5 block text-[16px] text-white/85">Ustaw zakres suwakami i zobacz, ile zyskujesz — rabat do 30%.</span>
			</span>
			<span class="relative z-2 shrink-0 rounded-full bg-cloud px-7 py-3.5 font-bold text-navy-deep">Otwórz generator →</span>
		</a>
		<ul class="wr-grid">
			{warunki.map((w) => (
				<li class="wr-it"><span class="wr-ck" aria-hidden="true">✓</span><span><b>{w.t}</b><small>{w.d}</small></span></li>
			))}
		</ul>
		{cfg.showLandings && (
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="/oferta/dzial-wideo" class="rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-sky-mist transition-colors hover:border-orange/60 hover:text-cloud">Dział wideo dla firmy →</a>
				<a href="/oferta/kanal-youtube" class="rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-sky-mist transition-colors hover:border-orange/60 hover:text-cloud">Kanał na YouTube →</a>
			</div>
		)}
	</div>
</section>
<style is:global>
	/* piorun po całej belce generatora, przy krawędziach przycięty do zaokrągleń */
	.gen-banner { isolation: isolate; overflow: hidden; }
	.gen-banner .zap-layer { z-index: 1; }
	/* animowana ikona izometryczna nad rogiem karty (jak na landingu izometrycznym) */
	.price-card { overflow: visible; }
	.price-iso { position: absolute; top: -54px; right: 6px; width: 110px; height: 110px; z-index: 3; pointer-events: none; filter: drop-shadow(0 14px 22px rgba(0,0,0,.45)); }
	.price-iso .iso { width: 100%; height: 100%; }
	/* środkowa oferta: fioletowy gradient */
	.price-card.is-feat { background: linear-gradient(150deg, #6d4dff, #b03cff 60%, #ff5fd2); border-color: transparent;
		box-shadow: 0 0 55px -10px rgba(176,60,255,.85), 0 24px 60px -24px rgba(0,0,0,.6); }
	.price-card.is-feat, .price-card.is-feat .text-sky-mist, .price-card.is-feat .text-slate-500 { color: rgba(255,255,255,.88); }
	.price-card.is-feat .text-orange-glow, .price-card.is-feat li > span { color: #fff; }
	.price-card.is-feat .feat-pill { background: rgba(255,255,255,.95); color: #3a1d9e; }
	.price-card.is-feat .feat-btn { box-shadow: 0 12px 30px -10px rgba(40,10,120,.7); }
	.wr-grid { margin-top: 28px; display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; }
	.wr-it { display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border-radius: 16px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); }
	.wr-it b { display: block; color: #fff; font-size: 15px; }
	.wr-it small { display: block; margin-top: 3px; font-size: 13px; line-height: 1.45; color: var(--color-sky-mist, #c3c0dc); }
	.wr-ck { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(46,229,157,.15); color: #2ee59d; font-weight: 900; font-size: 13px; }
	@media (max-width: 899px) { .wr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 520px) { .wr-grid { grid-template-columns: 1fr; } }
	@media (max-width: 767px) { .price-iso { width: 88px; height: 88px; top: -40px; } }
</style>
