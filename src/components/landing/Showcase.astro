---
import home from '../../data/home.json';
import LayerTile from '../ui/LayerTile.astro';
const tiles = home.tiles;
const t = { eyebrow: 'Dla kogo', titleLine1: 'Media dla tych,', titleLine2: 'którzy chcą się wyróżnić', ...(home as any).dlaKogo };
---
<section id="dla-kogo" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<span data-speed="0.03" class="pointer-events-none absolute top-10 right-[8%] text-[34px] text-orange">✦</span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 py-20">
		<div class="mx-auto mb-13 max-w-[720px] text-center">
			<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">{t.eyebrow}</span>
			<h2 class="mt-3 text-[44px] leading-tight font-bold tracking-[-0.02em] text-cloud">
				{t.titleLine1}<br />{t.titleLine2}
			</h2>
		</div>
		<div class="mx-auto grid max-w-[900px] gap-7 md:grid-cols-2">
			{tiles.map((tile: any) => (
				<div class="liquid-card glass group rounded-tile p-5">
					<div class="overflow-hidden rounded-xl">
						<LayerTile layers={(tile as any).layers} image={tile.image} strength={(tile as any).strength ?? 100} alt={tile.title} />
					</div>
					<h3 class="mt-5 font-display text-[22px] font-semibold text-cloud">{tile.title}</h3>
					<p class="mt-2 text-[15px] leading-normal text-sky-mist">{tile.body}</p>
					{tile.note && <p class="mt-2 text-[15px] leading-normal text-sky-mist">{tile.note}</p>}
				</div>
			))}
		</div>
	</div>
</section>
