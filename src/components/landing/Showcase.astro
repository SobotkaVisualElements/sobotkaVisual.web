---
import SectionHeader from './SectionHeader.astro';

const tiles = [
	{
		tag: 'Kluby sportowe',
		title: 'Kluby sportowe',
		body: 'Pełna oprawa transmisji, skróty meczowe i social media, które budują markę klubu.',
	},
	{
		tag: 'Twórcy internetowi',
		title: 'Twórcy internetowi',
		body: 'Montaż odcinków, miniatury i rolki, które odzyskują Twój czas i podbijają klikalność.',
	},
	{
		tag: 'Marki i firmy',
		title: 'Marki i firmy',
		body: 'Materiały produktowe i wizerunkowe. Wy decydujecie, produkcję bierzemy na siebie.',
	},
];
---

<section
	id="dla-kogo"
	class="relative overflow-hidden bg-linear-160 from-navy to-navy-deep text-cloud"
>
	<span class="absolute top-10 right-[8%] text-[34px] text-orange">✦</span>
	<span class="absolute bottom-15 left-[5%] size-5 rotate-[20deg] rounded-md bg-orange"></span>
	<div class="mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader
			eyebrow="Dla kogo"
			title="Media dla tych, którzy chcą się wyróżnić"
			sub="Ta sama jakość, inne akcenty. Dobieramy zakres do tego, jak działasz i kim chcesz być."
			on="navy"
			class="max-w-[640px] mb-13"
		/>
		<div class="grid gap-6 md:grid-cols-3">
			{
				tiles.map((tile) => (
					<div class="rounded-tile border border-white/14 bg-white/6 p-4.5">
						<div class="flex aspect-4/3 items-center justify-center overflow-hidden rounded-xl bg-linear-160 from-navy-deep via-navy to-orange/40">
							<span class="rounded-md bg-white/10 px-3 py-1 text-[13px] font-bold tracking-[0.08em] text-cloud uppercase">
								{tile.tag}
							</span>
						</div>
						<h3 class="mt-4 font-display text-xl font-semibold text-cloud">{tile.title}</h3>
						<p class="mt-1.5 text-sm leading-normal text-sky-mist">{tile.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
