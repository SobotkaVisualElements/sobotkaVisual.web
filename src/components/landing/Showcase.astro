---
const tiles = [
	{ tag: 'Twórcy internetowi', title: 'Twórcy internetowi',
	  body: 'Montaż odcinków, miniatury i rolki, które odzyskują Twój czas i podbijają klikalność.', note: '' },
	{ tag: 'Marki i firmy', title: 'Marki i firmy',
	  body: 'Materiały produktowe i wizerunkowe na najwyższym poziomie.',
	  note: 'Wy decydujecie, co pokazać — produkcję bierzemy na siebie.' },
];
---
<section id="dla-kogo" class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<span data-speed="0.03" class="pointer-events-none absolute top-10 right-[8%] text-[34px] text-orange">✦</span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 py-20">
		<div class="mx-auto mb-13 max-w-[720px] text-center">
			<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">Dla kogo</span>
			<h2 class="mt-3 text-[44px] leading-tight font-bold tracking-[-0.02em] text-cloud">
				Media dla tych,<br />którzy chcą się wyróżnić
			</h2>
		</div>
		<div class="mx-auto grid max-w-[900px] gap-7 md:grid-cols-2">
			{tiles.map((tile) => (
				<div class="liquid-card glass group rounded-tile p-5">
					<div class="relative aspect-video overflow-hidden rounded-xl">
						{/* Podmień gradient na <img> z realizacją, gdy będą miniatury */}
						<div class="absolute inset-0 bg-linear-160 from-navy-deep via-navy to-orange/40 transition-transform duration-300 ease-out group-hover:scale-[1.12]" />
						<span class="absolute inset-0 flex items-center justify-center">
							<span class="rounded-md bg-white/10 px-3 py-1 text-[13px] font-bold tracking-[0.08em] text-cloud uppercase backdrop-blur-sm">{tile.tag}</span>
						</span>
					</div>
					<h3 class="mt-5 font-display text-[22px] font-semibold text-cloud">{tile.title}</h3>
					<p class="mt-2 text-[15px] leading-normal text-sky-mist">{tile.body}</p>
					{tile.note && <p class="mt-2 text-[15px] leading-normal text-sky-mist">{tile.note}</p>}
				</div>
			))}
		</div>
	</div>
</section>
