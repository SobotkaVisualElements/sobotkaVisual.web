---
import SectionHeader from './SectionHeader.astro';

// UWAGA: cytaty to placeholdery. Wklej prawdziwe fragmenty z pisemnych referencji
// od Adama Przebindy (Delta HR) i Przemysława Langiera przed publikacją.
const quotes = [
	{
		quote:
			'„[Tu wklej cytat z pisemnej referencji od Delta HR — do uzupełnienia przed publikacją.]"',
		initials: 'AP',
		avatar: 'bg-navy',
		name: 'Adam Przebinda',
		role: 'Delta HR',
		tilt: '-rotate-[1.2deg]',
	},
	{
		quote:
			'„[Tu wklej cytat z pisemnej referencji od Przemysława Langiera — do uzupełnienia przed publikacją.]"',
		initials: 'PL',
		avatar: 'bg-orange',
		name: 'Przemysław Langier',
		role: 'twórca internetowy',
		tilt: 'rotate-1',
	},
];
---

<section class="relative overflow-hidden bg-linear-160 from-navy to-navy-deep text-cloud">
	<span class="absolute top-12.5 left-[6%] text-[28px] text-orange">✦</span>
	<span class="absolute right-[7%] bottom-10 size-5 rotate-[18deg] rounded-md bg-orange"></span>
	<div class="mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader
			eyebrow="Opinie"
			title="Nie musisz wierzyć mi na słowo"
			on="navy"
			class="max-w-[620px] mb-12"
		/>
		<div class="grid gap-6 md:grid-cols-2">
			{
				quotes.map((q) => (
					<div
						class:list={[
							'rounded-card border-2 border-ink bg-cloud p-7 shadow-pop-orange transition-transform duration-180 hover:rotate-0',
							q.tilt,
						]}
					>
						<p class="text-base leading-[1.55] text-slate-800">{q.quote}</p>
						<div class="mt-5.5 flex items-center gap-3">
							<span
								class:list={[
									'flex size-[42px] items-center justify-center rounded-full font-bold text-cloud',
									q.avatar,
								]}
							>
								{q.initials}
							</span>
							<div>
								<div class="text-[15px] font-bold text-ink">{q.name}</div>
								<div class="text-[13px] text-slate-500">{q.role}</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
