---
import SectionHeader from './SectionHeader.astro';
const quotes = [
	{ quote: '„Krzysztof pracuje na naszym celu, nie tylko na warstwie wizualnej. Ponad 100 materiałów, zawsze na czas — wideo, które pracuje na wynik biznesowy."',
	  logo: '/delta-hr.svg', logoAlt: 'Delta HR', name: 'Adam Przebinda', role: 'Delta HR' },
	{ quote: '„Wyczucie tempa montażu, dbałość o detale i umiejętność budowania narracji. Wysoka jakość nawet przy bardzo napiętych terminach — partner, na którym można polegać."',
	  logo: '/langier.svg', logoAlt: 'Przemysław Langier', name: 'Przemysław Langier', role: 'twórca internetowy' },
];
---
<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<span data-speed="0.04" class="pointer-events-none absolute top-12.5 left-[6%] text-[28px] text-orange">✦</span>
	<div class="relative z-2 mx-auto max-w-[1200px] px-8 py-20">
		<SectionHeader eyebrow="Opinie" title="Nie musisz wierzyć nam na słowo" on="navy" class="max-w-[620px] mb-12" />
		<div class="grid gap-6 md:grid-cols-2">
			{quotes.map((q) => (
				<div class="liquid-card glass rounded-2xl p-8">
					<p class="text-[17px] leading-[1.6] text-cloud">{q.quote}</p>
					<div class="mt-6 flex items-center justify-between gap-4 border-t border-white/12 pt-5">
						<div>
							<div class="text-[15px] font-bold text-cloud">{q.name}</div>
							<div class="text-[13px] text-sky-mist">{q.role}</div>
						</div>
						<img src={q.logo} alt={q.logoAlt} class="h-6 w-auto shrink-0 opacity-85" />
					</div>
				</div>
			))}
		</div>
	</div>
</section>
