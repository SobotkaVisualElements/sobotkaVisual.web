---
import Logo from './Logo.astro';
const columns = [
	{ heading: 'Nawigacja', links: [
		{ href: '/#oferta', label: 'Oferta' }, { href: '/work', label: 'Realizacje' },
		{ href: '/#faq', label: 'FAQ' }, { href: '/#kontakt', label: 'Kontakt' },
	]},
	{ heading: 'Kontakt', links: [
		{ href: 'mailto:kontakt@sobotkavisual.pl', label: 'kontakt@sobotkavisual.pl' },
		{ href: 'tel:+48668472759', label: '668 472 759' }, { href: '/generator', label: 'Zaprojektuj pakiet' },
	]},
	{ heading: 'Social media', links: [
		{ href: '#', label: 'YouTube' }, { href: '#', label: 'Facebook' }, { href: '#', label: 'TikTok' },
	]},
];
---
<footer class="relative overflow-hidden bg-navy-deep text-sky-mist">
	<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
	<div class="relative z-2 mx-auto grid max-w-[1200px] gap-8 px-8 pt-[60px] pb-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
		<div>
			<Logo size="sm" />
			<p class="mt-4 max-w-[280px] text-sm leading-relaxed text-slate-400">Pełna opieka nad Twoimi mediami. Montaż, animacja i oprawa wideo, która buduje marki firm, twórców i klubów.</p>
		</div>
		{columns.map((col) => (
			<div>
				<div class="mb-3.5 text-sm font-bold text-cloud">{col.heading}</div>
				<div class="flex flex-col gap-2.5 text-sm">
					{col.links.map((link) => <a href={link.href} class="text-sky-mist hover:text-orange">{link.label}</a>)}
				</div>
			</div>
		))}
	</div>
	<div class="relative z-2 border-t border-white/10">
		<div class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-3 px-8 py-5 text-[13px] text-slate-500">
			<span>© 2026 Sobotka Visual Creations</span><span>Nysa · Opole</span>
		</div>
	</div>
</footer>

<style is:global>
	.glass { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%); }
	.bg-grid { background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 46px 46px; }

	/* REVEAL — używa 'translate' (nie 'transform'), żeby NIE kolidować z hoverem */
	.reveal { opacity: 0; translate: 0 28px; transition: opacity .6s ease, translate .7s cubic-bezier(.2,.7,.2,1); }
	.reveal.in { opacity: 1; translate: 0 0; }

	/* LIQUID CARD */
	.liquid-card { position: relative; transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease, border-color .3s ease; }
	.liquid-card::after { content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none; z-index:1;
		background: radial-gradient(240px 240px at var(--mx,50%) var(--my,50%), rgba(255,255,255,.18), rgba(237,36,78,.22) 35%, transparent 65%);
		opacity:0; transition:opacity .3s ease; }
	@media (hover: hover) {
		.liquid-card:hover { transform: perspective(1000px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(-6px) !important; border-color: rgba(237,36,78,.45); box-shadow: 0 18px 40px rgba(0,0,0,.45); }
		.liquid-card:hover::after { opacity: 1 !important; }
	}
	[data-parallax] { transition: transform .25s ease-out; will-change: transform; }

	/* SABER — obrys biegnący dookoła przycisku */
	.btn-saber { position: relative; z-index: 0; }
	.saber-svg { position:absolute; inset:0; width:100%; height:100%; overflow:visible; pointer-events:none; opacity:0; transition:opacity .25s ease; z-index:2; }
	.saber-svg rect { fill:none; stroke:#ff5a78; stroke-width:2.5; vector-effect:non-scaling-stroke; stroke-linecap:round; stroke-dasharray:24 76;
		filter: drop-shadow(0 0 3px #ff5a78) drop-shadow(0 0 9px rgba(237,36,78,.9));
		animation: saber-run 1.5s linear infinite; }
	@keyframes saber-run { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -100; } }
	@media (hover: hover) { .btn-saber:hover .saber-svg { opacity: 1 !important; } }
	/* fallback: gdy JS nie zadziała, przycisk i tak się podświetla */
	@media (hover: hover) { .btn-saber:hover { box-shadow: 0 0 18px rgba(237,36,78,.65); } }

	@media (prefers-reduced-motion: reduce) {
		.liquid-card:hover { transform: none !important; } .reveal { opacity:1; translate:0 0; transition:none; }
		[data-speed],[data-parallax] { transform:none !important; } .saber-svg rect { animation:none !important; }
	}
</style>
<script>
	const track = (el: HTMLElement) => {
		const inner = el.querySelector<HTMLElement>('[data-parallax]');
		el.addEventListener('pointermove', (e: PointerEvent) => {
			const r = el.getBoundingClientRect();
			const x = e.clientX - r.left, y = e.clientY - r.top;
			el.style.setProperty('--mx', x + 'px'); el.style.setProperty('--my', y + 'px');
			el.style.setProperty('--ry', ((x / r.width - .5) * 7).toFixed(2) + 'deg');
			el.style.setProperty('--rx', ((.5 - y / r.height) * 7).toFixed(2) + 'deg');
			if (inner) inner.style.transform = `translate3d(${(-(x/r.width-.5)*18).toFixed(1)}px, ${(-(y/r.height-.5)*18).toFixed(1)}px, 0) scale(1.1)`;
		});
		el.addEventListener('pointerleave', () => {
			el.style.setProperty('--rx','0deg'); el.style.setProperty('--ry','0deg');
			if (inner) inner.style.transform = '';
		});
	};
	document.querySelectorAll<HTMLElement>('.liquid-card').forEach(track);

	// Saber: świetlny segment biegnący po obrysie (animacja z JS — pewna)
	document.querySelectorAll<HTMLElement>('.btn-saber').forEach((btn) => {
		if (btn.querySelector('.saber-svg')) return;
		const ns = 'http://www.w3.org/2000/svg';
		const svg = document.createElementNS(ns, 'svg');
		svg.setAttribute('class', 'saber-svg');
		svg.setAttribute('preserveAspectRatio', 'none');
		const rect = document.createElementNS(ns, 'rect');
		rect.setAttribute('x', '1'); rect.setAttribute('y', '1');
		rect.setAttribute('pathLength', '100');
		rect.setAttribute('stroke-dasharray', '24 76');
		const size = () => {
			const r = btn.getBoundingClientRect();
			const w = Math.max(0, r.width - 2), h = Math.max(0, r.height - 2);
			rect.setAttribute('width', String(w));
			rect.setAttribute('height', String(h));
			const rad = Math.max(0, h / 2);
			rect.setAttribute('rx', String(rad)); rect.setAttribute('ry', String(rad));
			svg.setAttribute('viewBox', `0 0 ${r.width} ${r.height}`);
		};
		size();
		window.addEventListener('resize', size, { passive: true });
		setTimeout(size, 300);
		if ((document as any).fonts?.ready) (document as any).fonts.ready.then(size);
		svg.appendChild(rect); btn.appendChild(svg);

		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			rect.animate(
				[{ strokeDashoffset: 0 }, { strokeDashoffset: -100 }],
				{ duration: 1500, iterations: Infinity, easing: 'linear' }
			);
		}
	});

	const targets = document.querySelectorAll<HTMLElement>('.liquid-card, section h2');
	targets.forEach((t) => t.classList.add('reveal'));
	const io = new IntersectionObserver((entries) => { entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }); }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
	targets.forEach((t) => io.observe(t));

	const px = document.querySelectorAll<HTMLElement>('[data-speed]');
	const onScroll = () => { const y = window.scrollY; px.forEach((el) => { const s = parseFloat(el.getAttribute('data-speed') || '0'); el.style.transform = `translate3d(0, ${(y*s).toFixed(1)}px, 0)`; }); };
	window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>
