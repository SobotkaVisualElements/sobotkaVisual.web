---
/*
 * Landing „kinetyczny” — sceny sterowane przewijaniem (wzór: strony z Awwwards).
 * Motywy: jasny (wzorzec), ciemny, świąteczny (tło z rozmytymi kształtami 3D za szkłem + śnieg).
 * Zasady czytelności: tekst zawsze na pełnym tle karty, wielki napis w tle w kolorze „cichym”,
 * kroki przełączają się skokowo (nigdy dwa naraz), ikony SVG rysują się przy wejściu w ekran.
 */
import Stars from '../ui/Stars.astro';
import CompareBars from '../ui/CompareBars.astro';
import SvcIcon from '../ui/SvcIcon.astro';
import XmasShape from '../xmas/XmasShape.astro';
import IsoIcon from '../iso/IsoIcon.astro';
import Backdrop from './Backdrop.astro';
import Carousel3D from '../ui/Carousel3D.astro';
import Deadline from './Deadline.astro';
import SaveBadge from '../ui/SaveBadge.astro';
import { cardValue, cardDeal, zl } from '../../lib/pricing';
import GapChart from '../ui/GapChart.astro';
import Blocks from '../blocks/Blocks.astro';
import { tx } from '../../lib/typo';
import { opinie } from '../../data/opinie';
import home from '../../data/home.json';

interface Props { o: any; slug: string; gen: string; others: any[]; projects: any[]; workItems?: any[]; ctr?: any; ctrQuote?: any; scale?: any; deltaBlocks?: any[]; withUtm: (h?: string) => string }
const { o, gen, others, projects, workItems = [], ctr, ctrQuote, scale, deltaBlocks = [], withUtm } = Astro.props;
const xmas = o.theme === 'swiateczny';
const hall = o.theme === 'halloween';
const iso = o.theme === 'izometryczny';
// halloween = układ izometryczny w kolorach fiolet + zieleń + pomarańcz
const theme = xmas ? 'kt-xmas' : hall ? 'kt-iso kt-hall' : iso ? 'kt-iso' : o.theme === 'ciemny' ? 'kt-dark' : 'kt-light';
const clients = ((home as any).clients ?? []).filter((c: any) => c.logo);
const paras = (t: string = '') => String(t).split(/\n\s*\n/).filter((x) => x.trim());
const strip = (s: string = '') => String(s).replace(/\*\*/g, '');

const inside: any[] = o.inside?.items ?? [];
const steps: any[] = o.become?.items ?? [];
const bigCards: any[] = (o.special?.cards2?.length ? o.special.cards2 : o.special?.cards?.length ? o.special.cards : []).slice(0, 4);
const stats: any[] = o.stats?.items ?? [];
const cards: any[] = o.invest?.cards ?? [];
const featured = cards.find((c) => c.featured) ?? cards[0];
const marquee = (o.marquee || inside.map((i) => strip(i.t)).join(' / ') || 'Montaż / Animacja / Rolki / Grafika').toUpperCase();
const firstProject: any = projects?.[0]?.data;
const zoomImg = o.proof?.image || o.hero?.bgImage || firstProject?.cover || firstProject?.poster || firstProject?.layers?.[0]?.image || '/uploads/realizacje/maxresdefault.jpg';
// chipy przy zoomie: z panelu (Wyniki → Chipy przy zdjęciu), a gdy puste — automatycznie z opisem, czego dotyczy liczba
const autoChips = [...(ctr ? [{ value: Number(ctr.ours?.value), unit: ctr.unit ?? '%', label: 'CTR miniatur w 1. godzinie' }] : []), ...(o.proof?.charts ?? []).flatMap((c: any) => (c.bars ?? []).filter((b: any) => b.highlight).map((b: any) => ({ ...b, unit: c.unit ?? '', label: `${b.label} — ${String(c.title || '').toLowerCase()}` })))];
const panelChips = (o.proof?.chips ?? []).filter((c: any) => c?.value !== undefined && c?.value !== '').map((c: any) => ({ value: Number(c.value), unit: c.suffix ?? '', label: c.label, display: c.display }));
const highlights = (panelChips.length ? panelChips : autoChips).slice(0, 3);
const toBars = (bars: any[] = []) => bars.map((b) => ({ ...b, value: Number(b.value) || 0, range: b.from !== undefined && b.from !== null && b.from !== '' && b.to ? [Number(b.from), Number(b.to)] as [number, number] : undefined }));
const finalWord = strip(o.final?.titleBold || 'Zacznijmy').replace(/\s+/g, ' ').trim();
const half = Math.ceil(finalWord.length / 2);
const fan = [...opinie.map((q) => ({ kind: 'q', ...q })), ...(highlights[0] ? [{ kind: 'stat', value: highlights[0].value, unit: highlights[0].unit, label: highlights[0].label }] : [])];
const heroMedia = o.hero?.sideImage ? { type: 'img', src: o.hero.sideImage } : xmas || iso || hall ? { type: 'iso' } : { type: 'video', src: (o.hero?.bgVideoUrl || o.hero?.bgVideo) || 'https://media.sobotkavisual.pl/filmy/reklama-hero.mp4' };
// ikony odpalane przewijaniem
const xIcons = ['prezent', 'dzwonek', 'gwiazda', 'choinka', 'bombka', 'sanie', 'czapka', 'kalendarz-xii'];
const isoLike = iso || xmas || hall;
// panel → „Układ i rozmiary”: ukrywanie sekcji i skala napisów / odstępów / długości scen
const ui: any = o.ui ?? {};
const hide = new Set<string>(ui.hide ?? []);
const off = (k: string) => hide.has(k) || undefined;
const SC: Record<string, number> = { S: 0.85, M: 1, L: 1.15, XL: 1.3 };
const uiStyle = `--ks-words:${SC[ui.wordsSize] ?? 1};--ks-h:${SC[ui.headSize] ?? 1};--ks-pad:${{ ciasno: 0.65, normalnie: 1, przestronnie: 1.35 }[ui.spacing as string] ?? 1};--ks-len:${{ krotko: 0.75, normalnie: 1, dlugo: 1.3 }[ui.sceneLength as string] ?? 1}`; // świąteczny też używa ikon izometrycznych (w kolorach strony)
// zestawy ikon: świąteczny, halloweenowy, neon; landing może podać własny zestaw w polu „icons” (np. wydawnictwa: książka)
const HALL = { hero: ['dynia', 'duch', 'nietoperz', 'kociol', 'nagrobek'], fly: ['dynia', 'duch', 'kociol', 'nietoperz', 'nagrobek', 'kalendarz-x'], big: ['kalendarz-x', 'dynia', 'duch', 'kociol'], zoom: ['dynia', 'kociol', 'duch'], price: ['duch', 'dynia', 'kociol'], final: 'nietoperz' };
const ICO: any = { ...(hall ? HALL : {}), ...(o.icons ?? {}) };
const heroIcons = ICO.hero ?? (xmas ? ['choinka', 'prezent', 'sanie', 'gwiazda', 'dzwonek'] : ['rakieta', 'wykres', 'monitor', 'moneta', 'kamera']);
const sIcons = ['montaz', 'rolki', 'motion', 'grafika', 'transmisja', 'dzwiek', 'kamera', 'strategia'];
const priceIcons = ['bombka', 'prezent', 'gwiazda'];
const iIcons = ['monitor', 'telefon', 'kamera', 'tablet', 'wykres', 'kalendarz', 'zarowka', 'moneta'];
const iPrice = ['tablet', 'rakieta', 'moneta'];
---
<div class:list={['k', theme]} style={uiStyle} data-cms-slug={Astro.props.slug}>
	<Backdrop variant={xmas ? 'xmas' : hall ? 'hall' : iso ? 'iso' : 'abstract'} />

	<!-- 01 HERO -->
	<section data-cms="1. Pierwszy ekran" hidden={off("hero")} class="k-scene" data-scene style="--h:165">
		<div class="k-sticky" data-sticky data-fit>
			<svg class="k-ribbon" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
				<path pathLength="1" d="M-40 760 C 260 620, 380 860, 640 700 S 1060 420, 1480 520" />
			</svg>
			<div class="k-wrap k-hero">
				<div class="k-hero-text">
					<p class="k-eyebrow" set:html={tx(o.hero?.eyebrow)} />
					<h1 class="k-h1"><span class="k-thin" set:html={tx(o.hero?.title)} /><span class="k-bold" set:html={tx(o.hero?.titleBold)} /></h1>
					<p class="k-lead" set:html={tx(o.hero?.lead)} />
					<div class="k-ctas">
						<a href="#k-cena" class="k-btn k-btn-acc">Zobacz inwestycję →</a>
						<a href={gen} class="k-btn k-btn-ghost">Skonfiguruj pakiet</a>
					</div>
				</div>
				<div class="k-hero-obj" data-tilt>
					{heroMedia.type === 'iso' ? (
						<div class="k-isoscene">
							<svg class="k-isolinks" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
								<path pathLength="1" d="M50 62 L18 78" /><path pathLength="1" d="M50 62 L84 74" /><path pathLength="1" d="M50 56 L20 30" /><path pathLength="1" d="M50 56 L82 32" />
								<circle cx="18" cy="78" r="1.4" /><circle cx="84" cy="74" r="1.4" /><circle cx="20" cy="30" r="1.4" /><circle cx="82" cy="32" r="1.4" />
							</svg>
							<IsoIcon name={heroIcons[0]} class="ki ki-main" />
							<IsoIcon name={heroIcons[1]} class="ki ki-a" />
							<IsoIcon name={heroIcons[2]} class="ki ki-b" />
							<IsoIcon name={heroIcons[3]} class="ki ki-c" />
							<IsoIcon name={heroIcons[4]} class="ki ki-d" />
						</div>
					) : heroMedia.type === 'xmas' ? (
						<div class="k-cluster">
							<XmasShape name="choinka" class="kc kc-1" />
							<XmasShape name="prezent" class="kc kc-2" />
							<XmasShape name="gwiazda" class="kc kc-3" />
							<XmasShape name="bombka" class="kc kc-4" />
							<XmasShape name="dzwonek" class="kc kc-5" />
						</div>
					) : (
						<div class="k-obj">
							{heroMedia.type === 'img'
								? <img src={heroMedia.src} alt={o.hero?.sideAlt || ''} />
								: <video src={heroMedia.src} autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload"></video>}
							<span class="k-obj-glare"></span>
						</div>
					)}
					{featured && <div class="k-chip k-chip-a"><Stars size={13} /><span>{featured.name} · <b set:html={tx(`${featured.price} zł`)} /></span></div>}
					{o.hero?.chipValue
						? <div class="k-chip k-chip-b"><b class="k-chip-num" set:html={tx(o.hero.chipValue)} /><span set:html={tx(o.hero.chipLabel)} /></div>
						: highlights[0] && <div class="k-chip k-chip-b"><b class="k-chip-num">{highlights[0].display || `${highlights[0].value}${highlights[0].unit}`}</b><span set:html={tx(highlights[0].label)} /></div>}
				</div>
				<div class="k-hero-strip">
					<span class="k-strip-n">01</span>
					<div><b set:html={tx(`${strip(o.intro?.title)} ${strip(o.intro?.titleLight)}`)} /><p set:html={tx(paras(o.intro?.text)[0] ?? '')} /></div>
				</div>
			</div>
		</div>
	</section>

	{clients.length > 0 && (
		<div class="k-logos-wrap"><div class="k-logos k-wrap">
			{clients.map((c: any) => <img src={c.logo} alt={c.name} style={`height:${c.height ?? 28}px`} loading="lazy" />)}
		</div></div>
	)}

	<!-- 01b TERMIN OFERTY + ODLICZANIE (po terminie: ekran „Oferta minęła”) -->
	{o.deadline?.date && <Deadline d={o.deadline} theme={hall ? 'hall' : 'xmas'} />}

	<!-- 02 WIELKI NAPIS + PRZELATUJĄCE KARTY -->
	{inside.length > 0 && (
		<section data-cms="6. Co w środku" hidden={off("marquee")} class="k-scene" data-scene style={`--h:${Math.max(240, inside.length * 75 + 120)}`}>
			<div class="k-sticky k-marq-stage" data-sticky>
				<div class="k-wrap k-marq-head">
					<p class="k-eyebrow" set:html={tx(o.inside?.eyebrow)} />
					<h2 class="k-h2"><span set:html={tx(o.inside?.title)} /> <span class="k-light" set:html={tx(o.inside?.titleLight)} /></h2>
				</div>
				<div class="k-marq" aria-hidden="true"><span>{`${marquee} / ${marquee} / ${marquee} /`}</span></div>
				<div class="k-flycards">
					{inside.map((it, i) => (
						<article class="k-fly" style={`--c:${inside.length > 1 ? 0.08 + 0.84 * i / (inside.length - 1) : 0.5};--n:${inside.length}`}>
							<div class="k-fly-top">
								<span class="k-fly-n">{it.n}</span>
								<span class:list={['k-fly-ico', isoLike && 'is-iso']}>{isoLike ? <IsoIcon name={ICO.fly ? ICO.fly[i % ICO.fly.length] : xmas ? xIcons[i % xIcons.length] : iIcons[i % iIcons.length]} mode="static" /> : <SvcIcon name={sIcons[i % sIcons.length]} />}</span>
							</div>
							<h3 set:html={tx(it.t)} />
							<p set:html={tx(it.d)} />
						</article>
					))}
				</div>
				<div class="k-marq-progress"><span></span></div>
			</div>
		</section>
	)}

	<!-- 03 TEKST ZAPALANY SŁOWAMI + LICZNIKI -->
	<section data-cms="2. Zanim zaczniemy + 4. Liczby rynku" hidden={off("mission")} class="k-scene" data-scene style="--h:200">
		<div class="k-sticky" data-sticky data-fit>
			<div class="k-wrap k-mission">
				<p class="k-eyebrow" set:html={tx(o.intro?.eyebrow)} />
				<p class="k-words" data-words set:html={tx(paras(o.intro?.text).slice(1).join(' ') || o.become?.lead || o.intro?.text)} />
				{stats.length > 0 && (
					<div class="k-stats svc-anim">
						{stats.slice(0, 4).map((s) => (
							<div class="k-stat">
								<div class="k-stat-num"><span data-count={s.v}>0</span><small>{s.suf}</small></div>
								<p set:html={tx(s.d)} />
								<span class="k-stat-src">{s.src}</span>
							</div>
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	<!-- 04 KROKI — skokowo, jeden naraz -->
	{steps.length > 0 && (
		<section data-cms="3. Kim się stajesz" hidden={off("steps")} class="k-scene" data-scene style={`--h:${steps.length * 60 + 80}`}>
			<div class="k-sticky" data-sticky data-fit>
				<div class="k-wrap k-steps" data-steps>
					<div class="k-steps-head">
						<p class="k-eyebrow" set:html={tx(o.become?.eyebrow)} />
						<h2 class="k-h2"><span set:html={tx(o.become?.title)} /> <span class="k-light" set:html={tx(o.become?.titleLight)} /></h2>
					</div>
					<div class="k-steps-body k-panel">
						{steps.map((s, i) => (
							<div class="k-step" data-step>
								<span class="k-step-n">{String(i + 1).padStart(2, '0')}<small>/{String(steps.length).padStart(2, '0')}</small></span>
								<h3 set:html={tx(s.t)} />
								<p set:html={tx(s.d)} />
							</div>
						))}
					</div>
					<div class="k-track">
						<span class="k-track-fill"></span>
						{steps.map((s, i) => (
							<div class="k-track-pt" data-dot style={`left:${((i + 0.5) / steps.length) * 100}%`}>
								<span class="k-track-dot"></span><small set:html={tx(s.t)} />
							</div>
						))}
					</div>
					{o.become?.punch && <p class="k-punch" set:html={tx(o.become.punch)} />}
				</div>
			</div>
		</section>
	)}

	<!-- 05 WIELKIE NUMERY -->
	{bigCards.length > 0 && (
		<section data-cms="7. Sekcja specjalna (karty)" hidden={off("bigs")} class="k-sec">
			<div class="k-wrap">
				<div class="k-split-head">
					<p class="k-eyebrow" set:html={tx(o.special?.eyebrow || 'Jak pracujemy')} />
					<h2 class="k-h2"><span set:html={tx(o.special?.title2 || o.special?.title)} /> <span class="k-light" set:html={tx(o.special?.title2Light || o.special?.titleLight)} /></h2>
				</div>
				<div class="k-bigs">
					{bigCards.map((c, i) => (
						<div class="k-big k-panel" data-reveal style={`--d:${i * 0.08}`}>
							<div class="k-big-top">
								<span class="k-big-tag">{c.k || `Krok ${i + 1}`}</span>
								<span class:list={['k-big-ico', isoLike && 'is-iso']}>{isoLike ? <IsoIcon name={(ICO.big ?? (xmas ? ['gwiazda', 'kalendarz-xii', 'prezent', 'choinka'] : ['zarowka', 'kalendarz', 'kamera', 'wykres']))[i % 4]} /> : <SvcIcon name={['strategia', 'kamera', 'motion', 'rolki'][i % 4]} />}</span>
							</div>
							<h3 set:html={tx(c.t)} />
							<p set:html={tx(c.d)} />
							<div class="k-big-num"><span>{String(i + 1).padStart(2, '0')}</span></div>
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- 06 ZOOM OBRAZU Z WYNIKAMI -->
	<section data-cms="5. Wyniki — wykresy" hidden={off("zoom")} class="k-scene" data-scene style="--h:220">
		<div class="k-sticky k-zoom-stage" data-sticky>
			<div class="k-zoom">
				{isoLike && !o.proof?.image ? (
					<div class="k-zoom-iso">
						<IsoIcon name={ICO.zoom?.[0] ?? (xmas ? 'choinka' : 'wykres')} class="kz kz-1" mode="static" />
						<IsoIcon name={ICO.zoom?.[1] ?? (xmas ? 'prezent' : 'moneta')} class="kz kz-2" mode="static" />
						<IsoIcon name={ICO.zoom?.[2] ?? (xmas ? 'bombka' : 'telefon')} class="kz kz-3" mode="static" />
					</div>
				) : <img src={zoomImg} alt="" loading="lazy" />}
				<div class="k-zoom-shade"></div>
				<div class="k-zoom-copy">
					<p class="k-eyebrow k-on-dark" set:html={tx(o.proof?.eyebrow)} />
					<h2 class="k-h2 k-on-dark"><span set:html={tx(o.proof?.title)} /> <span class="k-light" set:html={tx(o.proof?.titleLight)} /></h2>
				</div>
				<div class="k-zoom-chips svc-anim">
					{highlights.map((h, i) => (
						<div class="k-zchip" style={`--d:${i}`}>
							<b>{h.display ? h.display : <><span data-count={h.value}>0</span>{h.unit}</>}</b>
							<span set:html={tx(h.label)} />
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	{(o.proof?.charts?.length > 0 || ctr || scale) && (
		<section data-cms="5. Wyniki — wykresy" hidden={off("charts")} class="k-sec k-charts">
			<div class="k-wrap">
				<div class="k-charts-in">
					<p class="k-lead k-center" set:html={tx(o.proof?.lead)} />
					{ctr && <div class="k-gap"><GapChart {...ctr} quote={ctrQuote} /></div>}
					{scale && <div class="k-gap"><GapChart {...scale} curve="liniowy" /></div>}
					{deltaBlocks.length > 0 && <div class="k-gap"><Blocks blocks={deltaBlocks} theme="dark" /></div>}
					<div class="k-charts-grid">
						{o.proof.charts.map((c: any) => <CompareBars title={c.title} sub={c.sub} unit={c.unit ?? ''} bars={toBars(c.bars)} max={c.max ? Number(c.max) : undefined} source={c.source} float={0} />)}
					</div>
				</div>
			</div>
		</section>
	)}

	<!-- 07 OPINIE W WACHLARZ -->
	<section data-cms="8. Opinie" hidden={off("opinie")} class="k-scene" data-scene style="--h:180">
		<div class="k-sticky" data-sticky data-fit>
			<div class="k-wrap k-fan-wrap">
				<div class="k-fan-head">
					<p class="k-eyebrow" set:html={tx(o.opinie?.eyebrow || 'Opinie')} />
					<h2 class="k-h2"><span set:html={tx(o.opinie?.title)} /> <span class="k-light" set:html={tx(o.opinie?.titleLight)} /></h2>
				</div>
				<div class="k-fan">
					{fan.map((f: any, i) => (
						<figure class:list={['k-fan-card', f.kind === 'stat' && 'is-stat']} style={`--i:${i - (fan.length - 1) / 2}`}>
							{f.kind === 'q' ? (
								<>
									<Stars size={15} />
									<blockquote set:html={tx(`„${f.short}”`)} />
									<figcaption><span><b>{f.name}</b><small>{f.role}</small></span><img src={f.logo} alt={f.logoAlt} loading="lazy" /></figcaption>
								</>
							) : (
								<>
									<span class="k-fan-stat">{f.value}{f.unit}</span>
									<p set:html={tx(f.label)} />
								</>
							)}
						</figure>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 08 CENNIK -->
	<section data-cms="12. Inwestycja (ceny)" hidden={off("cennik")} id="k-cena" class="k-sec">
		<div class="k-wrap">
			<p class="k-eyebrow" set:html={tx(o.invest?.eyebrow)} />
			<h2 class="k-h2"><span set:html={tx(o.invest?.title)} /> <span class="k-light" set:html={tx(o.invest?.titleLight)} /></h2>
			<div class:list={['k-prices', cards.length >= 3 && 'is-3']}>
				{cards.map((c, i) => (
					<div class:list={['k-price', c.featured && 'is-feat']} data-reveal style={`--d:${i * 0.1}`}>
						{isoLike && <span class="k-price-ico is-iso"><IsoIcon name={(ICO.price ?? (xmas ? priceIcons : iPrice))[i % 3]} /></span>}
						<span class="k-price-tag">{c.tag}</span>
						<h3 set:html={tx(c.name)} />
						{cardDeal(c) && <span class="deal-ribbon">Przecena <b>−{cardDeal(c)!.disc}%</b></span>}
						<SaveBadge price={cardDeal(c)?.final ?? c.price} value={cardValue(c)} per={/mies/.test(c.per || '') ? '/ mies.' : ''} label={o.invest?.saveLabel || 'Zyskujesz'} compare={c.valueLabel || o.invest?.compareLabel || undefined} tone={theme === 'kt-light' && !c.featured ? 'light' : 'dark'} />
						<div class="k-price-val">{cardDeal(c) && <s class="k-price-old">{zl(cardDeal(c)!.list)}</s>}<b set:html={cardDeal(c) ? zl(cardDeal(c)!.final).replace(/\u00a0zł$/, '') : tx(c.price)} /><span set:html={tx(c.per)} /></div>
						<p class="k-price-note" set:html={tx(c.note)} />
						<ul>{(c.items ?? []).map((it: string) => <li set:html={tx(it)} />)}</ul>
						{c.ctaLabel && <a href={withUtm(c.ctaHref)} class:list={['k-btn', c.featured ? 'k-btn-acc' : 'k-btn-ghost']}>{c.ctaLabel} →</a>}
					</div>
				))}
			</div>
