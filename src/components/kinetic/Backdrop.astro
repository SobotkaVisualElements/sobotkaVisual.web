---
/*
 * Tło „za szkłem” dla landingu kinetycznego.
 * variant="xmas"     — rozmyte świąteczne kształty 3D w kilku planach głębi + padający śnieg
 * variant="abstract" — miękkie, rozmyte plamy i orbity w kolorach marki (wersja ogólna)
 * Plany: 1 = blisko (ostre, szybkie), 3 = daleko (mocno rozmyte, wolne). Ruch: postęp strony + kursor.
 */
import XmasShape from '../xmas/XmasShape.astro';
import IsoIcon from '../iso/IsoIcon.astro';
interface Props { variant: 'xmas' | 'abstract' | 'iso' | 'hall' }
const { variant } = Astro.props;
const xmas = [
	{ n: 'choinka', x: 3, y: 10, s: 17, d: 3, r: -8 },
	{ n: 'gwiazda', x: 84, y: 7, s: 9, d: 1, r: 12 },
	{ n: 'prezent', x: 80, y: 60, s: 13, d: 2, r: 8 },
	{ n: 'dzwonek', x: 9, y: 66, s: 10, d: 1, r: -14 },
	{ n: 'czapka', x: 90, y: 33, s: 8, d: 3, r: 18 },
	{ n: 'sniezka', x: 38, y: 3, s: 7, d: 2, r: 0 },
	{ n: 'kometa', x: 55, y: 80, s: 12, d: 3, r: -6 },
	{ n: 'piernik', x: -2, y: 40, s: 11, d: 2, r: 6 },
	{ n: 'sanie', x: 62, y: 24, s: 15, d: 3, r: -4 },
	{ n: 'bombka', x: 27, y: 84, s: 8, d: 1, r: 10 },
	{ n: 'sniezka', x: 93, y: 86, s: 6, d: 1, r: 20 },
	{ n: 'choinka', x: 72, y: -6, s: 10, d: 2, r: 6 },
	{ n: 'gwiazda', x: 20, y: 38, s: 5, d: 3, r: -20 },
	{ n: 'bombka', x: 46, y: 50, s: 6, d: 3, r: 0 },
];
const blobs = [
	{ x: -8, y: 5, s: 42, c: 'rgba(237,36,78,.22)', d: 3 },
	{ x: 70, y: 18, s: 36, c: 'rgba(27,5,69,.16)', d: 2 },
	{ x: 30, y: 70, s: 44, c: 'rgba(160,120,255,.16)', d: 3 },
	{ x: 82, y: 72, s: 26, c: 'rgba(237,36,78,.16)', d: 1 },
];
// halloween: rozmyte ikony w planach głębi, księżyc, przelatujące nietoperze, mgła i unoszące się iskry
const hallIt = [
	{ n: 'dynia', x: 2, y: 62, s: 15, d: 2 }, { n: 'duch', x: 86, y: 52, s: 11, d: 1 }, { n: 'nagrobek', x: 70, y: 74, s: 13, d: 3 },
	{ n: 'kociol', x: 14, y: 14, s: 10, d: 3 }, { n: 'dynia', x: 44, y: 84, s: 8, d: 3 }, { n: 'duch', x: 32, y: 30, s: 6, d: 3 },
];
const bats = Array.from({ length: 9 }, (_, i) => ({ y: 6 + ((i * 23) % 60), s: 18 + ((i * 7) % 26), dur: 14 + ((i * 5) % 12), del: -((i * 3.7) % 20), rev: i % 3 === 0 }));
const embers = Array.from({ length: 30 }, (_, i) => ({ x: (i * 37.3) % 100, s: 2 + (i % 3), dur: 7 + (i % 6), del: -((i * 1.9) % 9), c: i % 3 === 0 ? '#3dff8f' : '#ffb05c' }));
const flakes = Array.from({ length: 46 }, (_, i) => ({
	x: (i * 37.7) % 100, s: 2 + ((i * 7) % 5), dur: 9 + ((i * 13) % 11), del: -((i * 5.3) % 18), b: i % 3 === 0 ? 2 : 0, o: 0.35 + ((i * 11) % 6) / 10,
}));
---
<div class:list={['bd', `bd-${variant}`]} aria-hidden="true">
	{variant === 'iso' ? (
		<>
			<div class="bd-isogrid"></div>
			{[{ x: 6, y: 18, s: 9, d: 3 }, { x: 84, y: 12, s: 7, d: 2 }, { x: 74, y: 70, s: 11, d: 3 }, { x: 12, y: 78, s: 6, d: 1 }, { x: 46, y: 6, s: 5, d: 2 }, { x: 92, y: 46, s: 5, d: 1 }, { x: 30, y: 52, s: 4, d: 3 }].map((b) => (
				<div class="bd-it" data-bd={[0.34, 0.2, 0.09][b.d - 1]} data-rot="0" style={`left:${b.x}vw;top:${b.y}vh;width:${b.s}vw;--blur:${[1, 4, 9][b.d - 1]}px;--op:${[0.9, 0.7, 0.5][b.d - 1]}`}>
					<svg viewBox="0 0 100 70" class="bd-cube" style={`filter:blur(var(--blur));opacity:var(--op)`}>
						<polygon points="50,6 94,28 50,50 6,28" fill="#6d4dff" /><polygon points="6,28 50,50 50,62 6,40" fill="#3a2399" /><polygon points="94,28 50,50 50,62 94,40" fill="#24166b" />
						<polyline points="6,28 50,6 94,28" fill="none" stroke="#8ff4ff" stroke-width="1.2" />
					</svg>
				</div>
			))}
			<div class="bd-streaks">{Array.from({ length: 26 }, (_, i) => <i style={`left:${(i * 37.3) % 100}%;animation-duration:${4 + (i % 5)}s;animation-delay:${-((i * 1.7) % 6)}s;height:${18 + (i % 4) * 10}px;opacity:${0.25 + (i % 4) * 0.15}`} />)}</div>
		</>
	) : variant === 'hall' ? (
		<>
			<div class="bd-it bd-moon" data-bd="0.06" data-rot="0" style="left:68vw;top:6vh;width:22vw"></div>
			{hallIt.map((it) => (
				<div class="bd-it" data-bd={[0.34, 0.2, 0.09][it.d - 1]} data-rot="0" style={`left:${it.x}vw;top:${it.y}vh;width:${it.s}vw;--blur:${[1, 4, 9][it.d - 1]}px;--op:${[0.85, 0.6, 0.4][it.d - 1]}`}>
					<div style="filter:blur(var(--blur));opacity:var(--op)"><IsoIcon name={it.n} mode="static" platform={false} /></div>
				</div>
			))}
			<div class="bd-bats">{bats.map((b) => (
				<i class:list={[b.rev && 'is-rev']} style={`top:${b.y}vh;width:${b.s}px;animation-duration:${b.dur}s;animation-delay:${b.del}s`}>
					<svg viewBox="0 0 60 26"><path d="M30 8 C26 2 18 0 10 4 C14 6 15 10 14 14 C18 10 22 11 24 16 C26 12 28 12 30 14 C32 12 34 12 36 16 C38 11 42 10 46 14 C45 10 46 6 50 4 C42 0 34 2 30 8 Z" /></svg>
				</i>
			))}</div>
			<div class="bd-fog"><span></span><span></span></div>
			<div class="bd-embers">{embers.map((e) => <i style={`left:${e.x}%;width:${e.s}px;height:${e.s}px;background:${e.c};box-shadow:0 0 8px ${e.c};animation-duration:${e.dur}s;animation-delay:${e.del}s`} />)}</div>
		</>
	) : variant === 'xmas' ? (
		<>
			{xmas.map((it) => (
				<div class="bd-it" data-bd={[0.38, 0.22, 0.1][it.d - 1]} data-rot={it.r}
					style={`left:${it.x}vw;top:${it.y}vh;width:${it.s}vw;--blur:${[1.5, 5, 11][it.d - 1]}px;--op:${[0.95, 0.8, 0.6][it.d - 1]};--fd:${6 + it.d * 2}s;--fl:${(it.x % 5) * -1}s`}>
					<div class="bd-3d"><XmasShape name={it.n} mode="static" /></div>
				</div>
			))}
			<div class="bd-snow">
				{flakes.map((f) => <i style={`left:${f.x}%;width:${f.s}px;height:${f.s}px;animation-duration:${f.dur}s;animation-delay:${f.del}s;filter:blur(${f.b}px);opacity:${f.o}`} />)}
			</div>
		</>
	) : (
		<>
			{blobs.map((b) => (
				<div class="bd-it bd-blob" data-bd={[0.3, 0.18, 0.08][b.d - 1]} data-rot="0" style={`left:${b.x}vw;top:${b.y}vh;width:${b.s}vw;--c:${b.c}`}></div>
			))}
			<div class="bd-it" data-bd="0.12" data-rot="40" style="left:58vw;top:8vh;width:46vw;--blur:0px;--op:1">
				<svg viewBox="0 0 200 200" class="bd-orbit"><circle cx="100" cy="100" r="98" /><circle cx="100" cy="100" r="66" /><circle cx="100" cy="100" r="34" /><circle class="o-dot" cx="100" cy="2" r="3" /><circle class="o-dot" cx="166" cy="100" r="2.5" /></svg>
			</div>
		</>
	)}
</div>

<style is:global>
	.bd { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.bd-it { position: absolute; will-change: transform; }
	.bd-3d { will-change: transform; filter: blur(var(--blur)) drop-shadow(0 18px 24px rgba(60,30,20,.18)); opacity: var(--op); transform-style: preserve-3d; animation: bd-float var(--fd) var(--fl) ease-in-out infinite; }
	.bd-3d svg { width: 100%; height: auto; display: block; }
	@keyframes bd-float { 0%,100% { transform: perspective(600px) rotateY(-14deg) rotateX(6deg) translateY(0); } 50% { transform: perspective(600px) rotateY(16deg) rotateX(-4deg) translateY(-14px); } }
	.bd-blob { aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 40%, var(--c), transparent 68%); filter: blur(30px); }
	.bd-orbit { width: 100%; fill: none; stroke: rgba(27,5,69,.08); stroke-width: .6; }
	.kt-dark .bd-orbit { stroke: rgba(255,255,255,.08); }
	.bd-orbit .o-dot { fill: var(--acc); stroke: none; }
	.bd-snow i { position: absolute; top: -10px; border-radius: 50%; background: #fff; box-shadow: 0 0 6px rgba(255,255,255,.9); animation: bd-snow linear infinite; }
	@keyframes bd-snow { to { transform: translate3d(40px, 110vh, 0); } }
	.bd-isogrid { position: absolute; left: -20%; right: -20%; bottom: -10%; height: 70%; opacity: .5;
		background-image: linear-gradient(30deg, rgba(143,244,255,.09) 1px, transparent 1px), linear-gradient(150deg, rgba(143,244,255,.09) 1px, transparent 1px);
		background-size: 64px 37px; mask-image: linear-gradient(to top, #000 10%, transparent 85%); -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 85%); }
	.bd-cube { width: 100%; display: block; animation: bd-bob 7s ease-in-out infinite; will-change: transform; }
	@keyframes bd-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16px); } }
	.bd-streaks i { position: absolute; bottom: -40px; width: 2px; border-radius: 2px; background: linear-gradient(to top, transparent, #b48bff, #8ff4ff); animation: bd-streak linear infinite; }
	@keyframes bd-streak { to { transform: translateY(-115vh); } }
	/* halloween */
	.bd-moon { aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 38% 34%, #fffbe0, #ffd27a 60%, #f2a93b); box-shadow: 0 0 80px 20px rgba(255,190,90,.35), 0 0 220px 60px rgba(255,138,30,.18); opacity: .9; }
	.bd-bats i { position: absolute; left: -10vw; display: block; animation: bd-bat linear infinite; }
	.bd-bats i.is-rev { left: auto; right: -10vw; animation-name: bd-bat-r; }
	.bd-bats svg { width: 100%; display: block; fill: #0b0320; animation: bd-flap .28s ease-in-out infinite alternate; transform-origin: center; filter: drop-shadow(0 0 6px rgba(61,255,143,.35)); }
	@keyframes bd-bat { 0% { transform: translate(0, 0); } 25% { transform: translate(30vw, -4vh); } 50% { transform: translate(60vw, 3vh); } 75% { transform: translate(90vw, -3vh); } 100% { transform: translate(122vw, 2vh); } }
	@keyframes bd-bat-r { 0% { transform: translate(0, 0) scaleX(-1); } 50% { transform: translate(-60vw, -5vh) scaleX(-1); } 100% { transform: translate(-122vw, 2vh) scaleX(-1); } }
	@keyframes bd-flap { from { transform: scaleY(1); } to { transform: scaleY(.45); } }
	.bd-fog { position: absolute; left: 0; right: 0; bottom: 0; height: 40vh; }
	.bd-fog span { position: absolute; inset: 0; width: 200%; background: radial-gradient(40% 60% at 25% 100%, rgba(185,160,255,.16), transparent 70%), radial-gradient(35% 50% at 75% 100%, rgba(61,255,143,.08), transparent 70%); animation: bd-fog 38s linear infinite; }
	.bd-fog span + span { animation-duration: 56s; animation-direction: reverse; opacity: .7; }
	@keyframes bd-fog { to { transform: translateX(-50%); } }
	.bd-embers i { position: absolute; bottom: -10px; border-radius: 50%; animation: bd-ember linear infinite; }
	@keyframes bd-ember { 0% { transform: translate(0, 0); opacity: 0; } 15% { opacity: .9; } 100% { transform: translate(30px, -110vh); opacity: 0; } }
	@media (max-width: 767px) { .bd-bats i:nth-child(n+5), .bd-embers i:nth-child(2n) { display: none; } .bd-moon { width: 40vw !important; left: 55vw !important; } }
	@media (prefers-reduced-motion: reduce) { .bd-bats i, .bd-bats svg, .bd-fog span, .bd-embers i { animation: none; } .bd-bats { display: none; } }
	@media (max-width: 767px) { .bd-it { width: calc(var(--mw, 1) * 22vw) !important; } .bd-snow i:nth-child(2n) { display: none; } }
	@media (prefers-reduced-motion: reduce) { .bd-3d, .bd-snow i, .bd-cube, .bd-streaks i { animation: none; } }
</style>
<style is:global>
	/* TRYB LEKKI (html.k-lite): włącza się sam, gdy komputer nie nadąża (mniej niż ~45 klatek/s przy przewijaniu).
	   Wyłącza najcięższe efekty: rozmycie pod szklanymi panelami, rozmyte elementy tła, cienie ikon. Treść i animacje ikon zostają. */
	html.k-lite .k-panel, html.k-lite .k-stat, html.k-lite .k-zchip, html.k-lite .glass, html.k-lite .liquid-card { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
	html.k-lite .k-panel, html.k-lite .k-stat { background: var(--panel2, #1d1750) !important; }
	html.k-lite .bd-it > *, html.k-lite .bd-3d, html.k-lite .bd-blob { filter: none !important; }
	html.k-lite .bd-it:nth-of-type(n+4), html.k-lite .bd-streaks, html.k-lite .bd-fog, html.k-lite .bd-embers i:nth-child(2n), html.k-lite .bd-snow i:nth-child(2n) { display: none !important; }
	html.k-lite .ki, html.k-lite .kz, html.k-lite .iso, html.k-lite .dk-ico .iso, html.k-lite .ul-top-ico .iso { filter: none !important; }
	html.k-lite .bd-bats svg { filter: none !important; }
</style>
<script>
	// mierzy płynność przez pierwsze sekundy (i przy pierwszym przewijaniu); słaby komputer → tryb lekki
	if (!(window as any).__kLite) {
		(window as any).__kLite = true;
		const html = document.documentElement;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) html.classList.add('k-lite');
		const measure = (ms: number) => new Promise<number>((res) => {
			let n = 0, t0 = 0, slow = 0, last = 0;
			const f = (t: number) => { if (!t0) { t0 = last = t; } else { if (t - last > 34) slow++; n++; last = t; } if (t - t0 < ms) requestAnimationFrame(f); else res(n ? slow / n : 0); };
			requestAnimationFrame(f);
		});
		const check = async () => { if (html.classList.contains('k-lite')) return; const r = await measure(1600); if (r > 0.18) html.classList.add('k-lite'); };
		addEventListener('load', () => setTimeout(check, 400), { once: true });
		addEventListener('scroll', () => setTimeout(check, 50), { once: true, passive: true });
		// ręczne wymuszenie do testów: ?lite=1
		if (/[?&]lite=1/.test(location.search)) html.classList.add('k-lite');
	}
</script>
