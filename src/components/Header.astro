---
import Logo from './Logo.astro';

const links = [
	{ href: '/#oferta', label: 'Oferta' },
	{ href: '/work', label: 'Realizacje' },
	{ href: '/#kontakt', label: 'Kontakt' },
];

// TODO: wklej prawdziwe adresy profili
const socials = [
	{ label: 'YouTube', href: '#', icon: 'yt' },
	{ label: 'Facebook', href: '#', icon: 'fb' },
	{ label: 'TikTok', href: '#', icon: 'tt' },
];
---

<nav
	id="site-nav"
	class="sticky top-0 z-50 border-b-[3px] border-orange bg-ink/96 backdrop-blur-xl transition-shadow duration-250"
>
	<div class="mx-auto flex max-w-[1200px] items-center gap-8 px-8 py-4">
		<Logo />
		<div class="hidden gap-7 text-[15px] font-semibold md:flex">
			{links.map((link) => <a href={link.href} class="text-sky hover:text-orange">{link.label}</a>)}
		</div>
		<div class="ml-auto flex items-center gap-4">
			<div class="hidden items-center gap-3.5 sm:flex">
				{
					socials.map((s) => (
						<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class="text-sky transition-colors hover:text-orange">
							{s.icon === 'yt' && (
								<svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6z"/></svg>
							)}
							{s.icon === 'fb' && (
								<svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7v-3.5h3.1V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9v2.2h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
							)}
							{s.icon === 'tt' && (
								<svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8a4.8 4.8 0 0 1-1-.9 4.6 4.6 0 0 1-1-2.4h-3.3v13.2a2.7 2.7 0 1 1-1.9-2.6v-3.4a6 6 0 1 0 5.2 6V9.3a7.9 7.9 0 0 0 4.6 1.5V7.4a4.6 4.6 0 0 1-1.6-.3 4.6 4.6 0 0 1-1-1.3z"/></svg>
							)}
						</a>
					))
				}
			</div>
			<a
				href="/#kontakt"
				class="rounded-full bg-orange px-5 py-2.5 text-[15px] font-bold text-cloud shadow-[3px_3px_0_var(--color-cloud)] transition-[transform,box-shadow] hover:-translate-x-px hover:-translate-y-px hover:shadow-[4px_4px_0_var(--color-cloud)]"
				>Bezpłatna wycena</a
			>
		</div>
	</div>
</nav>

<script>
	const nav = document.getElementById('site-nav');
	const onScroll = () => {
		if (!nav) return;
		nav.style.boxShadow = window.scrollY > 8 ? '0 6px 20px rgb(10 6 48 / 0.35)' : 'none';
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>
