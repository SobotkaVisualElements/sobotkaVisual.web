---
/*
 * Świąteczne kształty w stylu „miękkich gradientów” (światło z lewej góry, cień w prawym dole).
 * mode="draw"   — ikona w treści: przy wejściu w ekran rysuje się kontur, potem wlewa kolor i lekko „podskakuje”
 * mode="static" — kształt do tła (bez animacji rysowania; ruch i rozmycie nadaje warstwa tła)
 */
interface Props { name: string; mode?: 'draw' | 'static'; class?: string; style?: string }
const { name, mode = 'draw', class: cls = '', style } = Astro.props;
const u = 'x' + Math.random().toString(36).slice(2, 8);
const g = (id: string) => `url(#${u}-${id})`;
// gwiazda 5-ramienna z fasetami (jasna/ciemna połowa każdego ramienia = efekt 3D)
const star = (cx: number, cy: number, R: number, r: number) => {
	const pts = Array.from({ length: 10 }, (_, i) => {
		const a = -Math.PI / 2 + (i * Math.PI) / 5;
		const rad = i % 2 ? r : R;
		return [cx + rad * Math.cos(a), cy + rad * Math.sin(a)];
	});
	const facets = pts.map((p, i) => {
		const q = pts[(i + 1) % 10];
		return { d: `M${cx} ${cy} L${p[0].toFixed(1)} ${p[1].toFixed(1)} L${q[0].toFixed(1)} ${q[1].toFixed(1)} Z`, light: i % 2 === 0 };
	});
	const outline = 'M' + pts.map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' L') + ' Z';
	return { facets, outline };
};
const big = star(50, 52, 42, 18);
const small = star(50, 13, 9, 4);
const shoot = star(72, 30, 20, 8.5);
---
<svg viewBox="0 0 100 100" class:list={['xs', `xs-${mode}`, mode === 'draw' && 'svc-anim', cls]} style={style} aria-hidden="true">
	<defs>
		<linearGradient id={`${u}-gold`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f2d891" /><stop offset="1" stop-color="#c9933f" /></linearGradient>
		<linearGradient id={`${u}-goldD`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#dcb465" /><stop offset="1" stop-color="#a8742e" /></linearGradient>
		<linearGradient id={`${u}-red`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ec8f8f" /><stop offset="1" stop-color="#b23a48" /></linearGradient>
		<linearGradient id={`${u}-green`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9cc48f" /><stop offset="1" stop-color="#3f7552" /></linearGradient>
		<linearGradient id={`${u}-olive`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#dde59a" /><stop offset="1" stop-color="#86ad74" /></linearGradient>
		<linearGradient id={`${u}-cream`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbf6ee" /><stop offset="1" stop-color="#d9ccb9" /></linearGradient>
		<linearGradient id={`${u}-brown`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ad7c61" /><stop offset="1" stop-color="#6b4433" /></linearGradient>
		<linearGradient id={`${u}-lilac`} x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#c9a6d9" /><stop offset="1" stop-color="#f1d9ea" /></linearGradient>
		<linearGradient id={`${u}-snow`} gradientUnits="userSpaceOnUse" x1="10" y1="10" x2="90" y2="90"><stop offset="0" stop-color="#e3e6f2" /><stop offset="1" stop-color="#8e98c4" /></linearGradient>
		<radialGradient id={`${u}-shine`} cx=".32" cy=".28" r=".55"><stop offset="0" stop-color="#fff" stop-opacity=".75" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
	</defs>

	{name === 'choinka' && (<g>
		<rect class="xo" pathLength="1" x="44" y="78" width="12" height="14" rx="2" fill={g('brown')} stroke="#6b4433" />
		<path class="xo" pathLength="1" d="M50 44 L83 82 Q50 88 17 82 Z" fill={g('green')} stroke="#3f7552" />
		<path class="xo" pathLength="1" d="M50 28 L75 60 Q50 65 25 60 Z" fill={g('green')} stroke="#3f7552" />
		<path class="xo" pathLength="1" d="M50 14 L66 40 Q50 44 34 40 Z" fill={g('green')} stroke="#3f7552" />
		<circle class="xf" cx="40" cy="70" r="3.6" fill={g('gold')} /><circle class="xf" cx="62" cy="74" r="3.6" fill={g('red')} />
		<circle class="xf" cx="56" cy="52" r="3.2" fill={g('gold')} /><circle class="xf" cx="42" cy="47" r="3" fill={g('red')} />
		{small.facets.map((f) => <path class="xf" d={f.d} fill={f.light ? g('gold') : g('goldD')} />)}
	</g>)}

	{name === 'gwiazda' && (<g>
		{big.facets.map((f) => <path class="xf" d={f.d} fill={f.light ? g('gold') : g('goldD')} />)}
		<path class="xo xo-only xo-thin" pathLength="1" d={big.outline} fill="none" stroke="#a8742e" />
	</g>)}

	{name === 'prezent' && (<g>
		<rect class="xo" pathLength="1" x="18" y="42" width="64" height="46" rx="5" fill={g('olive')} stroke="#6f9a62" />
		<rect class="xo" pathLength="1" x="13" y="30" width="74" height="15" rx="4" fill={g('olive')} stroke="#6f9a62" />
		<rect class="xf" x="44" y="30" width="12" height="58" fill={g('red')} />
		<path class="xo" pathLength="1" d="M50 30 C38 14 22 20 30 29 C34 33 44 31 50 30 C56 31 66 33 70 29 C78 20 62 14 50 30 Z" fill={g('red')} stroke="#b23a48" />
		<rect x="18" y="42" width="64" height="46" rx="5" fill={g('shine')} class="xf" />
	</g>)}

	{name === 'dzwonek' && (<g>
		<path class="xo" pathLength="1" d="M50 22 C31 22 28 40 28 58 C28 66 24 70 19 75 L81 75 C76 70 72 66 72 58 C72 40 69 22 50 22 Z" fill={g('gold')} stroke="#a8742e" />
		<rect class="xo" pathLength="1" x="17" y="73" width="66" height="8" rx="4" fill={g('goldD')} stroke="#a8742e" />
		<circle class="xf" cx="50" cy="86" r="6.5" fill={g('goldD')} />
		<path class="xo" pathLength="1" d="M50 20 C40 8 26 12 33 21 C37 25 45 22 50 20 C55 22 63 25 67 21 C74 12 60 8 50 20 Z" fill={g('red')} stroke="#b23a48" />
		<circle class="xf" cx="50" cy="20" r="5" fill={g('red')} />
		<path d="M50 22 C31 22 28 40 28 58 L50 58 Z" fill={g('shine')} class="xf" />
	</g>)}

	{name === 'czapka' && (<g>
		<path class="xo" pathLength="1" d="M22 74 C26 46 38 26 58 22 C72 19 82 26 80 38 C74 32 66 34 64 42 C70 54 74 64 78 74 Z" fill={g('red')} stroke="#b23a48" />
		<rect class="xo" pathLength="1" x="14" y="70" width="72" height="16" rx="8" fill={g('cream')} stroke="#c8b8a2" />
		<circle class="xo" pathLength="1" cx="80" cy="36" r="10" fill={g('cream')} stroke="#c8b8a2" />
		<path d="M30 70 C34 50 42 34 56 28 C46 40 40 54 38 70 Z" fill={g('shine')} class="xf" />
	</g>)}

	{name === 'sniezka' && (<g fill="none" stroke={g('snow')} stroke-width="6" stroke-linecap="round">
		{[0, 60, 120].map((a) => (
			<g transform={`rotate(${a} 50 50)`}>
				<line class="xo xo-only" pathLength="1" x1="50" y1="12" x2="50" y2="88" />
				<path class="xo xo-only" pathLength="1" d="M41 20 L50 29 L59 20" /><path class="xo xo-only" pathLength="1" d="M41 80 L50 71 L59 80" />
			</g>
		))}
	</g>)}

	{name === 'kometa' && (<g>
		<path class="xo" pathLength="1" d="M60 36 C40 38 22 50 16 74 C14 82 22 86 26 80 C30 74 30 70 34 72 C40 62 50 52 66 46 Z" fill={g('lilac')} stroke="#b79ad0" />
		{shoot.facets.map((f) => <path class="xf" d={f.d} fill={f.light ? g('gold') : g('goldD')} />)}
	</g>)}

	{name === 'piernik' && (<g>
		<path class="xo" pathLength="1" d="M20 48 L50 20 L80 48 L80 86 Q80 88 78 88 L22 88 Q20 88 20 86 Z" fill={g('brown')} stroke="#6b4433" />
		<path class="xo" pathLength="1" d="M42 88 L42 70 Q50 60 58 70 L58 88 Z" fill={g('cream')} stroke="#c8b8a2" />
		<circle class="xf" cx="50" cy="46" r="6" fill={g('cream')} />
		{[[30, 44], [40, 35], [60, 35], [70, 44], [28, 60], [72, 60], [28, 75], [72, 75]].map(([x, y]) => <circle class="xf" cx={x} cy={y} r="2.6" fill="#f3e2b8" />)}
	</g>)}

	{name === 'sanie' && (<g>
		<path class="xo xo-only" pathLength="1" d="M14 78 L80 78 C90 78 92 68 86 64" fill="none" stroke="#c9933f" stroke-width="5" stroke-linecap="round" />
		<path class="xo" pathLength="1" d="M18 44 C18 38 24 36 28 40 L36 50 L74 50 C80 50 84 46 86 40 L90 42 C88 60 80 70 66 70 L30 70 C22 70 18 64 18 56 Z" fill={g('red')} stroke="#b23a48" />
		<path class="xf" d="M30 58 L80 58" stroke={g('cream')} stroke-width="4" stroke-linecap="round" />
		<path class="xf" d="M30 70 L28 78 M66 70 L68 78" stroke={g('goldD')} stroke-width="4" stroke-linecap="round" />
		<path d="M22 46 L34 54 L60 54 L60 62 L26 62 Z" fill={g('shine')} class="xf" />
	</g>)}

	{name === 'bombka' && (<g>
		<rect class="xo" pathLength="1" x="42" y="14" width="16" height="10" rx="2" fill={g('gold')} stroke="#a8742e" />
		<circle class="xo" pathLength="1" cx="50" cy="56" r="32" fill={g('red')} stroke="#b23a48" />
		<path class="xf" d="M22 52 Q50 62 78 52" fill="none" stroke={g('gold')} stroke-width="3" />
		<circle cx="50" cy="56" r="32" fill={g('shine')} class="xf" />
	</g>)}

	{name === 'konfetti' && (<g>
		<path class="xo" pathLength="1" d="M18 86 L36 38 L62 64 Z" fill={g('gold')} stroke="#a8742e" />
		<rect class="xf" x="58" y="14" width="5" height="16" rx="2" transform="rotate(25 60 22)" fill={g('red')} />
		<rect class="xf" x="70" y="30" width="5" height="22" rx="2" transform="rotate(50 72 40)" fill="#8fa2d8" />
		<circle class="xf" cx="52" cy="18" r="3" fill={g('gold')} /><circle class="xf" cx="80" cy="22" r="3" fill={g('gold')} /><circle class="xf" cx="84" cy="62" r="3" fill={g('red')} />
		<path class="xo xo-only" pathLength="1" d="M48 40 C54 30 62 34 66 26" fill="none" stroke="#c4505c" stroke-width="4" stroke-linecap="round" />
	</g>)}
</svg>

<style is:global>
	.xs { overflow: visible; }
	.xs-draw .xo { stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; fill-opacity: 0;
		transition: stroke-dashoffset 1.1s cubic-bezier(.65,0,.35,1), fill-opacity .7s .75s ease; }
	.xs-draw .xo-only { stroke-width: 6; }
	.xs-draw .xo-thin { stroke-width: 1.6; }
	.xs-static .xo-thin { stroke: none; }
	.xs-draw .xf { opacity: 0; transition: opacity .6s .9s ease; }
	.xs-draw { transform: scale(.82) rotate(-6deg); opacity: .001; transition: transform .9s cubic-bezier(.3,1.6,.5,1), opacity .3s; }
	.xs-draw.is-in { transform: none; opacity: 1; }
	.xs-draw.is-in .xo { stroke-dashoffset: 0; fill-opacity: 1; }
	.xs-draw.is-in .xf { opacity: 1; }
	.xs-static .xo { stroke: none; }
	.xs-static .xo-only { stroke: inherit; }
	@media (prefers-reduced-motion: reduce) {
		.xs-draw, .xs-draw .xo, .xs-draw .xf { transition: none; transform: none; opacity: 1; stroke-dashoffset: 0; fill-opacity: 1; }
	}
</style>
<script>
	import '../../scripts/parallax.ts';
</script>
