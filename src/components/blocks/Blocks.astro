---
/*
 * Klocki treści z panelu CMS („plusik”): tekst, zdjęcie, karuzela, wideo,
 * kafelek z parallaksą, wykres liniowy %, wykres kołowy %, cytat.
 * theme="light" dla case studies (jasne tło), "dark" dla podstron (ciemne tło).
 */
import LayerTile from '../ui/LayerTile.astro';
import VideoLoop from '../ui/VideoLoop.astro';
import { md } from '../../lib/md';

interface Props { blocks?: any[]; theme?: 'light' | 'dark' }
const { blocks = [], theme = 'light' } = Astro.props;

const ytId = (u = '') => {
	const m = u.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([\w-]{11})/);
	return m ? m[1] : '';
};
const num = (v: any, d = 0) => (Number.isFinite(parseFloat(v)) ? parseFloat(v) : d);

// wykres liniowy: albo punkty z panelu („21, 15, 9”), albo krzywa wzrostu do podanej wartości
function linePath(b: any) {
	const W = 640, H = 170, P = 12;
	let pts: number[] = String(b.points ?? '').split(/[;,\s]+/).map(parseFloat).filter(Number.isFinite);
	let xy: [number, number][];
	if (pts.length >= 2) {
		const max = Math.max(...pts), min = Math.min(0, ...pts);
		xy = pts.map((v, i) => [P + (i / (pts.length - 1)) * (W - 2 * P), H - P - ((v - min) / (max - min || 1)) * (H - 3 * P)]);
	} else {
		const v = Math.abs(num(b.value, 20));
		const rise = Math.min(0.85, 0.25 + v / 150) * (H - 3 * P);
		const sign = num(b.value, 20) < 0 ? -1 : 1;
		const n = 7;
		xy = Array.from({ length: n }, (_, i) => {
			const t = i / (n - 1);
			const e = t * t * (3 - 2 * t);
			const wob = i && i < n - 1 ? Math.sin(i * 2.1) * 6 : 0;
			const y0 = sign > 0 ? H - 2 * P : P * 2 + 10;
			return [P + t * (W - 2 * P), y0 - sign * e * rise + wob];
		});
	}
	let d = `M${xy[0][0].toFixed(1)} ${xy[0][1].toFixed(1)}`;
	for (let i = 1; i < xy.length; i++) {
		const [x0, y0] = xy[i - 1], [x1, y1] = xy[i];
		const cx = (x0 + x1) / 2;
		d += ` C${cx.toFixed(1)} ${y0.toFixed(1)}, ${cx.toFixed(1)} ${y1.toFixed(1)}, ${x1.toFixed(1)} ${y1.toFixed(1)}`;
	}
	const last = xy[xy.length - 1];
	return { d, area: `${d} L${last[0].toFixed(1)} ${H} L${xy[0][0].toFixed(1)} ${H} Z`, last, W, H };
}
---
<div class:list={['svc-blocks', `svc-blocks--${theme}`]}>
	{blocks.map((b: any, bi: number) => {
		switch (b?.type) {
			case 'tekst':
				return <div class="svc-b svc-text" set:html={md(b.text)} />;

			case 'zdjecie':
				return b.image && (
					<figure class:list={['svc-b', b.width === 'waska' && 'svc-narrow']}>
						<img src={b.image} alt={b.alt || b.caption || ''} loading="lazy" decoding="async" class="svc-media" />
						{b.caption && <figcaption>{b.caption}</figcaption>}
					</figure>
				);

			case 'karuzela': {
				const imgs = (b.images ?? []).filter((x: any) => x?.image);
				return imgs.length > 0 && (
					<figure class="svc-b svc-carousel" data-carousel>
						<div class="svc-track">
							{imgs.map((x: any) => (
								<div class="svc-slide">
									<img src={x.image} alt={x.caption || ''} loading="lazy" decoding="async" class="svc-media" />
									{x.caption && <span class="svc-slide-cap">{x.caption}</span>}
								</div>
							))}
						</div>
						{imgs.length > 1 && (
							<div class="svc-car-nav">
								<button type="button" data-dir="-1" aria-label="Poprzednie">←</button>
								<span data-pos>1 / {imgs.length}</span>
								<button type="button" data-dir="1" aria-label="Następne">→</button>
							</div>
						)}
					</figure>
				);
			}

			case 'wideo': {
				const id = ytId(b.youtube);
				const vert = b.format === '9:16';
				return (id || b.file) && (
					<figure class:list={['svc-b', vert && 'svc-vertical']}>
						{b.mode === 'zwykly' ? (
							id ? (
								<button type="button" class:list={['svc-yt svc-media', vert ? 'aspect-[9/16]' : 'aspect-video']} data-yt={id} aria-label={`Odtwórz: ${b.caption || 'wideo'}`}>
									<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
									<span class="svc-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
								</button>
							) : (
								<video src={b.file} controls controlslist="nodownload" preload="metadata" playsinline class:list={['svc-media', vert ? 'aspect-[9/16]' : 'aspect-video']} />
							)
						) : (
							<VideoLoop youtube={b.youtube} file={b.file} ratio={vert ? '9:16' : '16:9'} title={b.caption || 'Wideo'} class="svc-media rounded-[16px]" />
						)}
						{b.caption && <figcaption>{b.caption}</figcaption>}
					</figure>
				);
			}

			case 'parallaksa':
				return (
					<figure class="svc-b liquid-card">
						<div class="overflow-hidden rounded-[16px]">
							<LayerTile layers={b.layers} strength={b.strength ?? 100} alt={b.caption || ''} placeholder={theme} />
						</div>
						{b.caption && <figcaption>{b.caption}</figcaption>}
					</figure>
				);

			case 'wykres_liniowy': {
				const L = linePath(b);
				const gid = `lg${bi}`;
				const v = num(b.value, 0);
				return (
					<div class="svc-b svc-stat svc-anim" data-float="28">
						<div class="svc-stat-head">
							<span class="svc-stat-num"><span data-count={Math.abs(v)} data-prefix={b.prefix ?? (v > 0 ? '+' : v < 0 ? '−' : '')} data-suffix={b.suffix ?? '%'}>0</span></span>
							<span class="svc-stat-label">{b.label}</span>
						</div>
						<svg viewBox={`0 0 ${L.W} ${L.H}`} class="svc-line" aria-hidden="true">
							<defs><linearGradient id={gid} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--color-orange)" stop-opacity=".28" /><stop offset="1" stop-color="var(--color-orange)" stop-opacity="0" /></linearGradient></defs>
							{[0.25, 0.5, 0.75].map((g) => <line x1="0" x2={L.W} y1={L.H * g} y2={L.H * g} class="svc-grid" />)}
							<path d={L.area} fill={`url(#${gid})`} class="svc-area" />
							<path d={L.d} pathLength="1" class="svc-stroke" />
							<circle cx={L.last[0]} cy={L.last[1]} r="5" class="svc-end" />
						</svg>
						{b.description && <p class="svc-stat-desc">{b.description}</p>}
					</div>
				);
			}

			case 'wykres_kolowy': {
				const v = Math.max(0, Math.min(100, num(b.value, 0)));
				return (
					<div class="svc-b svc-stat svc-stat--ring svc-anim" data-float="28">
						<div class="svc-ring" style={`--v:${v}`}>
							<svg viewBox="0 0 120 120" aria-hidden="true">
								<circle cx="60" cy="60" r="50" class="svc-ring-track" />
								<circle cx="60" cy="60" r="50" pathLength="100" class="svc-ring-val" />
							</svg>
							<span class="svc-stat-num"><span data-count={num(b.value, 0)} data-suffix={b.suffix ?? '%'}>0</span></span>
						</div>
						<div>
							<span class="svc-stat-label">{b.label}</span>
							{b.description && <p class="svc-stat-desc">{b.description}</p>}
						</div>
					</div>
				);
			}

			case 'cytat':
				return b.text && (
					<blockquote class="svc-b svc-quote">
						<p>„{b.text}”</p>
						{(b.author || b.role) && <footer><b>{b.author}</b>{b.role && <span> · {b.role}</span>}</footer>}
					</blockquote>
				);

			default:
				return null;
		}
	})}
</div>

<style is:global>
	.svc-blocks { --fg: var(--color-ink); --muted: rgb(10 6 48 / .62); --card: linear-gradient(160deg, rgba(255,255,255,.95), rgba(255,255,255,.7)); --line: rgb(10 6 48 / .1); }
	.svc-blocks--dark { --fg: var(--color-cloud); --muted: var(--color-sky-mist); --card: rgba(255,255,255,.055); --line: rgba(255,255,255,.12); }
	.svc-blocks { display: flex; flex-direction: column; gap: 2.25rem; margin-top: 2.5rem; color: var(--fg); }
	.svc-b { margin: 0; }
	.svc-b figcaption, .svc-slide-cap { margin-top: .6rem; font-size: 14px; color: var(--muted); text-align: center; }
	.svc-media { display: block; width: 100%; border-radius: 16px; border: 1px solid var(--line); object-fit: cover; }
	.svc-narrow { max-width: 560px; margin-inline: auto; width: 100%; }
	.svc-vertical { max-width: 340px; margin-inline: auto; width: 100%; }
	.svc-text { font-size: 17px; line-height: 1.7; color: var(--muted); }
	.svc-text h2 { color: var(--fg); font-size: 28px; font-weight: 700; margin: 0 0 .75rem; letter-spacing: -.02em; }
	.svc-text h3 { color: var(--fg); font-size: 21px; font-weight: 700; margin: 1.25rem 0 .5rem; }
	.svc-text p { margin-bottom: 1rem; } .svc-text p:last-child { margin-bottom: 0; }
	.svc-text ul { list-style: disc; margin: 0 0 1rem 1.25rem; } .svc-text li { margin-bottom: .35rem; }
	.svc-text strong { color: var(--fg); } .svc-text a { color: var(--color-orange); text-decoration: underline; }

	/* karuzela */
	.svc-track { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 16px; }
	.svc-track::-webkit-scrollbar { display: none; }
	.svc-slide { flex: 0 0 100%; scroll-snap-align: center; }
	.svc-slide .svc-media { aspect-ratio: 16 / 10; }
	.svc-car-nav { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .9rem; font-size: 14px; color: var(--muted); }
	.svc-car-nav button { width: 40px; height: 40px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--fg); font-weight: 700; transition: border-color .2s, transform .2s; }
	.svc-car-nav button:hover { border-color: var(--color-orange); transform: translateY(-1px); }

	/* youtube (ładowany dopiero po kliknięciu — szybka strona) */
	.svc-yt { position: relative; display: block; overflow: hidden; padding: 0; cursor: pointer; background: #000; }
	.svc-yt img { width: 100%; height: 100%; object-fit: cover; opacity: .85; transition: opacity .3s, transform .5s; }
	.svc-yt:hover img { opacity: 1; transform: scale(1.03); }
	.svc-play { position: absolute; inset: 0; margin: auto; width: 72px; height: 72px; border-radius: 999px; background: var(--color-orange); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(237,36,78,.5); transition: transform .25s; }
	.svc-play svg { width: 30px; height: 30px; margin-left: 4px; }
	.svc-yt:hover .svc-play { transform: scale(1.08); }
	.svc-yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

	/* wykresy */
	.svc-stat { border-radius: 22px; border: 1px solid var(--line); background: var(--card); padding: 1.75rem; backdrop-filter: blur(14px); box-shadow: 0 14px 40px -18px rgba(10,6,48,.3); will-change: transform; }
	.svc-stat-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
	.svc-stat-num { font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 8vw, 64px); line-height: 1; color: var(--color-orange); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
	.svc-stat-label { font-size: 18px; font-weight: 700; color: var(--fg); }
	.svc-stat-desc { margin-top: .5rem; font-size: 15px; color: var(--muted); line-height: 1.6; }
	.svc-line { display: block; width: 100%; height: auto; margin-top: 1.25rem; overflow: visible; }
	.svc-grid { stroke: var(--line); stroke-dasharray: 3 5; }
	.svc-stroke { fill: none; stroke: var(--color-orange); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.6s cubic-bezier(.65,0,.35,1); }
	.svc-area { opacity: 0; transition: opacity 1s .9s; }
	.svc-end { fill: var(--color-orange); opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0); transition: opacity .3s 1.5s, transform .5s 1.5s cubic-bezier(.3,1.6,.5,1); filter: drop-shadow(0 0 6px rgba(237,36,78,.8)); }
	.is-in .svc-stroke { stroke-dashoffset: 0; } .is-in .svc-area { opacity: 1; } .is-in .svc-end { opacity: 1; transform: scale(1); }

	.svc-stat--ring { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
	.svc-ring { position: relative; width: 168px; height: 168px; flex-shrink: 0; display: grid; place-items: center; }
	.svc-ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }
	.svc-ring .svc-stat-num { font-size: 40px; }
	.svc-ring-track { fill: none; stroke: var(--line); stroke-width: 9; }
	.svc-ring-val { fill: none; stroke: var(--color-orange); stroke-width: 9; stroke-linecap: round; stroke-dasharray: var(--v) 100; stroke-dashoffset: var(--v); transition: stroke-dashoffset 1.6s cubic-bezier(.65,0,.35,1); filter: drop-shadow(0 0 6px rgba(237,36,78,.45)); }
	.is-in .svc-ring-val { stroke-dashoffset: 0; }

	.svc-quote { border-left: 3px solid var(--color-orange); padding: .25rem 0 .25rem 1.5rem; }
	.svc-quote p { font-size: 22px; line-height: 1.5; font-weight: 600; color: var(--fg); letter-spacing: -.01em; }
	.svc-quote footer { margin-top: .75rem; font-size: 15px; color: var(--muted); }
	.svc-quote footer b { color: var(--fg); }

	@media (prefers-reduced-motion: reduce) {
		.svc-stroke, .svc-ring-val { stroke-dashoffset: 0 !important; transition: none; }
		.svc-area, .svc-end { opacity: 1; transform: none; transition: none; }
	}
</style>

<script>
	import '../../scripts/parallax.ts';

	document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const f = document.createElement('iframe');
			f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
			f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			f.allowFullscreen = true;
			f.title = btn.getAttribute('aria-label') || 'Wideo';
			btn.innerHTML = '';
			btn.appendChild(f);
		}, { once: true });
	});

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
		const track = c.querySelector<HTMLElement>('.svc-track')!;
		const pos = c.querySelector<HTMLElement>('[data-pos]');
		const n = track.children.length;
		const idx = () => Math.round(track.scrollLeft / track.clientWidth);
		c.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
			b.addEventListener('click', () => {
				const i = (idx() + parseInt(b.dataset.dir || '1') + n) % n;
				track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
			}),
		);
		track.addEventListener('scroll', () => { if (pos) pos.textContent = `${idx() + 1} / ${n}`; }, { passive: true });
	});
</script>
