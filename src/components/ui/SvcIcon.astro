---
/*
 * Monochromatyczne, animowane ikony liniowe (kolor = currentColor).
 * Rysują się przy wejściu w ekran (.is-in), potem mają spokojny ruch w pętli.
 */
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
	class:list={['svc-ico svc-anim', `ico-${name}`, cls]} aria-hidden="true">
	{name === 'montaz' && (<>
		<rect pathLength="1" x="5" y="14" width="16" height="9" rx="2" />
		<rect pathLength="1" x="23" y="14" width="20" height="9" rx="2" />
		<rect pathLength="1" x="5" y="27" width="24" height="7" rx="2" opacity=".55" />
		<line pathLength="1" x1="5" y1="40" x2="43" y2="40" opacity=".35" />
		<g class="loop playhead"><line pathLength="1" x1="17" y1="9" x2="17" y2="40" /><path pathLength="1" d="M14.5 9h5l-2.5 3z" /></g>
	</>)}
	{name === 'motion' && (<>
		<path pathLength="1" d="M6 36 C 16 36, 16 12, 26 12 S 36 30, 42 14" />
		<circle pathLength="1" cx="6" cy="36" r="2" />
		<circle pathLength="1" cx="42" cy="14" r="2" />
		<circle r="3" class="loop dot" fill="currentColor" stroke="none">
			<animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;.5;1" calcMode="spline" keySplines=".45 0 .55 1;.45 0 .55 1" path="M6 36 C 16 36, 16 12, 26 12 S 36 30, 42 14" />
		</circle>
	</>)}
	{name === 'rolki' && (<>
		<rect pathLength="1" x="15" y="5" width="18" height="38" rx="4" />
		<line pathLength="1" x1="21" y1="9" x2="27" y2="9" opacity=".5" />
		<path pathLength="1" class="loop pulse" d="M21 19.5v9l7.5-4.5z" />
		<line pathLength="1" x1="19" y1="37" x2="29" y2="37" opacity=".5" />
	</>)}
	{name === 'grafika' && (<>
		<rect pathLength="1" x="6" y="8" width="36" height="32" rx="3" />
		<path pathLength="1" d="M6 33l10-10 8 8 6-6 12 12" />
		<circle pathLength="1" class="loop bob" cx="32" cy="17" r="3.5" />
	</>)}
	{name === 'transmisja' && (<>
		<rect pathLength="1" x="5" y="9" width="38" height="25" rx="3" />
		<path pathLength="1" d="M18 41h12M24 34v7" />
		<g class="loop bar"><rect pathLength="1" x="9" y="25" width="18" height="5" rx="1.5" /><line pathLength="1" x1="9" y1="25" x2="9" y2="30" stroke-width="2.6" /></g>
		<circle class="loop rec" cx="37" cy="14" r="1.8" fill="currentColor" stroke="none" />
	</>)}
	{name === 'dzwiek' && (<>
		{[10, 16, 22, 28, 34, 40].map((x, i) => (
			<line pathLength="1" class="loop wave" style={`--i:${i}`} x1={x} y1="16" x2={x} y2="32" />
		))}
	</>)}
	{name === 'kamera' && (<>
		<rect pathLength="1" x="5" y="14" width="27" height="20" rx="3" />
		<path pathLength="1" d="M32 21l10-6v18l-10-6z" />
		<circle class="loop rec" cx="11" cy="20" r="1.8" fill="currentColor" stroke="none" />
	</>)}
	{name === 'strategia' && (<>
		<circle pathLength="1" cx="24" cy="24" r="17" />
		<circle pathLength="1" cx="24" cy="24" r="10" opacity=".6" />
		<circle class="loop pulse" cx="24" cy="24" r="3" fill="currentColor" stroke="none" />
	</>)}
</svg>
<style is:global>
	.svc-ico { width: 100%; height: 100%; overflow: visible; }
	.svc-ico :is(path, rect, circle, line) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.3s cubic-bezier(.65,0,.35,1); }
	.svc-ico.is-in :is(path, rect, circle, line) { stroke-dashoffset: 0; }
	.svc-ico .loop { transform-box: fill-box; transform-origin: center; }
	.svc-ico.is-in .playhead { animation: ico-playhead 3.6s 1.2s ease-in-out infinite; }
	.svc-ico.is-in .pulse { animation: ico-pulse 2.2s 1.2s ease-in-out infinite; }
	.svc-ico.is-in .bob { animation: ico-bob 3s 1.2s ease-in-out infinite; }
	.svc-ico.is-in .bar { animation: ico-bar 4s 1.2s cubic-bezier(.7,0,.3,1) infinite; }
	.svc-ico.is-in .rec { animation: ico-rec 1.6s 1.2s steps(2, jump-none) infinite; }
	.svc-ico.is-in .wave { transform-origin: center; animation: ico-wave 1.4s calc(1.2s + var(--i) * .12s) ease-in-out infinite; }
	.svc-ico .dot { opacity: 0; transition: opacity .4s 1.2s; }
	.svc-ico.is-in .dot { opacity: 1; }
	/* hover na karcie przyspiesza ruch */
	.group:hover .svc-ico .loop { animation-duration: 1s; }
	@keyframes ico-playhead { 0%,100% { transform: translateX(0); } 50% { transform: translateX(18px); } }
	@keyframes ico-pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(.82); opacity: .6; } }
	@keyframes ico-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
	@keyframes ico-bar { 0%,15% { transform: translateX(-24px); opacity: 0; } 30%,80% { transform: translateX(0); opacity: 1; } 95%,100% { transform: translateX(-24px); opacity: 0; } }
	@keyframes ico-rec { 0% { opacity: 1; } 100% { opacity: .15; } }
	@keyframes ico-wave { 0%,100% { transform: scaleY(.35); } 50% { transform: scaleY(1); } }
	@media (prefers-reduced-motion: reduce) {
		.svc-ico :is(path, rect, circle, line) { stroke-dashoffset: 0; transition: none; }
		.svc-ico .loop { animation: none !important; }
	}
</style>
<script>
	import '../../scripts/parallax.ts';
</script>
