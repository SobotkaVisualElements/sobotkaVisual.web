---
/*
 * Zielony przycisk „Sprawdź ofertę” → generator z gotowo ustawioną ofertą.
 * Komputer: cząsteczki lecące do góry + błyskawice wokół krawędzi (zapętlone).
 * Telefon / „ogranicz ruch” / słabsze urządzenie: wersja lite — sam puls i błysk światła.
 */
interface Props { href: string; label?: string; lead?: string; note?: string; align?: string }
const { href, label = 'Sprawdź ofertę', lead, note, align = 'srodek' } = Astro.props;
const fid = 'obz' + Math.random().toString(36).slice(2, 8);
const parts = Array.from({ length: 16 }, (_, i) => ({ x: (i * 37 + 11) % 100, d: 1.6 + ((i * 7) % 10) / 6, del: -((i * 13) % 20) / 10, s: 3 + (i % 3) }));
---
<div class:list={['ob-wrap', `ob-${align}`]}>
	{lead && <p class="ob-lead">{lead}</p>}
	<a href={href} class="ob">
		<span class="ob-glow" aria-hidden="true"></span>
		<span class="ob-fx" aria-hidden="true">
			{parts.map((p) => <i style={`left:${p.x}%;--d:${p.d}s;--del:${p.del}s;--s:${p.s}px`}></i>)}
			<svg class="ob-zap" aria-hidden="true"><defs><filter id={`${fid}`} x="-30%" y="-80%" width="160%" height="260%"><feGaussianBlur in="SourceAlpha" stdDeviation="1.6" result="b1" /><feGaussianBlur in="SourceAlpha" stdDeviation="6" result="b2" /><feFlood flood-color="#7cf3ff" result="c" /><feComposite in="c" in2="b1" operator="in" result="g1" /><feComposite in="c" in2="b2" operator="in" result="g2" /><feMerge><feMergeNode in="g2" /><feMergeNode in="g2" /><feMergeNode in="g1" /><feMergeNode in="SourceGraphic" /></feMerge></filter></defs><g class="ob-zap-core" filter={`url(#${fid})`}></g></svg>
		</span>
		<span class="ob-shine" aria-hidden="true"></span>
		<span class="ob-label">{label}</span>
		<span class="ob-arrow" aria-hidden="true">→</span>
	</a>
	{note && <p class="ob-note">{note}</p>}
</div>

<style is:global>
	.ob-wrap { margin: 2.6rem 0; display: flex; flex-direction: column; gap: .8rem; }
	.ob-srodek { align-items: center; text-align: center; } .ob-lewo { align-items: flex-start; }
	.ob-lead { font-size: 17px; font-weight: 600; color: inherit; text-wrap: balance; }
	.ob-note { font-size: 13px; opacity: .65; text-wrap: balance; }
	.ob { position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: .9rem; padding: 1.05rem 1.3rem 1.05rem 2rem; border-radius: 999px;
		background: linear-gradient(135deg, #4cf5ad, #18c477 55%, #0ea463); color: #03261a; font-weight: 900; font-size: 17px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none !important;
		box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 36px -10px rgba(24,196,119,.75); transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s; animation: ob-pulse 2.6s ease-in-out infinite; }
	.ob:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 0 0 1px rgba(255,255,255,.5) inset, 0 20px 50px -10px rgba(24,196,119,.95); }
	.ob-label { position: relative; z-index: 2; }
	.ob-arrow { position: relative; z-index: 2; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px; background: #03261a; color: #4cf5ad; font-size: 18px; transition: transform .25s; }
	.ob:hover .ob-arrow { transform: translateX(3px); }
	.ob-glow { position: absolute; inset: -10px; z-index: -1; border-radius: inherit; background: radial-gradient(closest-side, rgba(46,229,157,.55), transparent); filter: blur(10px); opacity: .7; }
	.ob-shine { position: absolute; inset: 0; z-index: 1; border-radius: inherit; overflow: hidden; pointer-events: none; }
	.ob-shine::before { content: ''; position: absolute; top: 0; bottom: 0; width: 40%; left: -60%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); animation: ob-shine 3.2s ease-in-out infinite; }
	.ob-fx { display: none; position: absolute; inset: 0; pointer-events: none; z-index: 0; }
	@keyframes ob-pulse { 0%,100% { box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 36px -10px rgba(24,196,119,.75); } 50% { box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 46px -6px rgba(24,196,119,1); } }
	@keyframes ob-shine { 0%,55% { left: -60%; } 85%,100% { left: 130%; } }

	/* pełna wersja: komputer z myszką, bez „ogranicz ruch” */
	@media (hover: hover) and (min-width: 768px) and (prefers-reduced-motion: no-preference) {
		.ob-fx { display: block; }
		.ob-fx i { position: absolute; bottom: 30%; width: var(--s); height: var(--s); border-radius: 50%; background: #b6ffdc; box-shadow: 0 0 8px #4cf5ad; opacity: 0;
			animation: ob-rise var(--d) var(--del) linear infinite; }
		@keyframes ob-rise { 0% { transform: translateY(0) scale(1); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-74px) scale(.4); opacity: 0; } }
		/* błyskawice: rysowane klatka po klatce (12 kl./s jak efekty 2D) i krążące po obrysie przycisku */
		.ob-zap { position: absolute; left: -26px; top: -26px; width: calc(100% + 52px); height: calc(100% + 52px); overflow: visible; }
				.ob-zap-core path { fill: #f4feff; }
		/* pulsujący pierścień wokół przycisku */
		.ob::after { content: ''; position: absolute; inset: -7px; border-radius: inherit; border: 3px solid rgba(24,196,119,.55); pointer-events: none; animation: ob-ring 1.8s ease-out infinite; }
		@keyframes ob-ring { 0% { transform: scale(.96); opacity: .9; } 100% { transform: scale(1.12, 1.35); opacity: 0; } }
	}
	@media (prefers-reduced-motion: reduce) { .ob, .ob-shine::before { animation: none; } }
	html.ob-lite .ob-fx { display: none !important; }
</style>
<script>
	/*
	 * Piorun jak z After Effects (Trim Paths + Wiggle Paths + Roughen Edges + Glow):
	 *  - nieregularna ścieżka przez cały przycisk (co przejście inna),
	 *  - widoczny odcinek płynie od lewej do prawej z łagodnym startem i hamowaniem (Easy Ease), 60 klatek = 2,5 s przy 24 kl./s,
	 *  - kształt drga „komiksowo”: wiggle zmienia się co 2 klatki (Posterize Time), brzegi postrzępione, końce zwężone,
	 *  - cieńsze odgałęzienie biegnie po tej samej ścieżce, całość ma podwójną cyjanową poświatę.
	 * Tylko pełna wersja: komputer, bez „ogranicz ruch”, dobre łącze.
	 */
	const full = matchMedia('(hover: hover) and (min-width: 768px) and (prefers-reduced-motion: no-preference)');
	const PAD = 26, NS = 'http://www.w3.org/2000/svg', FPS = 24, ANIM = 60, GAP = 8;
	const hash = (n: number) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
	const noise = (x: number, seed: number) => { const i = Math.floor(x), f = x - i, u = f * f * (3 - 2 * f); return (hash(i + seed * 57) * (1 - u) + hash(i + 1 + seed * 57) * u) * 2 - 1; };
	const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
	document.querySelectorAll<HTMLAnchorElement>('.ob').forEach((btn) => {
		const svg = btn.querySelector<SVGSVGElement>('.ob-zap');
		if (!svg) return;
		const core = svg.querySelector('.ob-zap-core')!;
		let W = 0, H = 0, run = false, frame = -1, cycle = 0;
		let base: { x: number; y: number }[] = [];
		const size = () => { W = btn.offsetWidth; H = btn.offsetHeight; };
		// nowa nieregularna ścieżka bazowa (jak narysowana Piórem) — przez cały przycisk
		const newBase = () => {
			const k = 6, ctrl = Array.from({ length: k }, (_, i) => ({ x: -18 + (W + 36) * (i / (k - 1)) + (i && i < k - 1 ? (Math.random() - 0.5) * 18 : 0), y: H * (0.5 + (Math.random() - 0.5) * 0.85) }));
			base = [];
			for (let i = 0; i < k - 1; i++) {
				const p0 = ctrl[Math.max(0, i - 1)], p1 = ctrl[i], p2 = ctrl[i + 1], p3 = ctrl[Math.min(k - 1, i + 2)];
				for (let j = 0; j < 24; j++) {
					const t = j / 24, t2 = t * t, t3 = t2 * t;
					base.push({ x: 0.5 * (2 * p1.x + (-p0.x + p2.x) * t + (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 + (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
						y: 0.5 * (2 * p1.y + (-p0.y + p2.y) * t + (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 + (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3) });
				}
			}
			base.push(ctrl[k - 1]);
		};
		const sample = (u: number) => {
			const f = Math.min(base.length - 1.001, Math.max(0, u * (base.length - 1))), i = Math.floor(f), r = f - i;
			const a = base[i], b = base[i + 1];
			const dx = b.x - a.x, dy = b.y - a.y, l = Math.hypot(dx, dy) || 1;
			return { x: a.x + dx * r, y: a.y + dy * r, nx: -dy / l, ny: dx / l };
		};
		// pas o zmiennej grubości: wiggle (szum płynny) + postrzępienie (szum ostry) + zwężone końce
		const ribbon = (u0: number, u1: number, amp: number, wMax: number, seed: number, step: number) => {
			if (u1 - u0 < 0.01) return '';
			const n = Math.max(6, Math.round((u1 - u0) * 70)), top: string[] = [], bot: string[] = [];
			for (let i = 0; i <= n; i++) {
				const k = i / n, u = u0 + (u1 - u0) * k, p = sample(u);
				const off = (noise(u * 9 + step * 0.9, seed) * amp + noise(u * 34 + step * 1.7, seed + 9) * amp * 0.45) * (i === 0 || i === n ? 0.3 : 1);
				const w = Math.pow(Math.sin(Math.PI * k), 0.6) * wMax * (0.45 + hash(i * 13.1 + step * 7.7 + seed) * 0.95);
				const cx = p.x + p.nx * off + PAD, cy = p.y + p.ny * off + PAD;
				top.push(`${(cx + p.nx * w).toFixed(1)},${(cy + p.ny * w).toFixed(1)}`);
				bot.unshift(`${(cx - p.nx * w).toFixed(1)},${(cy - p.ny * w).toFixed(1)}`);
			}
			return `M${top.join(' L')} L${bot.join(' L')} Z`;
		};
		const draw = () => {
			const f = frame % (ANIM + GAP);
			let d = '';
			if (f < ANIM) {
				const t = f / ANIM;
				const head = ease(Math.min(1, t * 1.35)), tail = ease(Math.max(0, t * 1.35 - 0.35));
				const step = Math.floor(f / 2); // Posterize Time: drgania co 2 klatki = 12 kl./s, kreska „rysowana”
				d += ribbon(tail, head, 7, 3.4, cycle * 3, step);
				const mid = (tail + head) / 2, half = (head - tail) * 0.32;
				d += ribbon(mid - half, mid + half, 11, 1.3, cycle * 3 + 1, step); // cieńsze odgałęzienie po tej samej ścieżce
				if (hash(step + cycle) > 0.55) d += ribbon(tail + (head - tail) * 0.15, tail + (head - tail) * 0.55, 13, 0.9, cycle * 3 + 2, step);
			}
			core.innerHTML = '';
			if (!d) return;
			const p = document.createElementNS(NS, 'path'); p.setAttribute('d', d); core.appendChild(p);
		};
		// zegar 24 kl./s liczony z czasu (nie z liczby odświeżeń ekranu) — 60 klatek trwa zawsze 2,5 s
		let t0 = 0, cycleSeen = -1;
		const loop = () => {
			if (!run) return;
			const now = performance.now();
			if (!t0) t0 = now;
			const F = Math.floor(((now - t0) / 1000) * FPS);
			if (F !== frame) {
				frame = F;
				const c = Math.floor(F / (ANIM + GAP));
				if (c !== cycleSeen) { cycleSeen = c; cycle++; newBase(); }
				draw();
			}
			requestAnimationFrame(loop);
		};
		const start = () => { if (run || !full.matches || document.documentElement.classList.contains('ob-lite')) return; size(); newBase(); t0 = 0; frame = -1; cycleSeen = -1; run = true; requestAnimationFrame(loop); };
		new IntersectionObserver(([e]) => { if (e.isIntersecting) start(); else run = false; }).observe(btn);
		addEventListener('resize', () => { size(); newBase(); }, { passive: true });
	});

	// wolne łącze albo tryb oszczędzania danych → wersja lite (bez cząsteczek i błyskawic)
	const c = (navigator as any).connection;
	if (c && (c.saveData || /(^|-)2g|3g/.test(c.effectiveType || ''))) document.documentElement.classList.add('ob-lite');
</script>
