---
/*
 * Zielony przycisk „Sprawdź ofertę” → generator z gotowo ustawioną ofertą.
 * Komputer: cząsteczki lecące do góry + błyskawice wokół krawędzi (zapętlone).
 * Telefon / „ogranicz ruch” / słabsze urządzenie: wersja lite — sam puls i błysk światła.
 */
interface Props { href: string; label?: string; lead?: string; note?: string; align?: string }
const { href, label = 'Sprawdź ofertę', lead, note, align = 'srodek' } = Astro.props;
const parts = Array.from({ length: 16 }, (_, i) => ({ x: (i * 37 + 11) % 100, d: 1.6 + ((i * 7) % 10) / 6, del: -((i * 13) % 20) / 10, s: 3 + (i % 3) }));
const bolts = [
	{ c: 'top:-14px;left:12%', r: 0 }, { c: 'top:-16px;right:18%', r: 180 }, { c: 'bottom:-14px;left:28%', r: 180 },
	{ c: 'bottom:-15px;right:9%', r: 0 }, { c: 'top:30%;left:-22px', r: 90 }, { c: 'top:22%;right:-24px', r: -90 },
];
---
<div class:list={['ob-wrap', `ob-${align}`]}>
	{lead && <p class="ob-lead">{lead}</p>}
	<a href={href} class="ob">
		<span class="ob-glow" aria-hidden="true"></span>
		<span class="ob-fx" aria-hidden="true">
			{parts.map((p) => <i style={`left:${p.x}%;--d:${p.d}s;--del:${p.del}s;--s:${p.s}px`}></i>)}
			{bolts.map((b, i) => (
				<svg class="ob-bolt" style={`${b.c};--r:${b.r}deg;--k:${i}`} viewBox="0 0 44 18"><path d="M1 9 L9 4 L14 12 L21 3 L27 13 L33 6 L43 9" /></svg>
			))}
		</span>
		<span class="ob-shine" aria-hidden="true"></span>
		<span class="ob-label">{label}</span>
		<span class="ob-arrow" aria-hidden="true">→</span>
	</a>
	{note && <p class="ob-note">{note}</p>}
</div>

<style is:global>
	.ob-wrap { margin: 2.6rem 0; display: flex; flex-direction: column; gap: .8rem; }
	.ob-srodek { align-items: center; text-align: center; } .ob-lewo { align-items: flex-start; }
	.ob-lead { font-size: 17px; font-weight: 600; color: inherit; text-wrap: balance; }
	.ob-note { font-size: 13px; opacity: .65; text-wrap: balance; }
	.ob { position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: .9rem; padding: 1.05rem 1.3rem 1.05rem 2rem; border-radius: 999px;
		background: linear-gradient(135deg, #4cf5ad, #18c477 55%, #0ea463); color: #03261a; font-weight: 900; font-size: 17px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none !important;
		box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 36px -10px rgba(24,196,119,.75); transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s; animation: ob-pulse 2.6s ease-in-out infinite; }
	.ob:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 0 0 1px rgba(255,255,255,.5) inset, 0 20px 50px -10px rgba(24,196,119,.95); }
	.ob-label { position: relative; z-index: 2; }
	.ob-arrow { position: relative; z-index: 2; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px; background: #03261a; color: #4cf5ad; font-size: 18px; transition: transform .25s; }
	.ob:hover .ob-arrow { transform: translateX(3px); }
	.ob-glow { position: absolute; inset: -10px; z-index: -1; border-radius: inherit; background: radial-gradient(closest-side, rgba(46,229,157,.55), transparent); filter: blur(10px); opacity: .7; }
	.ob-shine { position: absolute; inset: 0; z-index: 1; border-radius: inherit; overflow: hidden; pointer-events: none; }
	.ob-shine::before { content: ''; position: absolute; top: 0; bottom: 0; width: 40%; left: -60%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); animation: ob-shine 3.2s ease-in-out infinite; }
	.ob-fx { display: none; position: absolute; inset: 0; pointer-events: none; z-index: 0; }
	@keyframes ob-pulse { 0%,100% { box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 36px -10px rgba(24,196,119,.75); } 50% { box-shadow: 0 0 0 1px rgba(255,255,255,.35) inset, 0 14px 46px -6px rgba(24,196,119,1); } }
	@keyframes ob-shine { 0%,55% { left: -60%; } 85%,100% { left: 130%; } }

	/* pełna wersja: komputer z myszką, bez „ogranicz ruch” */
	@media (hover: hover) and (min-width: 768px) and (prefers-reduced-motion: no-preference) {
		.ob-fx { display: block; }
		.ob-fx i { position: absolute; bottom: 30%; width: var(--s); height: var(--s); border-radius: 50%; background: #b6ffdc; box-shadow: 0 0 8px #4cf5ad; opacity: 0;
			animation: ob-rise var(--d) var(--del) linear infinite; }
		@keyframes ob-rise { 0% { transform: translateY(0) scale(1); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-74px) scale(.4); opacity: 0; } }
		.ob-bolt { position: absolute; width: 44px; height: 18px; overflow: visible; transform: rotate(var(--r)); opacity: 0; animation: ob-zap 2.4s calc(var(--k) * .37s) steps(1, end) infinite; }
		.ob-bolt path { fill: none; stroke: #c9ffe6; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 0 4px #4cf5ad) drop-shadow(0 0 8px #18c477); }
		@keyframes ob-zap { 0%, 100% { opacity: 0; } 4% { opacity: 1; } 7% { opacity: .2; } 10% { opacity: 1; } 16% { opacity: 0; } }
	}
	@media (prefers-reduced-motion: reduce) { .ob, .ob-shine::before { animation: none; } }
	html.ob-lite .ob-fx { display: none !important; }
</style>
<script>
	// wolne łącze albo tryb oszczędzania danych → wersja lite (bez cząsteczek i błyskawic)
	const c = (navigator as any).connection;
	if (c && (c.saveData || /(^|-)2g|3g/.test(c.effectiveType || ''))) document.documentElement.classList.add('ob-lite');
</script>
