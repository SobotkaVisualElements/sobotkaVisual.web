---
/*
 * „Umów 15 minut rozmowy” — link do kalendarza rezerwacji (Cal.com, Calendly, Google Kalendarz).
 * Adres wpisujesz w panelu: Strona główna → Rezerwacja rozmowy. Bez adresu pokazuje telefon i mail.
 */
import home from '../../data/home.json';
interface Props { tone?: 'dark' | 'light'; align?: 'center' | 'left' }
const { tone = 'dark', align = 'center' } = Astro.props;
const b: any = { label: 'Umów 15 minut rozmowy', note: 'Bez zobowiązań. Wybierasz termin, który Ci pasuje.', ...((home as any).booking ?? {}) };
---
<div class:list={['bk', `bk--${tone}`, `bk--${align}`]}>
	{b.url ? (
		<a href={b.url} target="_blank" rel="noopener" class="bk-btn btn-saber">
			<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="3" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
			{b.label}
		</a>
	) : (
		<a href="tel:+48668472759" class="bk-btn btn-saber">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6 6l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" /></svg>
			Zadzwoń: 668 472 759
		</a>
	)}
	<span class="bk-note">{b.url ? b.note : 'albo napisz: kontakt@sobotkavisual.pl'}</span>
</div>
<style is:global>
	.bk { display: flex; flex-direction: column; gap: .55rem; }
	.bk--center { align-items: center; text-align: center; } .bk--left { align-items: flex-start; }
	.bk-btn { display: inline-flex; align-items: center; gap: .6rem; padding: 1rem 1.6rem; border-radius: 999px; font-weight: 800; background: #fff; color: var(--color-navy-deep, #0a0630); transition: transform .2s; }
	.bk-btn:hover { transform: translateY(-2px); }
	.bk-btn svg { width: 20px; height: 20px; fill: none; stroke: var(--color-orange, #ed244e); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.bk-note { font-size: 13px; opacity: .7; }
	.bk--light .bk-btn { background: var(--color-orange, #ed244e); color: #fff; }
	.bk--light .bk-btn svg { stroke: #fff; }
</style>
