---
import { getImage } from 'astro:assets';
import type { Project } from '../../lib/projects';
import { slugify } from '../../lib/posts';
import LayerTile from '../ui/LayerTile.astro';

interface Props {
	project: Project;
	index?: number;
}

const { project } = Astro.props;
const d: any = project.data;
const { title, description, category, tech, year } = d;

// kolejność: warstwy z panelu → okładka z panelu → stara miniatura z repo
let layers = (d.layers ?? []).filter((l: any) => l?.image);
if (!layers.length && d.cover) layers = [{ image: d.cover, depth: 20, scale: 112 }];
if (!layers.length && d.thumbnail) {
	const img = await getImage({ src: d.thumbnail, width: 1200 });
	layers = [{ image: img.src, depth: 20, scale: 112 }];
}
---

<article class="liquid-card liquid-light group relative flex flex-col overflow-hidden rounded-[22px] p-3.5" data-category={slugify(category)}>
	<div class="overflow-hidden rounded-[14px]">
		<LayerTile layers={layers} strength={d.parallaxStrength ?? 100} focalX={d.coverFocalX} focalY={d.coverFocalY} alt={title} placeholder="light" />
	</div>

	<div class="flex flex-1 flex-col px-3 pt-5 pb-3">
		<div class="flex items-center gap-2 text-[12px] font-bold tracking-[0.1em] text-orange-deep uppercase">
			<span>{category}</span>
			<span class="text-ink/25" aria-hidden="true">·</span>
			<span class="text-ink/45">{year}</span>
		</div>

		<h3 class="mt-2 text-[21px] leading-tight font-bold tracking-[-0.02em] text-ink">
			<a href={`/work/${project.id}`} class="after:absolute after:inset-0 after:z-10">{title}</a>
		</h3>

		<p class="mt-2.5 text-[15px] leading-relaxed text-ink/65">{description}</p>

		{tech.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-1.5">
				{tech.slice(0, 4).map((t: string) => (
					<span class="rounded-full border border-ink/10 bg-white/70 px-2.5 py-0.5 text-xs font-semibold text-ink/70">{t}</span>
				))}
			</div>
		)}
		<span class="mt-auto pt-5 text-sm font-bold text-orange transition-transform group-hover:translate-x-1">Zobacz case study →</span>
	</div>
</article>
