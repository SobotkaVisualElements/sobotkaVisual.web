<script>
	import '../../scripts/parallax.ts';
	// wydajność: ikony poza ekranem zatrzymują wszystkie animacje (CSS i SVG) — słabsze komputery nie liczą tego, czego nie widać
	if (!(window as any).__isoPause) {
		(window as any).__isoPause = true;
		const io = new IntersectionObserver((es) => es.forEach((e) => {
			const svg = e.target as SVGSVGElement;
			svg.classList.toggle('is-paused', !e.isIntersecting);
			try { e.isIntersecting ? svg.unpauseAnimations() : svg.pauseAnimations(); } catch {}
		}), { rootMargin: '120px' });
		const watch = () => document.querySelectorAll<SVGSVGElement>('svg.iso:not([data-iso-w])').forEach((el) => { el.dataset.isoW = '1'; io.observe(el); });
		watch(); addEventListener('load', watch);
	}
</script>
