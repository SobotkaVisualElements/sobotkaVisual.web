	@keyframes iso-snow { 0% { transform: translateY(-46px); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(10px); opacity: 0; } }
	.iso-twinkle { animation: iso-twk 1.6s calc(var(--k) * .23s) ease-in-out infinite; }
	@keyframes iso-twk { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
	.iso-topstar { transform-box: fill-box; transform-origin: center; animation: iso-tstar 3s ease-in-out infinite; }
