	@keyframes iso-halo { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(1.45); opacity: 0; } }
	.iso-sig { fill: none; stroke: #7a24c9; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: iso-sign 4s ease-in-out infinite; }
