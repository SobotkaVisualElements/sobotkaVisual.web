---
/*
 * Ikony izometryczne (neon: granat, fiolet, magenta, cyjan, pomarańcz).
 * Każda stoi na świecącej platformie. mode="draw": przy wejściu w ekran platforma się rysuje,
 * obiekt wjeżdża z dołu, potem działa pętla (płomień, słupki, skan hologramu, cząsteczki).
 * mode="static": bez wejścia (np. w szybko przelatujących kartach), pętle działają.
 */
interface Props { name: string; mode?: 'draw' | 'static'; class?: string; style?: string; platform?: boolean; pal?: 'neon' | 'site' }
const { name, mode = 'draw', class: cls = '', style, platform = true } = Astro.props;
// ikony świąteczne domyślnie w kolorach strony (granat + róż), reszta w neonie
const XM = ['choinka', 'prezent', 'bombka', 'dzwonek', 'gwiazda', 'sanie', 'czapka', 'kalendarz-xii'];
const pal = Astro.props.pal ?? (XM.includes(name) ? 'site' : 'neon');
const u = 'i' + Math.random().toString(36).slice(2, 8);
const g = (id: string) => `url(#${u}-${id})`;

// rzut izometryczny: (x, y, z) → ekran; środek platformy w (100, 128)
const P = (x: number, y: number, z: number) => [100 + (x - y) * 0.866, 128 + (x + y) * 0.5 - z];
const pts = (...a: number[][]) => a.map((p) => p.map((n) => n.toFixed(1)).join(',')).join(' ');
const box = (x: number, y: number, z: number, w: number, d: number, h: number) => ({
	top: pts(P(x, y, z + h), P(x + w, y, z + h), P(x + w, y + d, z + h), P(x, y + d, z + h)),
	left: pts(P(x, y + d, z), P(x + w, y + d, z), P(x + w, y + d, z + h), P(x, y + d, z + h)),
	right: pts(P(x + w, y, z), P(x + w, y + d, z), P(x + w, y + d, z + h), P(x + w, y, z + h)),
	edge: 'M' + pts(P(x, y, z + h), P(x + w, y, z + h), P(x + w, y + d, z + h), P(x, y + d, z + h)) + 'Z',
});
const plat = box(-42, -42, 0, 84, 84, 9);
const c = P(0, 0, 9); // środek wierzchu platformy
// słupki
const bars = [22, 38, 54, 74].map((h, i) => ({ b: box(-36 + i * 19, -8, 9, 14, 14, h), i }));
// monitor: cienki ekran z tyłu platformy
const mon = box(-36, -22, 9, 72, 6, 60);
const onScreen = (x: number, z: number) => P(x, -22 + 6, z); // punkt na przedniej ścianie ekranu
const chart = [[-28, 30], [-14, 42], [-2, 36], [12, 54], [26, 48]].map(([x, z]) => onScreen(x, z + 9));
const chartD = 'M' + chart.map((p) => p.map((n) => n.toFixed(1)).join(' ')).join(' L');
// płynący wykres: wzór powtarzany co 24 jednostki, przesuwany o jeden okres (bez szwu)
const WAVE = [[0, 0], [5, 7], [10, 3], [15, 12], [20, 5], [24, 0]];
const wavePts: number[][] = [];
for (let o = -72; o <= 48; o += 24) WAVE.forEach(([x, z], j) => { if (o > -72 && j === 0) return; wavePts.push(onScreen(o + x, 38 + z)); });
const waveD = 'M' + wavePts.map((p) => p.map((n) => n.toFixed(1)).join(' ')).join(' L');
const waveFill = waveD + ` L${onScreen(72, 10).map((n) => n.toFixed(1)).join(' ')} L${onScreen(-72, 10).map((n) => n.toFixed(1)).join(' ')} Z`;
// kamera
const cam = box(-30, -18, 9, 50, 32, 34);
const lensC = P(20, -2, 26);
// telefon
const ph = box(-18, -5, 9, 36, 7, 70);
const phFace = (x: number, z: number) => P(x, 2, z);
// kalendarz
const cal = box(-34, -14, 9, 66, 8, 58);
const calFace = (x: number, z: number) => P(x, -6, z);
// tablet (leży płasko, lekko uniesiony)
const tab = box(-36, -28, 12, 72, 54, 5);
// gwiazdka 5-ramienna
const star = (cx: number, cy: number, R: number, r: number, sx = 1) => 'M' + Array.from({ length: 10 }, (_, i) => {
	const a = -Math.PI / 2 + (i * Math.PI) / 5, q = i % 2 ? r : R;
	return `${(cx + Math.cos(a) * q * sx).toFixed(1)} ${(cy + Math.sin(a) * q).toFixed(1)}`;
}).join(' L') + ' Z';
// choinka: trzy stożki (dół = połówka elipsy w proporcji izometrycznej)
const cone = (r: number, yb: number, ya: number) => ({
	f: `M${c[0] - r} ${yb} A${r} ${(r * 0.58).toFixed(1)} 0 0 0 ${c[0] + r} ${yb} L${c[0]} ${ya} Z`,
	s: `M${c[0] + 2} ${(yb + r * 0.58).toFixed(1)} A${r} ${(r * 0.58).toFixed(1)} 0 0 0 ${c[0] + r} ${yb} L${c[0]} ${ya} Z`,
});
const tiers = [cone(36, c[1] - 16, c[1] - 62), cone(28, c[1] - 44, c[1] - 84), cone(20, c[1] - 68, c[1] - 102)];
const lights = [[-22, -22], [8, -18], [26, -26], [-14, -50], [14, -48], [-6, -74], [10, -76], [-26, -30], [20, -56]].map(([dx, dy], k) => [c[0] + dx, c[1] + dy, k]);
const LC = ['#ffc65c', '#ff5a78', '#8ff4ff'];
// prezent
const gift = box(-25, -25, 9, 50, 50, 34);
const lid = box(-28, -28, 43, 56, 56, 9);
const ribL = box(-4, -25.2, 9, 8, 50.4, 34.2), ribR = box(-25.2, -4, 9, 50.4, 8, 34.2);
const lidRibL = box(-4, -28.2, 43, 8, 56.4, 9.2), lidRibR = box(-28.2, -4, 43, 56.4, 8, 9.2);
const bowC = P(0, 0, 52);
// sanie
const sl = box(-30, -13, 18, 50, 26, 16);
const runner = (y: number) => `M${P(-36, y, 10).map(fx1).join(' ')} L${P(22, y, 10).map(fx1).join(' ')} C${P(34, y, 10).map(fx1).join(' ')} ${P(36, y, 22).map(fx1).join(' ')} ${P(28, y, 30).map(fx1).join(' ')}`;
const fx1 = (n: number) => n.toFixed(1);
const slGift = box(-22, -9, 34, 20, 18, 16);
// kalendarz grudniowy: tekst na przedniej ścianie (skos jak ściana izometryczna)
const calM = (x: number, z: number) => { const q = calFace(x, z); return `matrix(0.866 0.5 0 1 ${q[0].toFixed(1)} ${q[1].toFixed(1)})`; };
// żarówka: kopuła + szyjka z eliptycznym dołem
const bulbD = `M${c[0] - 12} ${c[1] - 21} C${c[0] - 12} ${c[1] - 36} ${c[0] - 27} ${c[1] - 44} ${c[0] - 27} ${c[1] - 62} A27 27 0 1 1 ${c[0] + 27} ${c[1] - 62} C${c[0] + 27} ${c[1] - 44} ${c[0] + 12} ${c[1] - 36} ${c[0] + 12} ${c[1] - 21} A12 6.9 0 0 1 ${c[0] - 12} ${c[1] - 21} Z`;
// tablet: podpis rysowany piórkiem (piórko jedzie po tej samej ścieżce)
const sigD = `M${P(-24, -22, 17)[0].toFixed(1)} ${P(-24, -22, 17)[1].toFixed(1)} C${P(-2, -26, 17)[0].toFixed(1)} ${P(-2, -26, 17)[1].toFixed(1)} ${P(-26, 0, 17)[0].toFixed(1)} ${P(-26, 0, 17)[1].toFixed(1)} ${P(-4, 2, 17)[0].toFixed(1)} ${P(-4, 2, 17)[1].toFixed(1)} S${P(10, 18, 17)[0].toFixed(1)} ${P(10, 18, 17)[1].toFixed(1)} ${P(24, 12, 17)[0].toFixed(1)} ${P(24, 12, 17)[1].toFixed(1)}`;
---
<svg viewBox="0 0 200 200" class:list={['iso', `iso-${mode}`, mode === 'draw' && 'svc-anim', `iso-n-${name}`, cls]} style={style} aria-hidden="true">
	<defs>
		<linearGradient id={`${u}-pt`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d4dff" /><stop offset="1" stop-color="#4a2fc9" /></linearGradient>
		<linearGradient id={`${u}-pl`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a2399" /><stop offset="1" stop-color="#26166e" /></linearGradient>
		<linearGradient id={`${u}-pr`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b1979" /><stop offset="1" stop-color="#1a0f52" /></linearGradient>
		<linearGradient id={`${u}-mag`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff7ad9" /><stop offset="1" stop-color="#b03cff" /></linearGradient>
		<linearGradient id={`${u}-magD`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c94bd6" /><stop offset="1" stop-color="#7a24c9" /></linearGradient>
		<linearGradient id={`${u}-magR`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9b36c4" /><stop offset="1" stop-color="#5a1a9e" /></linearGradient>
		<linearGradient id={`${u}-cy`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8ff4ff" /><stop offset="1" stop-color="#2aa8ff" /></linearGradient>
		<linearGradient id={`${u}-fire`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3b0" /><stop offset=".45" stop-color="#ffb21e" /><stop offset="1" stop-color="#ff4f6d" stop-opacity="0" /></linearGradient>
		<linearGradient id={`${u}-scr`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd1ee" /><stop offset="1" stop-color="#f39bd6" /></linearGradient>
		<linearGradient id={`${u}-holo`} x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#d06bff" stop-opacity=".75" /><stop offset="1" stop-color="#d06bff" stop-opacity="0" /></linearGradient>
		<radialGradient id={`${u}-glow`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#3ee6ff" stop-opacity=".55" /><stop offset="1" stop-color="#3ee6ff" stop-opacity="0" /></radialGradient>
		<linearGradient id={`${u}-spt`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2e2780" /><stop offset="1" stop-color="#1c1660" /></linearGradient>
		<linearGradient id={`${u}-spl`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1a1450" /><stop offset="1" stop-color="#110c3a" /></linearGradient>
		<linearGradient id={`${u}-spr`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#140f42" /><stop offset="1" stop-color="#0b0730" /></linearGradient>
		<linearGradient id={`${u}-tree`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3fe0a0" /><stop offset="1" stop-color="#0f8a63" /></linearGradient>
		<linearGradient id={`${u}-red`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff6d8a" /><stop offset="1" stop-color="#d81e48" /></linearGradient>
		<linearGradient id={`${u}-redD`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c41a40" /><stop offset="1" stop-color="#8a0f2e" /></linearGradient>
		<linearGradient id={`${u}-gold`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff0b8" /><stop offset=".5" stop-color="#ffc65c" /><stop offset="1" stop-color="#d98b1c" /></linearGradient>
		<radialGradient id={`${u}-baub`} cx=".35" cy=".3" r=".75"><stop offset="0" stop-color="#ffb3c4" /><stop offset=".45" stop-color="#ff4f74" /><stop offset="1" stop-color="#8a0f2e" /></radialGradient>
		<radialGradient id={`${u}-glowG`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffc65c" stop-opacity=".5" /><stop offset="1" stop-color="#ffc65c" stop-opacity="0" /></radialGradient>
		<radialGradient id={`${u}-glowM`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ff5fd2" stop-opacity=".5" /><stop offset="1" stop-color="#ff5fd2" stop-opacity="0" /></radialGradient>
	</defs>

	{platform && (
		<g class="iso-plat">
			<ellipse cx="100" cy="150" rx="88" ry="40" fill={g(pal === 'site' ? (name === 'gwiazda' || name === 'dzwonek' ? 'glowG' : 'glowM') : name === 'rakieta' || name === 'zarowka' ? 'glow' : 'glowM')} class="iso-pulse" />
			<polygon points={plat.left} fill={g(pal === 'site' ? 'spl' : 'pl')} />
			<polygon points={plat.right} fill={g(pal === 'site' ? 'spr' : 'pr')} />
			<polygon points={plat.top} fill={g(pal === 'site' ? 'spt' : 'pt')} />
			<path d={plat.edge} pathLength="1" class:list={['iso-edge', pal === 'site' && 'is-site']} />
			{pal === 'site' && (
				<g class="iso-snowcap" aria-hidden="true">
					{[[-30, 30, 12], [26, -32, 9], [34, 22, 7], [-34, -10, 6]].map(([x, y, r]) => { const q = P(x, y, 9); return <ellipse cx={q[0]} cy={q[1]} rx={r} ry={r * 0.5} fill="#fff" opacity=".9" />; })}
				</g>
			)}
		</g>
	)}

	<g class="iso-obj">
		{name === 'rakieta' && (<>
			<g class="iso-smoke">
				{[[-26, 4, 13], [24, 2, 12], [-12, 10, 15], [12, 11, 14], [0, 6, 17]].map(([dx, dy, r]) => <circle cx={c[0] + dx} cy={c[1] + dy - 6} r={r} fill={g('cy')} opacity=".85" />)}
			</g>
			<g class="iso-rocket">
				<path class="iso-flame" d={`M${c[0] - 8} ${c[1] - 21} Q${c[0]} ${c[1] + 26} ${c[0] + 8} ${c[1] - 21} Z`} fill={g('fire')} />
				{/* lotki wygięte zgodnie z perspektywą: dolna krawędź biegnie po elipsie korpusu */}
				<path d={`M${c[0] - 11} ${c[1] - 64} C${c[0] - 24} ${c[1] - 54} ${c[0] - 30} ${c[1] - 40} ${c[0] - 28} ${c[1] - 20} C${c[0] - 22} ${c[1] - 15} ${c[0] - 14} ${c[1] - 19} ${c[0] - 8} ${c[1] - 27} Z`} fill={g('magD')} />
				<path d={`M${c[0] + 11} ${c[1] - 64} C${c[0] + 24} ${c[1] - 54} ${c[0] + 30} ${c[1] - 40} ${c[0] + 28} ${c[1] - 20} C${c[0] + 22} ${c[1] - 15} ${c[0] + 14} ${c[1] - 19} ${c[0] + 8} ${c[1] - 27} Z`} fill={g('magR')} />
				{/* dysza: walec z elipsą na dole */}
				<path d={`M${c[0] - 8} ${c[1] - 30} L${c[0] - 10} ${c[1] - 22} A10 4 0 0 0 ${c[0] + 10} ${c[1] - 22} L${c[0] + 8} ${c[1] - 30} Z`} fill="#3a2399" />
				<ellipse cx={c[0]} cy={c[1] - 22} rx="10" ry="4" fill="none" stroke="#ffb21e" stroke-width="2" />
				{/* korpus z zaokrąglonym (eliptycznym) dnem */}
				<path d={`M${c[0]} ${c[1] - 118} C${c[0] + 22} ${c[1] - 96} ${c[0] + 16} ${c[1] - 52} ${c[0] + 12} ${c[1] - 31} A12 5 0 0 1 ${c[0] - 12} ${c[1] - 31} C${c[0] - 16} ${c[1] - 52} ${c[0] - 22} ${c[1] - 96} ${c[0]} ${c[1] - 118} Z`} fill={g('mag')} />
				<path d={`M${c[0]} ${c[1] - 118} C${c[0] + 22} ${c[1] - 96} ${c[0] + 16} ${c[1] - 52} ${c[0] + 12} ${c[1] - 31} A12 5 0 0 1 ${c[0]} ${c[1] - 26} Z`} fill="#000" opacity=".18" />
				<path d={`M${c[0] - 15} ${c[1] - 70} A15 6 0 0 0 ${c[0] + 15} ${c[1] - 70}`} fill="none" stroke="#ffd1f3" stroke-width="1.6" opacity=".55" />
				<path d={`M${c[0] - 1} ${c[1] - 52} L${c[0] + 3} ${c[1] - 52} L${c[0] + 4} ${c[1] - 18} Q${c[0] + 1} ${c[1] - 14} ${c[0] - 2} ${c[1] - 18} Z`} fill="#7a24c9" />
				<circle cx={c[0]} cy={c[1] - 86} r="8" fill={g('cy')} stroke="#fff" stroke-width="2" />
			</g>
			<g class="iso-stream">{[-14, -4, 6, 16].map((dx, i) => <line x1={c[0] + dx} y1={c[1] - 130} x2={c[0] + dx} y2={c[1] - 150} style={`--k:${i}`} />)}</g>
		</>)}

		{name === 'wykres' && (<>
			{bars.map(({ b, i }) => (
				<g class="iso-bar" style={`--k:${i}`}>
					<g class="iso-barl" style={`--k:${i}`}><polygon points={b.left} fill={g('magD')} /><polygon points={b.right} fill={g('magR')} /><polygon points={b.top} fill="#ffb3ea" /></g>
				</g>
			))}
			{bars.map(({ i }) => { const t = P(-29 + i * 19, -1, 9 + [22, 38, 54, 74][i] + 10); return (
				<path class="iso-up" style={`--k:${i}`} d={`M${t[0] - 4} ${t[1] + 3} L${t[0]} ${t[1] - 2} L${t[0] + 4} ${t[1] + 3}`} />
			); })}
			<path class="iso-trend" pathLength="1" d={`M${P(-30, 0, 44)[0]} ${P(-30, 0, 44)[1]} L${P(-11, 0, 60)[0]} ${P(-11, 0, 60)[1]} L${P(8, 0, 76)[0]} ${P(8, 0, 76)[1]} L${P(27, 0, 98)[0]} ${P(27, 0, 98)[1]}`} />
			<path class="iso-arrow" d={`M${P(27, 0, 98)[0] - 7} ${P(27, 0, 98)[1] + 1} L${P(27, 0, 98)[0] + 1} ${P(27, 0, 98)[1] - 4} L${P(27, 0, 98)[0]} ${P(27, 0, 98)[1] + 5}`} />
		</>)}

		{name === 'monitor' && (<>
			<polygon points={mon.left} fill={g('scr')} /><polygon points={mon.right} fill="#c96fb8" /><polygon points={mon.top} fill="#ffe3f5" />
			<clipPath id={`${u}-scr-c`}><polygon points={pts(onScreen(-32, 15), onScreen(32, 15), onScreen(32, 66), onScreen(-32, 66))} /></clipPath>
			<g clip-path={`url(#${u}-scr-c)`} class="iso-wavebox">
				<path class="iso-wave" d={waveD} />
				<path class="iso-wavefill" d={waveFill} />
			</g>
			{[0, 1, 2].map((k) => { const a = onScreen(-28 + k * 20, 20), b2 = onScreen(-16 + k * 20, 20); return <line x1={a[0]} y1={a[1]} x2={b2[0]} y2={b2[1]} class="iso-line" style={`--k:${k}`} />; })}
		</>)}

		{name === 'kamera' && (<>
			<g class="iso-cam">
				<polygon points={cam.left} fill={g('magD')} /><polygon points={cam.right} fill={g('magR')} /><polygon points={cam.top} fill={g('mag')} />
				<ellipse cx={lensC[0] + 6} cy={lensC[1] + 2} rx="15" ry="17" fill="#1a0f52" stroke={g('cy')} stroke-width="3" />
				<ellipse cx={lensC[0] + 6} cy={lensC[1] + 2} rx="11.5" ry="13" class="iso-ring" pathLength="1" />
				<ellipse cx={lensC[0] + 6} cy={lensC[1] + 2} rx="7" ry="8" fill={g('cy')} class="iso-lens" />
				<circle cx={lensC[0] + 3} cy={lensC[1] - 2} r="2" fill="#fff" opacity=".8" />
				<circle cx={P(-22, -10, 45)[0]} cy={P(-22, -10, 45)[1]} r="4" fill="#ff4f6d" class="iso-rec" />
			</g>
		</>)}

		{name === 'telefon' && (<>
			<polygon points={ph.left} fill="#1b1150" /><polygon points={ph.right} fill="#2a1873" /><polygon points={ph.top} fill="#3a2399" />
			<polygon points={pts(phFace(-14, 15), phFace(14, 15), phFace(14, 74), phFace(-14, 74))} fill={g('cy')} opacity=".9" />
			<path d={`M${phFace(-5, 36)[0]} ${phFace(-5, 36)[1]} L${phFace(-5, 52)[0]} ${phFace(-5, 52)[1]} L${phFace(8, 44)[0]} ${phFace(8, 44)[1]} Z`} fill="#fff" class="iso-play" />
			<g class="iso-likes">{[0, 1, 2, 3].map((k) => <path style={`--k:${k}`} transform={`translate(${124 + (k % 2) * 9} ${84 - k * 2}) scale(${.5 + (k % 2) * .15})`} d="M0 4 C0 -2 8 -2 8 4 C8 -2 16 -2 16 4 C16 10 8 14 8 16 C8 14 0 10 0 4 Z" fill="#ff5fd2" />)}</g>
		</>)}

		{name === 'moneta' && (<>
			{/* podstawa: walec — elipsy w proporcji rzutu izometrycznego (ry ≈ 0,58 rx) */}
			<path d={`M${c[0] - 30} ${c[1] - 10} L${c[0] - 30} ${c[1] - 2} A30 17.3 0 0 0 ${c[0] + 30} ${c[1] - 2} L${c[0] + 30} ${c[1] - 10} Z`} fill="#3a2399" />
			<ellipse cx={c[0]} cy={c[1] - 10} rx="30" ry="17.3" fill="#6d4dff" />
			<ellipse cx={c[0]} cy={c[1] - 10} rx="22" ry="12.7" fill="#8a6bff" stroke="#8ff4ff" stroke-width="1.4" />
			<path d={`M${c[0] + 22} ${c[1] - 10} L${c[0] + 34} ${c[1] - 92} L${c[0] - 34} ${c[1] - 92} L${c[0] - 22} ${c[1] - 10} A22 12.7 0 0 0 ${c[0] + 22} ${c[1] - 10} Z`} fill={g('holo')} class="iso-holo" />
			<g class="iso-coin">
				<ellipse cx={c[0]} cy={c[1] - 62} rx="24" ry="24" fill="none" stroke="#ff9be6" stroke-width="3" />
