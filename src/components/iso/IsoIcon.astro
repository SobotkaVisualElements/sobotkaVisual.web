	.iso-draw.is-in .iso-bar { transform: none; }
	.iso-barl { transform-box: fill-box; transform-origin: bottom; animation: iso-grow 3.2s calc(2s + var(--k) * .25s) ease-in-out infinite; }
	@keyframes iso-grow { 0%,100% { transform: scaleY(1); } 45% { transform: scaleY(.78); } 70% { transform: scaleY(1.06); } }
	.iso-up { fill: none; stroke: #8ff4ff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; animation: iso-upa 3.2s calc(2s + var(--k) * .25s) ease-out infinite; }
	@keyframes iso-upa { 0%,55% { opacity: 0; transform: translateY(6px); } 72% { opacity: 1; } 100% { opacity: 0; transform: translateY(-16px); } }
	.iso-wave { fill: none; stroke: #7a24c9; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; animation: iso-flow 2.4s linear infinite; }
