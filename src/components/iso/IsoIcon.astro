	<g class:list={['iso-parts', pal === 'site' && 'is-snow', pal === 'hall' && 'is-ember']}>{[[38, 60], [160, 52], [150, 96], [52, 100]].map(([x, y], k) => <circle cx={x} cy={y} r="1.8" style={`--k:${k}`} />)}</g>
</svg>

<style is:global>
	.iso { overflow: visible; }
