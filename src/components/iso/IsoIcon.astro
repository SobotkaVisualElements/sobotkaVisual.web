	@keyframes iso-thrust { 0%,100% { opacity: .75; } 50% { opacity: 1; } }
	.iso-n-rakieta .iso-smoke { transform-box: fill-box; transform-origin: center bottom; animation: iso-smk 2.8s cubic-bezier(.45,0,.55,1) infinite; }
	@keyframes iso-smk { 0%,100% { transform: scale(1.08); } 50% { transform: scale(.9); opacity: .8; } }
	@keyframes iso-hover { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
	.iso-flame { transform-box: fill-box; transform-origin: top; animation: iso-flame .18s ease-in-out infinite alternate; }
	@keyframes iso-flame { to { transform: scaleY(1.18) scaleX(.9); } }
