	.iso-holo { animation: iso-holo 2.4s ease-in-out infinite; }
	@keyframes iso-holo { 0%,100% { opacity: .65; } 50% { opacity: 1; } }
	.iso-coin { transform-box: fill-box; transform-origin: center; animation: iso-spin 4s ease-in-out infinite; }
	@keyframes iso-spin { 0%,100% { transform: scaleX(1); } 50% { transform: scaleX(.35); } }
	.iso-scan { fill: none; transform-box: fill-box; transform-origin: center; stroke: #8ff4ff; stroke-width: 1.6; animation: iso-scan 2.4s ease-in-out infinite; }
	@keyframes iso-scan { 0%,100% { transform: translateY(0) scale(1); opacity: .2; } 50% { transform: translateY(-62px) scale(1.4, 1.2); opacity: 1; } }
	
	/* świąteczne */
	.iso-edge.is-site { stroke: #ff5a78; }
