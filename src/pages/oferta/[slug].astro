---
/*
 * Landingi ofert: /oferta/dzial-wideo, /oferta/kampania-wideo, /oferta/kanal-youtube
 * Treść: src/data/offers.ts (z PDF „Propozycja współpracy”). Opinie: src/data/opinie.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import CompareBars from '../../components/ui/CompareBars.astro';
import Stars from '../../components/ui/Stars.astro';
import Blocks from '../../components/blocks/Blocks.astro';
import { offers, type Offer } from '../../data/offers';
import { opinie } from '../../data/opinie';
import { getPublishedProjects } from '../../lib/projects';
import home from '../../data/home.json';

export function getStaticPaths() {
	return offers.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}
const { o } = Astro.props as { o: Offer };
const site = 'https://sobotkavisual.pl';
const url = `${site}/oferta/${o.slug}`;
const gen = `/generator?pakiet=${o.pkg}&utm_source=oferta&utm_campaign=${o.slug}`;
const clients = ((home as any).clients ?? []).filter((c: any) => c.logo);
const projects = (await getPublishedProjects()).filter((p) => p.data.featured).slice(0, 3);
const thumbs = ['/uploads/realizacje/maxresdefault (1).jpg', '/uploads/realizacje/maxresdefault (3).jpg', '/uploads/realizacje/maxresdefault.jpg'];
const others = offers.filter((x) => x.slug !== o.slug);
const names: Record<string, string> = { 'dzial-wideo': 'Dział wideo (Pakiet PRO)', 'kampania-wideo': 'Kampania wideo', 'kanal-youtube': 'Kanał na YouTube' };

// Realne wyniki — dane z YouTube Studio klienta i pomocy YouTube (tło porównania)
const ctrBars = [
	{ label: 'Typowy CTR na YouTube (połowa kanałów)', value: 10, range: [2, 10] as [number, number], note: 'zakres podawany przez YouTube' },
	{ label: 'Kanał Przemysława Langiera · 1. godzina', value: 21, highlight: true },
	{ label: 'Kanał Przemysława Langiera · 2.–3. godzina', value: 15, highlight: true },
	{ label: 'Kanał Przemysława Langiera · później', value: 9, display: 'ok. 9%' },
];
const ctrSource = 'YouTube Help „Wyświetlenia i CTR” (zakres 2–10%); YouTube Studio kanału klienta.';

const deltaBlocks = [{
	type: 'wykres_liniowy', value: 150, prefix: '', suffix: '+', label: 'rolek rekrutacyjnych dla Delta HR w 12 miesięcy',
	points: '0, 13, 26, 39, 52, 65, 78, 91, 104, 117, 130, 143, 156',
	description: '3 rolki tygodniowo, bez przerw — od października 2025 do października 2026. Pojedyncze rolki regularnie przekraczały 60 tys. wyświetleń na Facebooku.',
}];

const ld = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Service', '@id': `${url}#usluga`, name: o.service, serviceType: o.service, url,
			description: o.seoDesc,
			provider: { '@id': `${site}/#firma` },
			areaServed: [{ '@type': 'AdministrativeArea', name: 'województwo opolskie' }, { '@type': 'Country', name: 'Polska' }],
			offers: o.invest.cards.map((c) => ({ '@type': 'Offer', name: c.name, priceCurrency: 'PLN', price: c.price.replace(/[^\d]/g, ''), description: c.note })),
		},
		{
			'@type': 'FAQPage', '@id': `${url}#faq`,
			mainEntity: o.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site}/` },
				{ '@type': 'ListItem', position: 2, name: 'Oferta', item: `${site}/#oferta` },
				{ '@type': 'ListItem', position: 3, name: names[o.slug], item: url },
			],
		},
	],
};
---
<BaseLayout title={o.seoTitle} description={o.seoDesc}>
	<div class="of">
		<!-- 01 HERO -->
		<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
			{o.slug !== 'kanal-youtube' && (
				<video class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover opacity-20 md:block" autoplay muted loop playsinline preload="metadata">
					<source src="/uploads/Reklama WEB.mp4" />
				</video>
			)}
			<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
			<span data-speed="0.06" class="pointer-events-none absolute -top-24 -right-20 size-[640px] bg-radial from-orange/35 to-transparent to-62%"></span>
			<div class="relative z-2 mx-auto grid max-w-[1200px] items-center gap-12 px-6 pt-24 pb-20 sm:px-8 lg:grid-cols-[1.2fr_1fr]">
				<div>
					<div class="flex flex-wrap items-center gap-3 text-[12px] font-bold tracking-[0.14em] uppercase">
						<span class="text-orange-glow">{o.eyebrow}</span>
					</div>
					<h1 class="of-h mt-6 text-[52px] leading-[0.98] md:text-[84px]">
						<span class="block font-light">{o.title[0]}</span>
						{o.title[1] && <span class="block font-extrabold">{o.title[1]}</span>}
					</h1>
					<p class="mt-7 max-w-[560px] text-[19px] leading-[1.55] text-sky">{o.lead}</p>
					<div class="mt-9 flex flex-wrap gap-3.5">
						<a href="#inwestycja" class="btn-saber rounded-full bg-orange px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Zobacz inwestycję →</a>
						<a href={o.pdf} download class="btn-saber rounded-full border-2 border-cloud/60 px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Pobierz PDF</a>
					</div>
					<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3 text-[13px] text-sky-mist">
						<span class="of-chip">🇵🇱 Polska firma · Opole</span>
						<span class="of-chip">NO AI — każdą klatkę układa człowiek</span>
					</div>
				</div>

				{o.slug === 'kanal-youtube' ? (
					<div data-layers data-strength="120" class="relative mx-auto aspect-[4/3.4] w-full max-w-[520px]">
						{thumbs.map((t, i) => (
							<img src={t} alt={i === 0 ? 'Miniatury kanału Przemysława Langiera' : ''} data-depth={[18, 40, 65][i]} data-scale="100"
								class:list={['absolute w-[78%] rounded-2xl border border-white/15 shadow-[0_30px_60px_-20px_rgba(0,0,0,.7)]',
									['top-0 left-0 rotate-[-4deg]', 'top-[26%] right-0 rotate-[3deg]', 'bottom-0 left-[8%] rotate-[-1deg]'][i]]} />
						))}
						<div class="absolute -bottom-6 -left-3 z-10 rounded-2xl border border-white/15 bg-navy-deep/90 px-5 py-4 shadow-[0_20px_40px_-10px_rgba(0,0,0,.7)] backdrop-blur-md" data-depth="80" data-scale="100">
							<div class="text-[12px] font-bold tracking-wide text-sky-mist uppercase">CTR miniatur · 1. godzina</div>
							<div class="font-display text-[34px] leading-none font-extrabold text-orange-bright">21%</div>
						</div>
					</div>
				) : (
					<div class="glass liquid-card relative rounded-[26px] p-7 sm:p-8">
						<div class="flex items-center justify-between">
							<span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase">{o.invest.cards.find((c) => c.featured)?.name}</span>
							<Stars size={16} />
						</div>
						<div class="mt-4 flex items-baseline gap-2">
							<span class="font-display text-[52px] leading-none font-bold">{o.invest.cards.find((c) => c.featured)?.price}</span>
							<span class="text-sky-mist">{o.invest.cards.find((c) => c.featured)?.per}</span>
						</div>
						<ul class="mt-6 flex flex-col gap-2.5 text-[15px] text-sky">
							{o.invest.cards.find((c) => c.featured)?.items.slice(0, 5).map((it) => <li class="flex gap-2.5"><span class="text-orange-bright">✓</span>{it}</li>)}
						</ul>
						<p class="mt-6 border-t border-white/10 pt-5 text-[15px] leading-relaxed text-cloud">„{opinie[0].short}”</p>
						<p class="mt-2 text-[13px] text-sky-mist">{opinie[0].name} · {opinie[0].role}</p>
					</div>
				)}
			</div>

			{clients.length > 0 && (
				<div class="relative z-2 mx-auto max-w-[1200px] px-6 pb-14 sm:px-8">
					<p class="mb-5 text-center text-[12px] font-bold tracking-[0.14em] text-white/50 uppercase">Zaufali nam</p>
					<div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-5">
						{clients.map((c: any) => <img src={c.logo} alt={c.name} style={`height:${c.height ?? 28}px`} class="w-auto opacity-70 transition-opacity hover:opacity-100" loading="lazy" />)}
					</div>
				</div>
			)}
		</section>

		<!-- 02 ZANIM ZACZNIEMY -->
		<section class="of-sec">
			<div class="of-wrap grid gap-10 md:grid-cols-[1fr_1.1fr] md:items-end">
				<div>
					<p class="of-eyebrow">Zanim zaczniemy</p>
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">{o.intro.title[0]} <span class="of-light">{o.intro.title[1]}</span></h2>
				</div>
				<div class="flex flex-col gap-4 text-[17px] leading-relaxed text-sky-mist">
					{o.intro.paras.map((p) => <p>{p}</p>)}
					<p class="mt-2 text-[15px] text-cloud"><b>Krzysztof Sobotka</b> <span class="text-sky-mist">· Sobotka Visual Creations · Opole</span></p>
				</div>
			</div>
		</section>

		<!-- 03 KIM SIĘ STAJESZ -->
		<section class="of-sec">
			<div class="of-wrap">
				<p class="of-eyebrow">Kim się stajesz</p>
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">{o.become.title[0]} <span class="of-light">{o.become.title[1]}</span></h2>
				<p class="mt-4 max-w-[620px] text-[17px] text-sky-mist">{o.become.lead}</p>
				<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{o.become.items.map((it, i) => (
						<div class="liquid-card glass rounded-2xl p-6">
							<span class="font-display text-[13px] font-bold text-orange-glow">0{i + 1}</span>
							<h3 class="mt-3 text-[19px] font-bold text-cloud">{it.t}</h3>
							<p class="mt-2 text-[14.5px] leading-relaxed text-sky-mist">{it.d}</p>
						</div>
					))}
				</div>
				<p class="mt-8 text-[18px] text-cloud">{o.become.punch}</p>
			</div>
		</section>

		<!-- 04 LICZBY RYNKU -->
		<section class="of-sec">
			<div class="of-wrap">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<div>
						<p class="of-eyebrow">Liczby, które grają na Ciebie</p>
						<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">{o.stats.title[0]} <span class="of-light">{o.stats.title[1]}</span></h2>
					</div>
					<p class="max-w-[280px] text-[13px] text-sky-mist">To dane o rynku, nie obietnice wyników. Pokazują, gdzie zapadają decyzje Twoich klientów.</p>
				</div>
				<div class="svc-anim mt-12 grid gap-8 border-t border-white/10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
					{o.stats.items.map((s) => (
						<div data-float="18">
							<div class="font-display text-[64px] leading-none font-light tracking-[-0.04em] text-cloud">
								<span data-count={s.v} data-suffix="">0</span><span class="text-[26px] text-orange-glow">{s.suf}</span>
							</div>
							<p class="mt-3 text-[14.5px] leading-relaxed text-sky-mist">{s.d}</p>
							<p class="mt-2 text-[11px] text-slate-500">{s.src}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 05 WYNIKI — realne wzrosty na tle porównania -->
		<section class="of-sec relative overflow-hidden">
			<span class="pointer-events-none absolute top-1/3 -left-40 size-[560px] bg-radial from-orange/20 to-transparent to-65%"></span>
			<div class="of-wrap relative">
				<p class="of-eyebrow">Wyniki, nie obietnice</p>
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">Nasze liczby <span class="of-light">na tle reszty.</span></h2>
				<p class="mt-4 max-w-[640px] text-[16px] text-sky-mist">Wyniki z realnych realizacji, ze statystyk klientów. Tło porównania pochodzi z publicznych danych — bez naciągania.</p>

				<div class="mt-10 grid gap-6 lg:grid-cols-2">
					<CompareBars title="Klikalność miniatur (CTR)" sub="Ile osób, którym YouTube pokazał miniaturę, kliknęło w film." unit="%" bars={ctrBars} max={24} source={ctrSource} />

					{o.slug === 'dzial-wideo' && (
						<CompareBars title="Pół roku w liczbach: START vs PRO" sub="Ile materiałów dostajesz w 6 miesięcy (minimalny okres współpracy)." bars={[
							{ label: 'Materiały wideo · START', value: 0, display: '0' },
							{ label: 'Materiały wideo · PRO', value: 24, highlight: true },
							{ label: 'Rolki i krótkie formy · START', value: 36 },
							{ label: 'Rolki i krótkie formy · PRO', value: 48, highlight: true },
							{ label: 'Nowe elementy animowane · START', value: 6 },
							{ label: 'Nowe elementy animowane · PRO', value: 18, highlight: true },
						]} max={52} source="cennik pakietów SVC 2026" />
					)}
					{o.slug === 'kampania-wideo' && (
						<CompareBars title="Ile razy klient zobaczy Twoją markę" sub="Liczba gotowych materiałów z jednej produkcji." bars={[
							{ label: 'Pojedynczy spot reklamowy', value: 1 },
							{ label: 'Kampania premierowa (klip + 12 rolek)', value: 13, highlight: true },
							{ label: 'Kampania w PRO · 6 miesięcy', value: 119, highlight: true, note: 'klip główny + 22 materiały wideo + 48 rolek + 48 grafik' },
						]} max={125} source="zakres ofert SVC 2026" />
					)}
					{o.slug === 'kanal-youtube' && (
						<CompareBars title="Pół roku produkcji kanału" sub="Co powstaje w 6 miesięcy pakietu PRO." bars={[
							{ label: 'Surowe nagranie bez montażu', value: 0, display: '0 dodatków' },
							{ label: 'Odcinki z pełnym montażem', value: 24, highlight: true },
							{ label: 'Shorty z odcinków', value: 48, highlight: true },
							{ label: 'Miniatury i grafiki', value: 48, highlight: true },
						]} max={52} source="zakres pakietu PRO" />
					)}
				</div>

				{o.slug === 'dzial-wideo' && (
					<div class="mt-6"><Blocks blocks={deltaBlocks} theme="dark" /></div>
				)}
			</div>
		</section>

		<!-- 06 CO W ŚRODKU -->
		<section class="of-sec">
			<div class="of-wrap">
				<p class="of-eyebrow">{o.inside.eyebrow}</p>
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">{o.inside.title[0]} <span class="of-light">{o.inside.title[1]}</span></h2>
				<p class="mt-4 max-w-[620px] text-[17px] text-sky-mist">{o.inside.lead}</p>

				{o.special === 'anatomia' ? (
					<div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1.3fr]">
						<div class="liquid-card glass flex flex-col justify-between rounded-[22px] p-7">
							<div>
								<span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase">Klip główny · 30–45 s · poziom i pion</span>
								<h3 class="of-h mt-4 text-[34px] leading-tight">Wizytówka, <span class="of-light">która sprzedaje.</span></h3>
								<p class="mt-3 text-[15px] text-sky-mist">Pokazuje, kim jesteś i co zmieniasz w życiu klienta. Pracuje na stronie, w reklamie płatnej, na targach i w prezentacji handlowej.</p>
							</div>
						</div>
						<div class="glass rounded-[22px] p-7">
							<span class="text-[12px] font-bold tracking-[0.12em] text-sky-mist uppercase">Seria rolek · przykładowe tematy</span>
							<ol class="mt-4 grid gap-x-6 sm:grid-cols-2">
								{o.inside.items.map((it) => (
									<li class="flex gap-3 border-b border-white/8 py-3"><span class="font-display text-[13px] font-bold text-orange-glow">{it.n}</span><span><b class="text-cloud">{it.t}</b> <span class="text-[14px] text-sky-mist">— {it.d}</span></span></li>
								))}
							</ol>
						</div>
					</div>
				) : (
					<div class:list={['mt-10 grid gap-5', o.inside.items.length === 3 ? 'lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-3']}>
						{o.inside.items.map((it) => (
							<div class="liquid-card glass flex gap-5 rounded-2xl p-6">
								<span class="font-display text-[48px] leading-none font-light text-orange-bright">{it.n}</span>
								<div>
									<h3 class="text-[18px] font-bold text-cloud">{it.t}</h3>
									<p class="mt-1.5 text-[14.5px] leading-relaxed text-sky-mist">{it.d}</p>
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		</section>

		<!-- 07 SEKCJA SPECJALNA -->
		{o.special === 'rytm' && (
			<section class="of-sec">
				<div class="of-wrap">
					<p class="of-eyebrow">Rytm miesiąca</p>
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">Regularność <span class="of-light">to podstawa.</span></h2>
					<p class="mt-4 max-w-[620px] text-[17px] text-sky-mist">Klienci nie pamiętają jednego świetnego posta sprzed kwartału. Pamiętają firmę, którą widzą regularnie.</p>
					<div class="glass svc-anim of-rytm mt-10 overflow-x-auto rounded-[22px] p-2 sm:p-4">
						<table class="w-full min-w-[560px] text-left text-[15px]">
							<thead><tr class="text-[12px] tracking-[0.12em] text-sky-mist uppercase"><th class="p-4 font-bold">Tydzień</th>{['01', '02', '03', '04'].map((w) => <th class="p-4 text-center font-display text-[20px] font-light text-cloud">{w}</th>)}</tr></thead>
							<tbody>
								{[['Materiał wideo', '×1', '×1', '×1', '×1'], ['Rolki', '×2', '×2', '×2', '×2'], ['Grafiki i miniatury', '×2', '×2', '×2', '×2'], ['Element animowany', '×1', '×1', '×1', '—'], ['Raport i plan', '—', '—', '—', '✓']].map((r, ri) => (
									<tr class="border-t border-white/8">
										<td class="p-4 font-semibold text-cloud">{r[0]}</td>
										{r.slice(1).map((c, ci) => <td class="p-4 text-center"><span class:list={['of-pill', c === '—' && 'is-empty']} style={`--d:${(ri * 4 + ci) * 0.05}s`}>{c}</span></td>)}
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="mt-4 text-[13px] text-slate-400">Rozkład przykładowy. Dokładny harmonogram ustalamy na początku miesiąca pod Wasze wydarzenia i premiery.</p>
				</div>
			</section>
		)}

		{o.special === 'anatomia' && (
			<section class="of-sec">
				<div class="of-wrap">
					<p class="of-eyebrow">Anatomia 45 sekund</p>
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]">Każda sekunda <span class="of-light">ma swoje zadanie.</span></h2>
					<p class="mt-4 max-w-[620px] text-[17px] text-sky-mist">Piękno bierze się z proporcji. W reklamie liczy się nie to, ile pokażesz, ale w jakiej kolejności.</p>
					<div class="svc-anim of-anat mt-12">
						<div class="flex h-14 gap-1.5">
							{[[3, 'Haczyk'], [9, 'Problem'], [20, 'Produkt w akcji'], [8, 'Dowód'], [5, 'Wezwanie']].map(([w, l], i) => (
								<div class="of-seg" style={`--g:${w};--d:${i * 0.18}s`} data-hl={i === 2 ? '1' : undefined}><span>{l}</span></div>
							))}
						</div>
						<div class="mt-2 flex justify-between text-[11px] text-slate-500 tabular-nums">{[0, 5, 10, 15, 20, 25, 30, 35, 40, 45].map((s) => <span>{s}s</span>)}</div>
						<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
							{[['0–3 s', 'Haczyk', 'Obraz albo zdanie, które zatrzymuje kciuk. Nie zaczynamy od logo — logo nikogo nie zatrzymuje.'], ['3–12 s', 'Problem', 'Sytuacja, w której klient rozpoznaje siebie. Dopiero wtedy zaczyna słuchać.'], ['12–32 s', 'Produkt w akcji', 'Nie lista cech, tylko zmiana: jak wygląda dzień z Twoim produktem.'], ['32–40 s', 'Dowód', 'Detal, liczba albo opinia — coś, co zamienia „ładne” w „wiarygodne”.'], ['40–45 s', 'Wezwanie', 'Jedno konkretne działanie. Jedno, nie pięć.']].map(([t, h, d]) => (
								<div><span class="text-[12px] font-bold text-orange-glow tabular-nums">{t}</span><h3 class="mt-1 text-[17px] font-bold text-cloud">{h}</h3><p class="mt-1.5 text-[14px] leading-relaxed text-sky-mist">{d}</p></div>
							))}
						</div>
					</div>
					<div class="mt-14 grid gap-5 md:grid-cols-4">
