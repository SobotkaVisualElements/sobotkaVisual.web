---
/*
 * Landingi ofert: /oferta/<adres>
 * Treść: src/data/oferty/<adres>.json — edytowana w panelu (/admin → Landingi ofert).
 * Każdy tekst przechodzi przez tx(): polskie twarde spacje, Enter = nowa linia, **pogrubienie**.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import CompareBars from '../../components/ui/CompareBars.astro';
import Stars from '../../components/ui/Stars.astro';
import Blocks from '../../components/blocks/Blocks.astro';
import { opinie } from '../../data/opinie';
import { getPublishedProjects } from '../../lib/projects';
import { tx, alignCls } from '../../lib/typo';
import home from '../../data/home.json';

export function getStaticPaths() {
	const files = import.meta.glob('../../data/oferty/*.json', { eager: true }) as Record<string, any>;
	return Object.entries(files)
		.filter(([, mod]) => !(mod.default ?? mod).draft)
		.map(([path]) => ({ params: { slug: path.split('/').pop()!.replace('.json', '') } }));
}

const files = import.meta.glob('../../data/oferty/*.json', { eager: true }) as Record<string, any>;
const all = Object.entries(files)
	.map(([path, mod]) => ({ slug: path.split('/').pop()!.replace('.json', ''), ...(mod.default ?? mod) }))
	.sort((a: any, b: any) => (a.order ?? 99) - (b.order ?? 99)) as any[];

const { slug } = Astro.params;
const o: any = all.find((x) => x.slug === slug);
const site = 'https://sobotkavisual.pl';
const url = `${site}/oferta/${slug}`;
const utm = `utm_source=oferta&utm_campaign=${slug}`;
const gen = `/generator?pakiet=${o.pkg || 'pro'}&${utm}`;
const withUtm = (h: string = '/generator') => `${h || '/generator'}${(h || '').includes('?') ? '&' : '?'}${utm}`;
const clients = ((home as any).clients ?? []).filter((c: any) => c.logo);
const projects = o.projects?.show === false ? [] : (await getPublishedProjects()).filter((p) => p.data.featured).slice(0, 3);
const thumbs = ['/uploads/realizacje/maxresdefault (1).jpg', '/uploads/realizacje/maxresdefault (3).jpg', '/uploads/realizacje/maxresdefault.jpg'];
const others = all.filter((x) => x.slug !== slug && !x.draft && !x.noindex);
const cards: any[] = o.invest?.cards ?? [];
const featured = cards.find((c) => c.featured) ?? cards[0];
const paras = (t: string = '') => String(t).split(/\n\s*\n/).filter((x) => x.trim());
const toBars = (bars: any[] = []) => bars.map((b) => ({
	...b, value: Number(b.value) || 0,
	range: b.from !== undefined && b.from !== null && b.from !== '' && b.to ? [Number(b.from), Number(b.to)] as [number, number] : undefined,
}));
const sp: any = o.special ?? {};

const deltaBlocks = [{
	type: 'wykres_liniowy', value: 150, prefix: '', suffix: '+', label: 'rolek rekrutacyjnych dla Delta HR w 12 miesięcy',
	points: '0, 13, 26, 39, 52, 65, 78, 91, 104, 117, 130, 143, 156',
	description: '3 rolki tygodniowo, bez przerw — od października 2025 do października 2026. Pojedyncze rolki regularnie przekraczały 60 tys. wyświetleń na Facebooku.',
}];

const ld = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Service', '@id': `${url}#usluga`, name: o.service, serviceType: o.service, url, description: o.seoDesc,
			provider: { '@id': `${site}/#firma` },
			areaServed: [{ '@type': 'AdministrativeArea', name: 'województwo opolskie' }, { '@type': 'Country', name: 'Polska' }],
			offers: cards.map((c) => ({ '@type': 'Offer', name: c.name, priceCurrency: 'PLN', price: String(c.price).replace(/[^\d]/g, ''), description: c.note })),
		},
		{ '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: (o.faq?.items ?? []).map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site}/` },
				{ '@type': 'ListItem', position: 2, name: 'Oferta', item: `${site}/#oferta` },
				{ '@type': 'ListItem', position: 3, name: o.name, item: url },
			],
		},
	],
};
---
<BaseLayout title={o.seoTitle} description={o.seoDesc} noindex={!!o.noindex}>
	<div class="of">
		<!-- HERO -->
		<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
			{o.hero?.bgImage ? (
				<img src={o.hero.bgImage} alt="" class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover" style={`opacity:${(o.hero.bgOpacity ?? 30) / 100}`} />
			) : !o.hero?.thumbs && (
				<video class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover md:block" style={`opacity:${(o.hero?.bgOpacity ?? 20) / 100}`} autoplay muted loop playsinline preload="metadata">
					<source src={o.hero?.bgVideo || '/uploads/Reklama WEB.mp4'} />
				</video>
			)}
			<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
			<span data-speed="0.06" class="pointer-events-none absolute -top-24 -right-20 size-[640px] bg-radial from-orange/35 to-transparent to-62%"></span>
			<div class="relative z-2 mx-auto grid max-w-[1200px] items-center gap-12 px-6 pt-24 pb-20 sm:px-8 lg:grid-cols-[1.2fr_1fr]">
				<div class={alignCls(o.hero.align)}>
					<p class="text-[12px] font-bold tracking-[0.14em] text-orange-glow uppercase" set:html={tx(o.hero.eyebrow)} />
					<h1 class="of-h mt-6 text-[52px] leading-[0.98] md:text-[84px]">
						<span class="block font-light" set:html={tx(o.hero.title)} />
						{o.hero.titleBold && <span class="block font-extrabold" set:html={tx(o.hero.titleBold)} />}
					</h1>
					<p class="of-text mt-7 max-w-[560px] text-[19px] leading-[1.55] text-sky" set:html={tx(o.hero.lead)} />
					<div class="mt-9 flex flex-wrap gap-3.5">
						<a href="#inwestycja" class="btn-saber rounded-full bg-orange px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Zobacz inwestycję →</a>
						{o.pdf && <a href={o.pdf} download class="btn-saber rounded-full border-2 border-cloud/60 px-7 py-[15px] font-bold text-cloud transition-transform hover:-translate-y-0.5">Pobierz PDF</a>}
					</div>
					<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3 text-[13px] text-sky-mist">
						<span class="of-chip">🇵🇱 Polska firma · Opole</span>
						<span class="of-chip">NO AI — każdą klatkę układa człowiek</span>
					</div>
				</div>

				{o.hero?.sideImage ? (
					<div data-layers data-strength="100" class="relative mx-auto w-full max-w-[520px]">
						<img src={o.hero.sideImage} alt={o.hero.sideAlt || ''} data-depth="35" data-scale="100" class="w-full rounded-[26px] border border-white/15 shadow-[0_30px_70px_-25px_rgba(0,0,0,.8)]" />
					</div>
				) : o.hero?.thumbs ? (
					<div data-layers data-strength="120" class="relative mx-auto aspect-[4/3.4] w-full max-w-[520px]">
						{thumbs.map((t, i) => (
							<img src={t} alt={i === 0 ? 'Miniatury kanału Przemysława Langiera' : ''} data-depth={[18, 40, 65][i]} data-scale="100"
								class:list={['absolute w-[78%] rounded-2xl border border-white/15 shadow-[0_30px_60px_-20px_rgba(0,0,0,.7)]',
									['top-0 left-0 rotate-[-4deg]', 'top-[26%] right-0 rotate-[3deg]', 'bottom-0 left-[8%] rotate-[-1deg]'][i]]} />
						))}
						<div class="absolute -bottom-6 -left-3 z-10 rounded-2xl border border-white/15 bg-navy-deep/90 px-5 py-4 shadow-[0_20px_40px_-10px_rgba(0,0,0,.7)] backdrop-blur-md" data-depth="80" data-scale="100">
							<div class="text-[12px] font-bold tracking-wide text-sky-mist uppercase">CTR miniatur · 1. godzina</div>
							<div class="font-display text-[34px] leading-none font-extrabold text-orange-bright">21%</div>
						</div>
					</div>
				) : featured && (
					<div class="glass liquid-card relative rounded-[26px] p-7 sm:p-8">
						<div class="flex items-center justify-between">
							<span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase" set:html={tx(featured.name)} />
							<Stars size={16} />
						</div>
						<div class="mt-4 flex items-baseline gap-2">
							<span class="font-display text-[52px] leading-none font-bold" set:html={tx(featured.price)} />
							<span class="text-sky-mist" set:html={tx(featured.per)} />
						</div>
						<ul class="mt-6 flex flex-col gap-2.5 text-[15px] text-sky">
							{(featured.items ?? []).slice(0, 5).map((it: string) => <li class="flex gap-2.5"><span class="text-orange-bright">✓</span><span set:html={tx(it)} /></li>)}
						</ul>
						<p class="mt-6 border-t border-white/10 pt-5 text-[15px] leading-relaxed text-cloud" set:html={tx(`„${opinie[0].short}”`)} />
						<p class="mt-2 text-[13px] text-sky-mist">{opinie[0].name} · {opinie[0].role}</p>
					</div>
				)}
			</div>

			{clients.length > 0 && (
				<div class="relative z-2 mx-auto max-w-[1200px] px-6 pb-14 sm:px-8">
					<p class="mb-5 text-center text-[12px] font-bold tracking-[0.14em] text-white/50 uppercase">Zaufali nam</p>
					<div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-5">
						{clients.map((c: any) => <img src={c.logo} alt={c.name} style={`height:${c.height ?? 28}px`} class="w-auto opacity-70 transition-opacity hover:opacity-100" loading="lazy" />)}
					</div>
				</div>
			)}
		</section>

		<!-- ZANIM ZACZNIEMY -->
		<section class="of-sec">
			<div class:list={['of-wrap grid gap-10 md:grid-cols-[1fr_1.1fr] md:items-end', alignCls(o.intro.align)]}>
				<div>
					<p class="of-eyebrow" set:html={tx(o.intro.eyebrow)} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.intro.title)} /> <span class="of-light" set:html={tx(o.intro.titleLight)} /></h2>
				</div>
				<div class="of-text flex flex-col gap-4 text-[17px] leading-relaxed text-sky-mist">
					{paras(o.intro.text).map((p) => <p set:html={tx(p)} />)}
					{o.intro.signature && <p class="mt-2 text-[15px] text-cloud"><b>{o.intro.signature}</b> <span class="text-sky-mist">· {o.intro.signatureRole}</span></p>}
				</div>
			</div>
		</section>

		<!-- KIM SIĘ STAJESZ -->
		<section class="of-sec">
			<div class:list={['of-wrap', alignCls(o.become.align)]}>
				<p class="of-eyebrow" set:html={tx(o.become.eyebrow)} />
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.become.title)} /> <span class="of-light" set:html={tx(o.become.titleLight)} /></h2>
				<p class="of-text mt-4 max-w-[620px] text-[17px] text-sky-mist" set:html={tx(o.become.lead)} />
				<div class="mt-10 grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-4">
					{(o.become.items ?? []).map((it: any, i: number) => (
						<div class="liquid-card glass rounded-2xl p-6">
							<span class="font-display text-[13px] font-bold text-orange-glow">0{i + 1}</span>
							<h3 class="mt-3 text-[19px] font-bold text-cloud" set:html={tx(it.t)} />
							<p class="mt-2 text-[14.5px] leading-relaxed text-sky-mist" set:html={tx(it.d)} />
						</div>
					))}
				</div>
				{o.become.punch && <p class="of-text mt-8 text-[18px] text-cloud" set:html={tx(o.become.punch)} />}
			</div>
		</section>

		<!-- LICZBY RYNKU -->
		{o.stats?.items?.length > 0 && (
			<section class="of-sec">
				<div class="of-wrap">
					<div class="flex flex-wrap items-end justify-between gap-6">
						<div>
							<p class="of-eyebrow" set:html={tx(o.stats.eyebrow)} />
							<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.stats.title)} /> <span class="of-light" set:html={tx(o.stats.titleLight)} /></h2>
						</div>
						<p class="max-w-[280px] text-[13px] text-sky-mist" set:html={tx(o.stats.note)} />
					</div>
					<div class="svc-anim mt-12 grid gap-8 border-t border-white/10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
						{o.stats.items.map((s: any) => (
							<div data-float="18">
								<div class="font-display text-[64px] leading-none font-light tracking-[-0.04em] text-cloud">
									<span data-count={s.v} data-suffix="">0</span><span class="text-[26px] text-orange-glow">{s.suf}</span>
								</div>
								<p class="mt-3 text-[14.5px] leading-relaxed text-sky-mist" set:html={tx(s.d)} />
								<p class="mt-2 text-[11px] text-slate-500">{s.src}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)}

		<!-- WYNIKI -->
		{o.proof?.charts?.length > 0 && (
			<section class="of-sec relative overflow-hidden">
				<span class="pointer-events-none absolute top-1/3 -left-40 size-[560px] bg-radial from-orange/20 to-transparent to-65%"></span>
				<div class:list={['of-wrap relative', alignCls(o.proof.align)]}>
					<p class="of-eyebrow" set:html={tx(o.proof.eyebrow)} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.proof.title)} /> <span class="of-light" set:html={tx(o.proof.titleLight)} /></h2>
					<p class="of-text mt-4 max-w-[640px] text-[16px] text-sky-mist" set:html={tx(o.proof.lead)} />
					<div class="mt-10 grid gap-6 text-left lg:grid-cols-2">
						{o.proof.charts.map((c: any) => (
							<CompareBars title={c.title} sub={c.sub} unit={c.unit ?? ''} bars={toBars(c.bars)} max={c.max ? Number(c.max) : undefined} source={c.source} />
						))}
					</div>
					{o.proof.deltaLine && <div class="mt-6 text-left"><Blocks blocks={deltaBlocks} theme="dark" /></div>}
				</div>
			</section>
		)}

		<!-- CO W ŚRODKU -->
		<section class="of-sec">
			<div class:list={['of-wrap', alignCls(o.inside.align)]}>
				<p class="of-eyebrow" set:html={tx(o.inside.eyebrow)} />
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.inside.title)} /> <span class="of-light" set:html={tx(o.inside.titleLight)} /></h2>
				<p class="of-text mt-4 max-w-[620px] text-[17px] text-sky-mist" set:html={tx(o.inside.lead)} />

				{o.inside.cardTitle ? (
					<div class="mt-10 grid gap-6 text-left lg:grid-cols-[1fr_1.3fr]">
						<div class="liquid-card glass rounded-[22px] p-7">
							<span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase" set:html={tx(o.inside.cardEyebrow)} />
							<h3 class="of-h mt-4 text-[34px] leading-tight"><b set:html={tx(o.inside.cardTitle)} /> <span class="of-light" set:html={tx(o.inside.cardTitleLight)} /></h3>
							<p class="mt-3 text-[15px] text-sky-mist" set:html={tx(o.inside.cardText)} />
						</div>
						<div class="glass rounded-[22px] p-7">
							<span class="text-[12px] font-bold tracking-[0.12em] text-sky-mist uppercase" set:html={tx(o.inside.listEyebrow)} />
							<ol class="mt-4 grid gap-x-6 sm:grid-cols-2">
								{(o.inside.items ?? []).map((it: any) => (
									<li class="flex gap-3 border-b border-white/8 py-3"><span class="font-display text-[13px] font-bold text-orange-glow">{it.n}</span><span><b class="text-cloud" set:html={tx(it.t)} /> <span class="text-[14px] text-sky-mist" set:html={tx(`— ${it.d}`)} /></span></li>
								))}
							</ol>
						</div>
					</div>
				) : (
					<div class:list={['mt-10 grid gap-5 text-left', (o.inside.items ?? []).length === 3 ? 'lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-3']}>
						{(o.inside.items ?? []).map((it: any) => (
							<div class="liquid-card glass flex gap-5 rounded-2xl p-6">
								<span class="font-display text-[48px] leading-none font-light text-orange-bright">{it.n}</span>
								<div>
									<h3 class="text-[18px] font-bold text-cloud" set:html={tx(it.t)} />
									<p class="mt-1.5 text-[14.5px] leading-relaxed text-sky-mist" set:html={tx(it.d)} />
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		</section>

		<!-- SEKCJA SPECJALNA -->
		{sp.kind && (
			<section class="of-sec">
				<div class:list={['of-wrap', alignCls(sp.align)]}>
					<p class="of-eyebrow" set:html={tx(sp.eyebrow)} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(sp.title)} /> <span class="of-light" set:html={tx(sp.titleLight)} /></h2>
					{sp.lead && <p class="of-text mt-4 max-w-[640px] text-[17px] text-sky-mist" set:html={tx(sp.lead)} />}

					{sp.kind === 'rytm' && sp.table?.length > 0 && (
						<div class="glass svc-anim of-rytm mt-10 overflow-x-auto rounded-[22px] p-2 sm:p-4">
							<table class="w-full min-w-[560px] text-left text-[15px]">
								<thead><tr class="text-[12px] tracking-[0.12em] text-sky-mist uppercase"><th class="p-4 font-bold">Tydzień</th>{['01', '02', '03', '04'].map((w) => <th class="p-4 text-center font-display text-[20px] font-light text-cloud">{w}</th>)}</tr></thead>
								<tbody>
									{sp.table.map((r: any, ri: number) => (
										<tr class="border-t border-white/8">
											<td class="p-4 font-semibold text-cloud">{r.label}</td>
											{[r.w1, r.w2, r.w3, r.w4].map((c: string, ci: number) => <td class="p-4 text-center"><span class:list={['of-pill', (!c || c === '—') && 'is-empty']} style={`--d:${(ri * 4 + ci) * 0.05}s`}>{c || '—'}</span></td>)}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}

					{sp.kind === 'anatomia' && sp.timeline?.length > 0 && (
						<div class="svc-anim of-anat mt-12 text-left">
							<div class="flex h-14 gap-1.5">
								{sp.timeline.map((s: any, i: number) => (
									<div class="of-seg" style={`--g:${Number(s.sec) || 1};--d:${i * 0.18}s`} data-hl={s.highlight ? '1' : undefined}><span>{s.label}</span></div>
								))}
							</div>
							<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
								{sp.timeline.map((s: any) => (
									<div><span class="text-[12px] font-bold text-orange-glow tabular-nums">{s.time}</span><h3 class="mt-1 text-[17px] font-bold text-cloud" set:html={tx(s.label)} /><p class="mt-1.5 text-[14px] leading-relaxed text-sky-mist" set:html={tx(s.desc)} /></div>
								))}
							</div>
						</div>
					)}

					{sp.kind === 'algorytm' && sp.steps?.length > 0 && (
						<div class="svc-anim of-funnel mt-10 grid gap-3 text-left sm:grid-cols-5">
							{sp.steps.map((s: any, i: number) => (
								<div class="of-step glass rounded-2xl p-5" style={`--d:${i * 0.15}s`}>
									<span class="font-display text-[12px] font-bold text-orange-glow">0{i + 1}</span>
									<h3 class="mt-1 text-[18px] font-bold text-cloud" set:html={tx(s.t)} />
									<p class="text-[13px] text-sky-mist" set:html={tx(s.d)} />
								</div>
							))}
						</div>
					)}

					{sp.cards?.length > 0 && (
						<div class:list={['grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-4', sp.kind === 'algorytm' ? 'mt-6' : 'mt-14']}>
							{sp.cards.map((c: any) => (
								c.k
									? <div class="liquid-card glass rounded-2xl p-6"><span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase">{c.k}</span><h3 class="mt-2 text-[18px] font-bold text-cloud" set:html={tx(c.t)} /><p class="mt-2 text-[14px] leading-relaxed text-sky-mist" set:html={tx(c.d)} /></div>
									: <div class="border-t border-white/12 pt-4"><h3 class="text-[17px] font-bold text-cloud" set:html={tx(c.t)} /><p class="mt-1.5 text-[14px] leading-relaxed text-sky-mist" set:html={tx(c.d)} /></div>
							))}
						</div>
					)}

					{sp.title2 && <h2 class="of-h mt-20 text-[34px] leading-[1.05] md:text-[44px]"><span set:html={tx(sp.title2)} /> <span class="of-light" set:html={tx(sp.title2Light)} /></h2>}
					{sp.cards2?.length > 0 && (
						<div class="mt-8 grid gap-5 text-left md:grid-cols-4">
							{sp.cards2.map((c: any) => (
								<div class="liquid-card glass rounded-2xl p-6"><span class="text-[12px] font-bold tracking-[0.12em] text-orange-glow uppercase">{c.k}</span><h3 class="mt-2 text-[18px] font-bold text-cloud" set:html={tx(c.t)} /><p class="mt-2 text-[14px] leading-relaxed text-sky-mist" set:html={tx(c.d)} /></div>
							))}
						</div>
					)}
					{sp.note && <p class="of-text mt-5 text-[14px] text-sky-mist" set:html={tx(sp.note)} />}
				</div>
			</section>
		)}

		<!-- OPINIE -->
		<section class="of-sec">
			<div class="of-wrap">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<div>
						<p class="of-eyebrow" set:html={tx(o.opinie?.eyebrow ?? 'Opinie')} />
						<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.opinie?.title)} /> <span class="of-light" set:html={tx(o.opinie?.titleLight)} /></h2>
					</div>
					<Stars size={30} class="of-stars-big" />
				</div>
				<div class="mt-10 grid gap-6 md:grid-cols-2">
					{opinie.map((q) => (
						<figure class="liquid-card glass relative rounded-[22px] p-8">
							<Stars size={18} />
							<blockquote class="mt-5 text-[18px] leading-[1.6] text-cloud" set:html={tx(`„${q.quote}”`)} />
							<figcaption class="mt-6 flex items-center justify-between gap-4 border-t border-white/12 pt-5">
								<span><b class="block text-[15px] text-cloud">{q.name}</b><span class="text-[13px] text-sky-mist">{q.role}</span></span>
								<img src={q.logo} alt={q.logoAlt} class="h-6 w-auto opacity-85" loading="lazy" />
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- REALIZACJE -->
		{projects.length > 0 && (
			<section class="of-sec">
				<div class="of-wrap">
					<p class="of-eyebrow" set:html={tx(o.projects?.eyebrow ?? 'Realizacje')} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.projects?.title)} /> <span class="of-light" set:html={tx(o.projects?.titleLight)} /></h2>
					<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{projects.map((p, i) => <ProjectCard project={p} index={i} />)}
					</div>
				</div>
			</section>
		)}

		<!-- PYTANIA -->
		{o.faq?.items?.length > 0 && (
			<section class="of-sec">
				<div class:list={['of-wrap', alignCls(o.faq.align)]}>
					<p class="of-eyebrow" set:html={tx(o.faq.eyebrow)} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.faq.title)} /> <span class="of-light" set:html={tx(o.faq.titleLight)} /></h2>
					<div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
						{o.faq.items.map((f: any) => (
							<div class="border-t border-white/12 pt-5"><h3 class="text-[17px] font-bold text-cloud" set:html={tx(f.q)} /><p class="of-text mt-2 text-[14.5px] leading-relaxed text-sky-mist" set:html={tx(f.a)} /></div>
						))}
					</div>
				</div>
			</section>
		)}

		<!-- WĄTPLIWOŚCI -->
		{o.doubts?.items?.length > 0 && (
			<section class="of-sec">
				<div class:list={['of-wrap', alignCls(o.doubts.align)]}>
					<p class="of-eyebrow" set:html={tx(o.doubts.eyebrow)} />
					<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.doubts.title)} /> <span class="of-light" set:html={tx(o.doubts.titleLight)} /></h2>
					<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{o.doubts.items.map((d: any) => (
							<div class="liquid-card glass rounded-2xl p-6"><h3 class="text-[17px] font-bold text-cloud" set:html={tx(d.q)} /><p class="of-text mt-2 text-[14.5px] leading-relaxed text-sky-mist" set:html={tx(d.a)} /></div>
						))}
						{(o.doubts.callText || o.doubts.phone) && (
							<div class="flex flex-col justify-center rounded-2xl border border-orange/40 bg-orange/10 p-6">
								<p class="of-text text-[15px] leading-relaxed text-cloud" set:html={tx(o.doubts.callText)} />
								{o.doubts.phone && <a href={`tel:+48${String(o.doubts.phone).replace(/\D/g, '')}`} class="mt-3 font-display text-[26px] font-bold text-orange-bright hover:underline">{o.doubts.phone}</a>}
							</div>
						)}
					</div>
				</div>
			</section>
		)}

		<!-- INWESTYCJA -->
		<section id="inwestycja" class="of-sec scroll-mt-20">
			<div class="of-wrap">
				<p class="of-eyebrow" set:html={tx(o.invest.eyebrow)} />
				<h2 class="of-h mt-4 text-[38px] leading-[1.05] md:text-[52px]"><span set:html={tx(o.invest.title)} /> <span class="of-light" set:html={tx(o.invest.titleLight)} /></h2>
				<div class:list={['mt-10 grid items-start gap-6', cards.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
					{cards.map((c) => (
						<div class:list={['liquid-card glass rounded-[24px] p-8', c.featured && 'border-orange/50 shadow-[0_0_50px_-10px_rgba(237,36,78,.55)]']}>
							<span class:list={['inline-block rounded-full px-3 py-1 text-[11px] font-bold tracking-[0.08em] uppercase', c.featured ? 'bg-orange text-cloud' : 'bg-white/8 text-sky-mist']}>{c.tag}</span>
							<h3 class="mt-4 text-[20px] font-bold text-cloud" set:html={tx(c.name)} />
							<div class="mt-4 flex flex-wrap items-baseline gap-x-2">
								<span class="font-display text-[48px] leading-none font-bold text-cloud" set:html={tx(c.price)} />
								<span class="text-[14px] text-sky-mist" set:html={tx(c.per)} />
							</div>
							<p class="mt-2 text-[13px] text-sky-mist" set:html={tx(c.note)} />
							<ul class="mt-6 flex flex-col gap-2.5 text-[15px] text-sky">
								{(c.items ?? []).map((it: string) => <li class="flex gap-2.5"><span class="text-orange-bright">✓</span><span set:html={tx(it)} /></li>)}
							</ul>
							{c.ctaLabel && (
								<a href={withUtm(c.ctaHref)} class:list={['btn-saber mt-7 block rounded-full py-3.5 text-center font-bold transition-transform hover:-translate-y-0.5', c.featured ? 'bg-orange text-cloud' : 'border-2 border-cloud/50 text-cloud']}>{c.ctaLabel} →</a>
							)}
						</div>
					))}
				</div>
				{o.invest.footnote && <p class="mt-6 text-[14px] text-sky-mist" set:html={tx(o.invest.footnote)} />}
			</div>
		</section>

		<!-- NASTĘPNY KROK -->
		<section class="relative overflow-hidden border-t border-white/6 bg-linear-160 from-navy to-navy-deep text-cloud">
			<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
			<span data-speed="0.03" class="pointer-events-none absolute top-10 right-[10%] text-[34px] text-orange">✦</span>
			<div class:list={['of-wrap relative z-2 py-24', alignCls(o.final.align)]}>
				<p class="of-eyebrow" set:html={tx(o.final.eyebrow)} />
				<h2 class="of-h mt-4 text-[44px] leading-[1.02] md:text-[72px]"><span class="font-light" set:html={tx(o.final.title)} /> <span class="block font-extrabold" set:html={tx(o.final.titleBold)} /></h2>
				<p class="of-text mt-6 max-w-[600px] text-[18px] text-sky" set:html={tx(o.final.lead)} />
				<div class="mt-9 flex flex-wrap gap-3.5">
					<a href={gen} class="btn-saber rounded-full bg-orange px-8 py-4 font-bold text-cloud transition-transform hover:-translate-y-0.5">{o.final.cta} →</a>
					<a href="tel:+48668472759" class="btn-saber rounded-full border-2 border-cloud/60 px-8 py-4 font-bold text-cloud transition-transform hover:-translate-y-0.5">Zadzwoń: 668 472 759</a>
				</div>
				<p class="mt-8 text-[14px] text-sky-mist">kontakt@sobotkavisual.pl{o.pdf && <> · <a href={o.pdf} download class="underline hover:text-cloud">pobierz ofertę w PDF</a></>}</p>
				{others.length > 0 && (
					<div class="mt-14 border-t border-white/10 pt-8">
						<p class="text-[12px] font-bold tracking-[0.14em] text-white/50 uppercase">Zobacz też</p>
						<div class="mt-4 flex flex-wrap gap-3">
							{others.map((x) => <a href={`/oferta/${x.slug}`} class="of-chip hover:border-orange/60 hover:text-cloud">{x.name} →</a>)}
						</div>
					</div>
				)}
			</div>
		</section>

		{featured && (
			<div class="fixed inset-x-0 bottom-0 z-50 flex items-center justify-between gap-3 border-t border-white/12 bg-navy-deep/95 px-5 py-3 backdrop-blur-xl md:hidden">
				<span class="text-[13px] text-sky-mist">{featured.name} · <b class="text-cloud" set:html={tx(`${featured.price} zł`)} /></span>
				<a href={gen} class="rounded-full bg-orange px-5 py-2.5 text-sm font-bold text-cloud">Skonfiguruj →</a>
			</div>
		)}
	</div>

	<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

