	.of-seg[data-hl]::before { background: linear-gradient(90deg, var(--color-orange-deep), var(--color-orange-bright)); box-shadow: 0 0 24px rgba(237,36,78,.6); }
	.of-seg span { position: relative; font-size: 12px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
