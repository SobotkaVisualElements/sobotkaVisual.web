---
/*
 * Strona 404. Bez niej Cloudflare Pages zwraca stronę główną z kodem 200
 * dla każdego nieistniejącego adresu (soft 404 w Google).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
const links = [
	{ href: '/uslugi/', label: 'Usługi' },
	{ href: '/work/', label: 'Realizacje' },
	{ href: '/generator/', label: 'Wyceń pakiet' },
	{ href: '/obszar-dzialania/', label: 'Obszar działania' },
];
---
<BaseLayout title="Nie ma takiej strony" description="Ta strona nie istnieje albo została przeniesiona." noindex>
	<main class="relative overflow-hidden bg-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
		<div class="relative mx-auto max-w-[720px] px-6 py-32 text-center sm:px-8">
			<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">Błąd 404</span>
			<h1 class="mt-3 text-[40px] leading-tight font-bold tracking-[-0.02em] md:text-[52px]">Tej strony tu nie ma</h1>
			<p class="mt-4 text-[18px] text-sky-mist">Adres mógł się zmienić albo zawiera literówkę. Zacznij od jednej z tych stron:</p>
			<nav class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Przydatne strony">
				{links.map((l) => <a href={l.href} class="rounded-full border border-white/15 px-5 py-3 font-bold hover:bg-white/10">{l.label}</a>)}
			</nav>
			<a href="/" class="btn-saber mt-8 inline-block rounded-full bg-orange px-7 py-[15px] font-bold text-cloud">Strona główna →</a>
		</div>
	</main>
</BaseLayout>
