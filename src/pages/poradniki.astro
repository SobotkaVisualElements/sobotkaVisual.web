---
/*
 * Poradniki — lista artykułów (podstrony z polem „Data aktualizacji”), układ jak blog ekspercki:
 * kategorie u góry, wyróżniony najnowszy poradnik, potem sekcje kategorii z kafelkami.
 * Nowy poradnik: Panel → Podstrony → Utwórz → wypełnij „Data aktualizacji”.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IsoIcon from '../components/iso/IsoIcon.astro';
import { cat, readMin, firstImg, firstIcon } from '../lib/articles';
import { slugId } from '../lib/md';
const list = (await getCollection('pages', ({ data }) => !data.draft && !!data.updated)).sort((a, b) => +b.data.updated! - +a.data.updated!);
const cats = [...new Set(list.map((p) => cat(p.data.eyebrow)))];
const [lead, ...rest] = list;
const side = rest.slice(0, 3);
const date = (d: Date) => d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const site = 'https://sobotkavisual.pl';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Poradniki Sobotka Visual', url: `${site}/poradniki/`, mainEntity: { '@type': 'ItemList', itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.heading || p.data.title, url: `${site}/${p.id}/` })) } };
---
<BaseLayout title="Poradniki o wideo, rolkach i animacji dla firm" description="Ile kosztuje rolka, film reklamowy i animacja? Pomysły na rolki dla firmy, rolki rekrutacyjne, booktrailery. Praktyczne poradniki od studia Sobotka Visual.">
	<div class="bl">
		<header class="bl-head">
			<div class="bl-wrap">
				<nav class="ar-crumbs" aria-label="Okruszki"><a href="/">Strona główna</a><span>›</span><span>Poradniki</span></nav>
				<h1>Poradniki: wideo, rolki i animacja dla firm</h1>
				<p>Ceny, pomysły i sprawdzone formaty z naszej codziennej pracy. Bez lania wody — konkretne liczby i przykłady.</p>
				<nav class="bl-cats" aria-label="Kategorie">{cats.map((c) => <a href={`#${slugId(c)}`} data-go={slugId(c)}>{c}</a>)}</nav>
			</div>
		</header>

		{lead && (
			<section class="bl-wrap bl-top" aria-label="Najnowsze">
				<a href={`/${lead.id}/`} class="bl-lead">
					<span class="bl-img">{firstImg(lead.data) ? <img src={firstImg(lead.data)} alt="" /> : <span class="bl-ico" aria-hidden="true"><IsoIcon name={firstIcon(lead.data)} mode="static" /></span>}</span>
					<span class="bl-body">
						<small>{cat(lead.data.eyebrow)}</small>
						<b>{lead.data.heading || lead.data.title}</b>
						<span class="bl-ex">{lead.data.description}</span>
						<span class="bl-meta">{date(lead.data.updated!)} · {readMin(lead.data)} min czytania</span>
					</span>
				</a>
				<div class="bl-side">
					{side.map((p) => (
						<a href={`/${p.id}/`} class="bl-mini">
							<span class="bl-img">{firstImg(p.data) ? <img src={firstImg(p.data)} alt="" loading="lazy" /> : <span class="bl-ico" aria-hidden="true"><IsoIcon name={firstIcon(p.data)} mode="static" /></span>}</span>
							<span class="bl-body"><small>{cat(p.data.eyebrow)}</small><b>{p.data.heading || p.data.title}</b><span class="bl-meta">{readMin(p.data)} min czytania</span></span>
						</a>
					))}
				</div>
			</section>
		)}

		<section class="bl-wrap bl-sec" id="wszystkie">
			<div class="bl-sec-h">
				<h2>Wszystkie poradniki</h2>
				<div class="bl-filter" role="group" aria-label="Filtruj według kategorii">
					<button type="button" class="on" data-f="">Wszystkie</button>
					{cats.map((c) => <button type="button" data-f={slugId(c)} id={slugId(c)}>{c}</button>)}
				</div>
			</div>
			<div class="bl-grid">
				{list.map((p) => (
					<a href={`/${p.id}/`} class="ar-card" data-cat={slugId(cat(p.data.eyebrow))}>
						<span class="ar-card-img">{firstImg(p.data) ? <img src={firstImg(p.data)} alt="" loading="lazy" /> : <span class="ar-card-ico" aria-hidden="true"><IsoIcon name={firstIcon(p.data)} mode="static" /></span>}</span>
						<span class="ar-card-b"><small>{cat(p.data.eyebrow)}</small><b>{p.data.heading || p.data.title}</b><span class="bl-ex">{p.data.description}</span><span class="bl-meta">{date(p.data.updated!)} · {readMin(p.data)} min czytania</span></span>
					</a>
				))}
			</div>
		</section>

		<section class="bl-wrap bl-cta">
			<div>
				<b>Wolisz, żeby ktoś zrobił to za Ciebie?</b>
				<span>Wyślij nagranie — pierwszą rolkę zmontujemy za darmo.</span>
			</div>
			<a href="/#probna">Darmowa rolka próbna →</a>
		</section>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
<script>
	const btns = [...document.querySelectorAll<HTMLButtonElement>('.bl-filter button')];
	const cards = [...document.querySelectorAll<HTMLElement>('.bl-grid .ar-card')];
	const go = (f: string) => { btns.forEach((b) => b.classList.toggle('on', b.dataset.f === f)); cards.forEach((c) => (c.hidden = !!f && c.dataset.cat !== f)); };
	btns.forEach((b) => b.addEventListener('click', () => go(b.dataset.f || '')));
	document.querySelectorAll<HTMLAnchorElement>('.bl-cats a').forEach((a) => a.addEventListener('click', () => go(a.dataset.go || '')));
	if (location.hash) { const f = decodeURIComponent(location.hash.slice(1)); if (btns.some((b) => b.dataset.f === f)) go(f); }
</script>

<style is:global>
	.bl { background: #fbfaff; color: #1b1640; padding-bottom: 64px; }
	.bl-wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
	.bl-head { background: linear-gradient(180deg, #f1eeff, #fbfaff); border-bottom: 1px solid #e7e3f7; padding: 34px 0 30px; }
	.bl-head h1 { margin-top: 16px; font-size: clamp(30px, 4.4vw, 46px); line-height: 1.12; font-weight: 800; letter-spacing: -.02em; color: #120d33; }
	.bl-head p { margin-top: 12px; max-width: 640px; font-size: 18px; line-height: 1.6; color: #4a4470; }
	.bl-cats { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px; }
	.bl-cats a { padding: 8px 16px; border-radius: 999px; background: #fff; border: 1px solid #ddd8f2; font-weight: 700; font-size: 14px; color: #1b1640; text-transform: capitalize; }
	.bl-cats a:hover { border-color: var(--color-orange); color: var(--color-orange); }
	.bl-top { margin-top: 36px; display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; }
	.bl-lead, .bl-mini { display: flex; border-radius: 20px; overflow: hidden; background: #fff; border: 1px solid #e7e3f7; transition: transform .2s, box-shadow .2s; }
	.bl-lead:hover, .bl-mini:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -26px rgba(30,20,80,.6); }
	.bl-lead { flex-direction: column; }
	.bl-img { display: grid; place-items: center; background: radial-gradient(60% 80% at 80% 10%, rgba(176,60,255,.35), transparent 70%), linear-gradient(150deg, #1a1150, #0d0930); }
	.bl-img img { width: 100%; height: 100%; object-fit: cover; }
	.bl-lead .bl-img { aspect-ratio: 16 / 8; } .bl-lead .bl-ico { width: 30%; }
	.bl-body { display: flex; flex-direction: column; gap: 6px; padding: 18px 22px 22px; }
	.bl-body small, .ar-card-b small { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #c41339; }
	.bl-lead b { font-size: 26px; line-height: 1.2; color: #120d33; }
	.bl-ex { font-size: 15px; line-height: 1.55; color: #4a4470; }
	.bl-meta { margin-top: auto; padding-top: 6px; font-size: 13px; color: #8a84ad; }
	.bl-side { display: grid; gap: 16px; align-content: start; }
	.bl-mini .bl-img { width: 34%; flex: none; } .bl-mini .bl-ico { width: 70%; }
	.bl-mini b { font-size: 16px; line-height: 1.35; color: #120d33; }
	.bl-mini .bl-body { padding: 14px 16px; }
	.bl-sec { margin-top: 52px; scroll-margin-top: 90px; }
	.bl-sec-h { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 2px solid #e7e3f7; }
	.bl-sec h2 { font-size: 26px; font-weight: 800; color: #120d33; }
	.bl-filter { display: flex; flex-wrap: wrap; gap: 6px; }
	.bl-filter button { padding: 7px 14px; border-radius: 999px; border: 1px solid #ddd8f2; background: #fff; font-weight: 700; font-size: 13px; color: #3a3466; cursor: pointer; text-transform: capitalize; scroll-margin-top: 120px; }
	.bl-filter button.on { background: #1b1640; border-color: #1b1640; color: #fff; }
	.ar-card[hidden] { display: none; }
	.bl-grid { margin-top: 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
	.bl-cta { margin-top: 56px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 26px 28px; border-radius: 22px; color: #fff; background: radial-gradient(60% 120% at 90% 0%, rgba(176,60,255,.55), transparent 70%), linear-gradient(150deg, #1a1150, #0d0930); }
	.bl-cta b { display: block; font-size: 21px; } .bl-cta span { color: #c3c0dc; }
	.bl-cta a { padding: 13px 22px; border-radius: 999px; background: #2ee59d; color: #04261a; font-weight: 800; }
	.ar-crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; color: #6b6590; }
	.ar-crumbs a { color: #6b6590; } .ar-crumbs a:hover { color: var(--color-orange); }
	.ar-card { display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: #fff; border: 1px solid #e7e3f7; transition: transform .2s, box-shadow .2s; }
	.ar-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -26px rgba(30,20,80,.6); }
	.ar-card-img { display: grid; place-items: center; aspect-ratio: 16 / 9; background: radial-gradient(60% 80% at 80% 10%, rgba(176,60,255,.35), transparent 70%), linear-gradient(150deg, #1a1150, #0d0930); }
	.ar-card-img img { width: 100%; height: 100%; object-fit: cover; }
	.ar-card-ico { width: 40%; }
	.ar-card-b { padding: 16px 18px 20px; display: grid; gap: 6px; }
	.ar-card-b small { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #c41339; }
	.ar-card-b b { font-size: 17px; line-height: 1.35; color: #120d33; }
	@media (max-width: 900px) { .bl-top { grid-template-columns: 1fr; } .bl-grid { grid-template-columns: 1fr 1fr; } }
	@media (max-width: 600px) { .bl-grid { grid-template-columns: 1fr; } .bl-mini .bl-img { width: 38%; } }
</style>
