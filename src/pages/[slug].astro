---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/blocks/Blocks.astro';

export async function getStaticPaths() {
	const pages = await getCollection('pages', ({ data }) => !data.draft);
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
// poradniki (podstrony z datą aktualizacji): „Czytaj też” i okruszek „Poradniki”
const isArticle = !!page.data.updated;
const more = isArticle ? (await getCollection('pages', ({ data }) => !data.draft && !!data.updated)).filter((p) => p.id !== page.id).sort((a, b) => +b.data.updated! - +a.data.updated!).slice(0, 4) : [];
---

<BaseLayout title={page.data.title} description={page.data.description} noindex={page.data.noindex}>
	<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
		<div class="relative z-2 mx-auto max-w-[860px] px-6 pt-24 pb-14 sm:px-8">
			{page.data.eyebrow && (
				<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">{page.data.eyebrow}</span>
			)}
			<h1 class="mt-3 text-[34px] leading-[1.06] font-bold tracking-[-0.02em] md:text-[50px]">
				{page.data.heading || page.data.title}
			</h1>
			<p class="mt-5 max-w-[620px] text-[18px] leading-[1.6] text-sky-mist">{page.data.description}</p>
			{page.data.updated && <p class="mt-4 text-[14px] text-sky-mist/80">Aktualizacja: <time datetime={page.data.updated.toISOString().slice(0, 10)}>{page.data.updated.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}</time> · Krzysztof Sobotka</p>}
		</div>
	</section>

	<section class="relative overflow-hidden border-t border-white/6 bg-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-40"></span>
		<div class="relative z-2 mx-auto max-w-[860px] px-6 py-16 sm:px-8">
			<article class="prose-svc"><Content /></article>
			{page.data.blocks?.length ? <Blocks blocks={page.data.blocks} theme="dark" /> : null}
			{more.length > 0 && (
				<nav class="mt-14" aria-label="Czytaj też">
					<h2 class="text-[24px] font-bold text-cloud">Czytaj też</h2>
					<div class="mt-4 grid gap-3 sm:grid-cols-2">
						{more.map((m) => <a href={`/${m.id}/`} class="rounded-2xl border border-white/12 bg-white/5 p-5 transition-colors hover:border-orange/60"><span class="block text-[12px] font-bold tracking-[0.1em] text-orange-glow uppercase">{m.data.eyebrow}</span><span class="mt-1 block font-bold text-cloud">{m.data.heading || m.data.title}</span></a>)}
					</div>
					<a href="/poradniki/" class="mt-4 inline-block font-bold text-orange">Wszystkie poradniki →</a>
				</nav>
			)}
			{page.id !== 'polityka-prywatnosci' && <a href="/generator" class="liquid-card mt-12 flex flex-col items-center gap-4 rounded-[24px] border-2 border-orange bg-linear-100 from-orange-deep via-orange to-orange-bright px-7 py-8 text-center shadow-[0_18px_50px_-12px_rgba(237,36,78,.65)] sm:flex-row sm:justify-between sm:text-left">
				<span>
					<span class="block font-display text-[24px] leading-tight font-bold text-cloud">Policz swój pakiet</span>
					<span class="mt-1 block text-[15px] text-white/85">Ustaw zakres suwakami — rabat rośnie do 30%.</span>
				</span>
				<span class="shrink-0 rounded-full bg-cloud px-6 py-3 font-bold text-navy-deep">Otwórz generator →</span>
			</a>}
		</div>
	</section>
	{page.data.updated && <script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": page.data.heading || page.data.title,
		"description": page.data.description,
		"url": `https://sobotkavisual.pl/${page.id}/`,
		"inLanguage": "pl",
		"datePublished": page.data.updated.toISOString().slice(0, 10),
		"dateModified": page.data.updated.toISOString().slice(0, 10),
		"image": "https://sobotkavisual.pl/og-default.jpg",
		"author": { "@type": "Person", "name": "Krzysztof Sobotka", "jobTitle": "3D Visual & Motion Artist", "url": "https://sobotkavisual.pl/o-nas/" },
		"publisher": { "@type": "Organization", "@id": "https://sobotkavisual.pl/#firma", "name": "Sobotka Visual Creations", "logo": "https://sobotkavisual.pl/logo.svg" }
	})} />}
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://sobotkavisual.pl/" },
			...(isArticle ? [{ "@type": "ListItem", "position": 2, "name": "Poradniki", "item": "https://sobotkavisual.pl/poradniki/" }] : []),
			{ "@type": "ListItem", "position": isArticle ? 3 : 2, "name": page.data.heading || page.data.title, "item": `https://sobotkavisual.pl/${page.id}/` }
		]
	})} />
</BaseLayout>

<style is:global>
	.prose-svc { color: var(--color-sky-mist); font-size: 17px; line-height: 1.7; }
	.prose-svc h2 { color: var(--color-cloud); font-size: 28px; font-weight: 700; margin: 2rem 0 .75rem; }
	.prose-svc h3 { color: var(--color-cloud); font-size: 21px; font-weight: 700; margin: 1.5rem 0 .5rem; }
	.prose-svc p { margin-bottom: 1rem; hyphens: auto; -webkit-hyphens: auto; text-wrap: pretty; }
	@media (min-width: 560px) { .prose-svc p { text-align: justify; text-align-last: left; } }
	.prose-svc ul, .prose-svc ol { margin: 0 0 1rem 1.25rem; list-style: disc; }
	.prose-svc ol { list-style: decimal; }
	.prose-svc li { margin-bottom: .4rem; }
	.prose-svc a { color: var(--color-orange); text-decoration: underline; }
	.prose-svc strong { color: var(--color-cloud); }
	.prose-svc table { width: 100%; margin: 0 0 1.25rem; border-collapse: collapse; font-size: 15px; line-height: 1.5; display: block; overflow-x: auto; }
	.prose-svc th, .prose-svc td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,.12); text-align: left; vertical-align: top; }
	.prose-svc th { color: var(--color-cloud); font-weight: 700; background: rgba(255,255,255,.05); }
	.prose-svc blockquote { margin: 0 0 1.25rem; padding: 16px 20px; border-left: 3px solid var(--color-orange); background: rgba(255,255,255,.05); border-radius: 0 14px 14px 0; color: var(--color-cloud); }
	.prose-svc blockquote p { margin: 0; text-align: left; }
</style>
