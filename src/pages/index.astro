---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Features from '../components/landing/Features.astro';
import Showcase from '../components/landing/Showcase.astro';
import Pricing from '../components/landing/Pricing.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import RecentWork from '../components/landing/RecentWork.astro';
import home from '../data/home.json';
import StatsBar from '../components/ui/StatsBar.astro';
import Process from '../components/landing/Process.astro';
import SampleReel from '../components/landing/SampleReel.astro';
import ContentDay from '../components/landing/ContentDay.astro';

// Kolejność sekcji ustawiana w panelu (Strona główna → Kolejność sekcji).
// Hero zawsze pierwsze (tam jest nagłówek H1 dla Google). Usunięta z listy sekcja znika ze strony.
const map: Record<string, any> = { realizacje: RecentWork, uslugi: Features, dlaKogo: Showcase, oferta: Pricing, opinie: Testimonials, faq: Faq, kontakt: FinalCta, proces: Process, probna: SampleReel, dzien: ContentDay };
const fallback = ['realizacje', 'uslugi', 'dlaKogo', 'proces', 'oferta', 'dzien', 'opinie', 'probna', 'faq', 'kontakt'];
const order: string[] = ((home as any).sections?.length ? (home as any).sections : fallback)
	.map((s: any) => (typeof s === 'string' ? s : s?.section))
	.filter((s: string, i: number, arr: string[]) => map[s] && arr.indexOf(s) === i);
---

<BaseLayout>
	<Hero />
	<StatsBar />
	{order.map((id) => { const C = map[id]; return <C />; })}
</BaseLayout>
