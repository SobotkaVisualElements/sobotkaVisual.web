const faq = [{"q": "Ile kosztuje projektowanie miniatur w kanale?", "a": "Projektowanie miniatur zaczyna się od 220 zł netto za sztukę. Ostateczna cena zależy od długości materiału, liczby sztuk i terminu. Pełną wycenę policzysz sam w generatorze na stronie."}, {"q": "Czy pracujecie z twórcami z całej Polski?", "a": "Tak. Miniatury robimy w całości zdalnie — wystarczy link do kanału i temat filmu. Pierwszy projekt dostajesz zwykle w 48 godzin."}, {"q": "Jak długo trwa realizacja?", "a": "Standardowo 5–10 dni roboczych w zależności od zakresu. Tryb ekspresowy poniżej 48 godzin jest możliwy za dopłatą 50%."}, {"q": "Czy można zamówić jednorazowo, bez abonamentu?", "a": "Tak. Realizujemy pojedyncze zlecenia i pakiety projektowe. Abonament jest tańszy w przeliczeniu na materiał, ale nie jest obowiązkowy."}];
