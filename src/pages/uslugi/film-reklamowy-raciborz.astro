---
import LocalPage from '../../components/LocalPage.astro';
import { oneoffDeal, dzienPreset, zl } from '../../lib/pricing';
const dzien = oneoffDeal(dzienPreset);
const problemy = ["Zakład szuka pracowników, a oferty pracy giną w tłumie.", "Materiały firmowe są sprzed kilku lat.", "Nie ma kto zadbać o rolki i social media.", "Lokalna agencja nie robi animacji ani grafiki."];
const zakres = [...[{"name": "Film reklamowy / wizerunkowy do 2 min", "price": "od 4 500 zł"}, {"name": "Dzień zdjęciowy (do 6 h)", "price": "od 1 150 zł"}, {"name": "Rolka z nagraniem u Ciebie", "price": "od 550 zł / szt."}, {"name": "Rolka z Twoich materiałów", "price": "od 390 zł / szt."}], { name: "Dzień contentowy: nagrania + 10 rolek + 4 grafiki", price: zl(dzien.final) }, {"name": "Dojazd do Raciborza", "price": "150 zł — raz na dzień nagrań"}];
const faq = [{"q": "Ile kosztuje film reklamowy w Raciborzu?", "a": "Film reklamowy lub wizerunkowy do 2 minut kosztuje od 4 500 zł. Dzień zdjęciowy to od 1 150 zł, a rolka nagrana u Ciebie od 550 zł. Do tego jednorazowo 150 zł za dojazd."}, {"q": "Ile kosztuje dojazd do Raciborza?", "a": "Racibórz jest ok. 75 km od Opola — dojazd to jedna dopłata 150 zł za cały dzień nagrań."}, {"q": "Czy możecie nagrać rolki w naszej firmie w Raciborzu?", "a": "Tak. Najczęściej robimy to w formie dnia contentowego: przyjeżdżamy na jeden dzień, nagrywamy wszystko naraz, a potem dostajesz 10 rolek i 4 grafiki do publikacji przez miesiąc."}, {"q": "Jak szybko dostaniemy gotowy materiał?", "a": "Rolki zwykle w 5–7 dni roboczych od nagrania, film reklamowy w 2–3 tygodnie. Tryb ekspresowy poniżej 48 godzin jest możliwy za dopłatą 50%."}];
---
<LocalPage
	h1={"Film reklamowy i rolki Racibórz"}
	miasto={"Racibórz"}
	title={"Film reklamowy i rolki dla firm Racibórz — nagrania na miejscu | SVC"}
	description={"Film reklamowy, rolki i materiały rekrutacyjne dla firm z Raciborza i okolic. Nagrania na miejscu, montaż i animacje. Film od 4 500 zł, rolka od 550 zł. Dojazd: 150 zł."}
	intro={"Filmy reklamowe, rolki i materiały rekrutacyjne dla firm z Raciborza, Kuźni Raciborskiej i Krzanowic. Przyjeżdżamy na jeden dzień nagrań, montaż i animacje robimy zdalnie."}
	problemy={problemy}
	zakres={zakres}
	faq={faq}
/>
