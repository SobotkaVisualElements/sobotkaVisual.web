---
import LocalPage from '../../components/LocalPage.astro';
const problemy = ["Nagrań przybywa, ale nikt nie ma czasu ich zmontować.", "Materiały wyglądają amatorsko i nie pasują do reszty marki.", "Montaż trwa tygodniami i temat traci aktualność.", "Każdy film wygląda inaczej — brak spójności."];
const zakres = [{"name": "Montaż długiej formy 10–20 min", "price": "od 1 000 zł"}, {"name": "Skrót meczowy lub eventowy", "price": "od 700 zł"}, {"name": "Materiał wizerunkowy do 2 min", "price": "od 3 000 zł"}, {"name": "Abonament 4 materiały/mies.", "price": "od 3 600 zł"}, {"name": "Opracowanie dźwięku i napisy", "price": "od 150 zł"}];
const faq = [{"q": "Ile kosztuje montaż wideo w Opolu?", "a": "Montaż wideo zaczyna się od 1 000 zł netto. Ostateczna cena zależy od długości materiału, liczby sztuk i terminu. Pełną wycenę policzysz sam w generatorze na stronie."}, {"q": "Czy pracujecie zdalnie z klientami z Opolu?", "a": "Tak. Materiały odbieramy przez internet, a na zdjęcia lub wydarzenia dojeżdżamy na miejsce. Dojazd do 40 km jest w cenie."}, {"q": "Jak długo trwa realizacja?", "a": "Standardowo 5–10 dni roboczych w zależności od zakresu. Tryb ekspresowy poniżej 48 godzin jest możliwy za dopłatą 50%."}, {"q": "Czy można zamówić jednorazowo, bez abonamentu?", "a": "Tak. Realizujemy pojedyncze zlecenia i pakiety projektowe. Abonament jest tańszy w przeliczeniu na materiał, ale nie jest obowiązkowy."}];
---
<LocalPage
	h1={"Montaż wideo Opole"}
	miasto={"Opole"}
	title={"Montaż wideo Opole — profesjonalny montaż materiałów | SVC"}
	description={"Montaż wideo w Opolu: długie formy, skróty, materiały wizerunkowe. Dynamiczne cięcie, napisy, color grading. Wycena w 60 sekund."}
	intro={"Montujemy materiały dla firm, twórców i klubów z Opola i całej Opolszczyzny. Dynamiczne cięcie, napisy, korekcja dźwięku i color grading — materiał gotowy do publikacji."}
	problemy={problemy}
	zakres={zakres}
	faq={faq}
/>
