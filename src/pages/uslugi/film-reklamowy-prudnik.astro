---
import LocalPage from '../../components/LocalPage.astro';
import { oneoffDeal, dzienPreset, zl } from '../../lib/pricing';
const dzien = oneoffDeal(dzienPreset);
const problemy = ["Firma działa od lat, ale w internecie prawie jej nie widać.", "Zdjęcia z telefonu nie pokazują, jak dobrą robotę robicie.", "Nie ma kto nagrywać i montować rolek co tydzień.", "Duże agencje są za daleko i za drogie."];
const zakres = [...[{"name": "Film reklamowy / wizerunkowy do 2 min", "price": "od 4 500 zł"}, {"name": "Dzień zdjęciowy (do 6 h)", "price": "od 1 150 zł"}, {"name": "Rolka z nagraniem u Ciebie", "price": "od 550 zł / szt."}, {"name": "Rolka z Twoich materiałów", "price": "od 390 zł / szt."}], { name: "Dzień contentowy: nagrania + 10 rolek + 4 grafiki", price: zl(dzien.final) }, {"name": "Dojazd do Prudnika", "price": "w cenie"}];
const faq = [{"q": "Ile kosztuje film reklamowy w Prudniku?", "a": "Film reklamowy lub wizerunkowy do 2 minut kosztuje od 4 500 zł. Dzień zdjęciowy to od 1 150 zł, a rolka nagrana u Ciebie od 550 zł. Dojazd do Prudnika jest w cenie."}, {"q": "Ile kosztuje dojazd do Prudnika?", "a": "Prudnik jest pół godziny od Nysy, więc dojazd jest w cenie — płacisz tylko za nagranie i montaż."}, {"q": "Czy możecie nagrać rolki w naszej firmie w Prudniku?", "a": "Tak. Najczęściej robimy to w formie dnia contentowego: przyjeżdżamy na jeden dzień, nagrywamy wszystko naraz, a potem dostajesz 10 rolek i 4 grafiki do publikacji przez miesiąc."}, {"q": "Jak szybko dostaniemy gotowy materiał?", "a": "Rolki zwykle w 5–7 dni roboczych od nagrania, film reklamowy w 2–3 tygodnie. Tryb ekspresowy poniżej 48 godzin jest możliwy za dopłatą 50%."}];
---
<LocalPage
	h1={"Film reklamowy i rolki Prudnik"}
	miasto={"Prudnik"}
	title={"Film reklamowy i rolki dla firm Prudnik — nagrania na miejscu | SVC"}
	description={"Film reklamowy, rolki i materiały rekrutacyjne dla firm z Prudnika i okolic. Nagrania na miejscu, montaż i animacje. Film od 4 500 zł, rolka od 550 zł. Dojazd: w cenie."}
	intro={"Nagrywamy filmy reklamowe i rolki dla firm z Prudnika i powiatu prudnickiego — od zakładów produkcyjnych po sklepy i usługi. Przyjeżdżamy z kamerą, nagrywamy w jeden dzień i montujemy materiał na cały miesiąc."}
	problemy={problemy}
	zakres={zakres}
	faq={faq}
/>
