---
import LocalPage from '../../components/LocalPage.astro';
const problemy = ["Logo powstało lata temu i nie pasuje już do firmy.", "Każda grafika w social mediach wygląda inaczej.", "Ulotki i plakaty robione na szybko w darmowych programach.", "Brak jednej osoby, która ogarnia całą oprawę marki."];
const zakres = [{"name": "Logo i identyfikacja wizualna", "price": "od 1 500 zł"}, {"name": "Grafika na social media (post, baner)", "price": "180 zł / szt."}, {"name": "Miniatura lub okładka", "price": "220 zł / szt."}, {"name": "Ulotka, plakat, roll-up", "price": "od 250 zł"}, {"name": "System oprawy graficznej marki", "price": "od 5 500 zł"}];
const faq = [{"q": "Ile kosztuje grafik w Nysie?", "a": "Pojedyncza grafika na social media kosztuje 180 zł, miniatura 220 zł, a logo z identyfikacją wizualną zaczyna się od 1 500 zł. Pełny zakres wycenisz w generatorze na stronie."}, {"q": "Czy można spotkać się osobiście w Nysie?", "a": "Tak. Firma jest zarejestrowana w Nysie, a spotkania w Nysie i Opolu są możliwe bez dopłat. Większość ustaleń prowadzimy też zdalnie."}, {"q": "Kto projektuje grafiki?", "a": "Projekty wykonuje Krzysztof Sobotka, absolwent Akademii Sztuk Pięknych we Wrocławiu, w branży od 2020 roku."}, {"q": "Czy otrzymam pliki do druku?", "a": "Tak. Materiały do druku przygotowujemy w formatach wymaganych przez drukarnię, z odpowiednimi spadami i profilem kolorów."}];
---
<LocalPage
	h1={"Grafika Nysa"}
	miasto={"Nysa"}
	title={"Grafika Nysa — projektowanie graficzne dla firm | SVC"}
	description={"Grafik w Nysie: logo, identyfikacja wizualna, grafiki na social media, ulotki i plakaty. Absolwent ASP. Sprawdź ceny i wyceń online."}
	intro={"Projektujemy grafikę dla firm z Nysy i powiatu nyskiego: od logo i identyfikacji wizualnej, przez materiały drukowane, po grafiki na social media. Spójnie, z myślą o tym, gdzie grafika będzie żyła."}
	problemy={problemy}
	zakres={zakres}
	faq={faq}
/>
