---
/* Lista usług (/uslugi/) — kafelki prowadzą do podstron usług. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SvcIcon from '../../components/ui/SvcIcon.astro';
import BookingCta from '../../components/ui/BookingCta.astro';
import { tx } from '../../lib/typo';
const files = import.meta.glob('../../data/uslugi/*.json', { eager: true }) as Record<string, any>;
const all = Object.entries(files)
	.map(([path, m]) => ({ slug: path.split('/').pop()!.replace('.json', ''), ...(m.default ?? m) }))
	.filter((s: any) => !s.draft)
	.sort((a: any, b: any) => (a.order ?? 99) - (b.order ?? 99));
const site = 'https://sobotkavisual.pl';
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Usługi Sobotka Visual Creations',
	itemListElement: all.map((s: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${site}/uslugi/${s.slug}/` })) };
---
<BaseLayout title="Usługi — montaż, animacja, rolki, grafika, transmisje | SVC" description="Montaż wideo, animacja i motion design, rolki, oprawa graficzna, oprawa transmisyjna oraz dźwięk i produkcja. Zobacz, co robimy i jak pracujemy.">
	<div class="us">
		<section class="us-hero">
			<span class="us-grid" aria-hidden="true"></span>
			<div class="us-wrap">
				<p class="us-eyebrow">Usługi</p>
				<h1 class="us-h1">Wszystko, czego potrzebują <b>Twoje media.</b></h1>
				<p class="us-lead">Od pojedynczej rolki po pełne zaplecze produkcyjne. Wybierz usługę, żeby zobaczyć zakres, sposób pracy, ceny i realizacje.</p>
				<div class="usi-grid">
					{all.map((s: any, i: number) => (
						<a href={`/uslugi/${s.slug}/`} class="usi svc-anim" style={`--d:${(i % 3) * 0.08}s`}>
							<span class="usi-ico"><SvcIcon name={s.icon || 'montaz'} /></span>
							<h2 set:html={tx(s.name)} />
							<p set:html={tx(s.hero?.lead)} />
							<span class="usi-more">Zobacz usługę →</span>
						</a>
					))}
				</div>
			</div>
		</section>
		<section class="us-final"><div class="us-wrap us-center"><h2 class="us-h2">Nie wiesz, od czego <span class="us-light">zacząć?</span></h2><div class="us-final-cta"><BookingCta /></div></div></section>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
<style is:global>
	.usi-grid { margin-top: 3rem; display: grid; gap: 1.2rem; }
	@media (min-width: 700px) { .usi-grid { grid-template-columns: 1fr 1fr; } }
	@media (min-width: 1024px) { .usi-grid { grid-template-columns: repeat(3, 1fr); } }
	.usi { display: flex; flex-direction: column; padding: 1.7rem; border-radius: 24px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1);
		opacity: 0; transform: translateY(24px); transition: opacity .6s var(--d), transform .8s var(--d) cubic-bezier(.2,.8,.2,1), border-color .3s, background .3s; }
	.usi.is-in { opacity: 1; transform: none; }
	.usi:hover { border-color: rgba(237,36,78,.6); background: rgba(237,36,78,.07); }
	.usi-ico { width: 58px; height: 58px; padding: 12px; border-radius: 16px; border: 1px solid rgba(255,255,255,.18); color: #fff; }
	.usi h2 { margin-top: 1.1rem; font-size: 22px; font-weight: 800; letter-spacing: -.02em; }
	.usi p { margin-top: .5rem; font-size: 15px; line-height: 1.55; color: var(--color-sky-mist); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
	.usi-more { margin-top: auto; padding-top: 1.1rem; font-weight: 700; color: var(--color-orange-glow); }
	@media (prefers-reduced-motion: reduce) { .usi { opacity: 1; transform: none; } }
</style>
<script>
	import '../../scripts/parallax.ts';
</script>
