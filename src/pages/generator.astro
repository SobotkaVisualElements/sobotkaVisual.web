---
import BaseLayout from '../layouts/BaseLayout.astro';

// Ceny z Cennika Master 2026
const packages = [
	{ id: 'start', name: 'START', price: 2500, desc: 'Stała obecność, bez wideo' },
	{ id: 'pro', name: 'PRO', price: 7200, desc: 'Pełne zaplecze marketingu' },
	{ id: 'studio', name: 'STUDIO', price: 12900, desc: 'Najwyższy poziom + strategia' },
];
const addons = [
	{ id: 'rolki', name: 'Rolki / shorty', price: 320, unit: 'szt.' },
	{ id: 'montaz', name: 'Montaż długiej formy', price: 1250, unit: 'szt.' },
	{ id: 'miniatury', name: 'Miniatury / okładki', price: 220, unit: 'szt.' },
	{ id: 'animacja', name: 'Animacje / motion', price: 900, unit: 'szt.' },
	{ id: 'grafika', name: 'Grafiki statyczne', price: 180, unit: 'szt.' },
];
const oneoff = [
	{ id: 'o-montaz', name: 'Montaż długiej formy (10–20 min)', price: 1250, unit: 'szt.' },
	{ id: 'o-skrot', name: 'Skrót meczowy / eventowy', price: 950, unit: 'szt.' },
	{ id: 'o-wizerunek', name: 'Materiał wizerunkowy do 2 min', price: 4500, unit: 'szt.' },
	{ id: 'o-rolka', name: 'Rolka / short / TikTok', price: 320, unit: 'szt.' },
	{ id: 'o-trailer', name: 'Trailer animowany 30–45 s', price: 4300, unit: 'szt.' },
	{ id: 'o-animacja', name: 'Animacja na zamówienie', price: 3200, unit: 'min' },
	{ id: 'o-miniatura', name: 'Miniatura / okładka', price: 220, unit: 'szt.' },
	{ id: 'o-oprawa', name: 'System oprawy graficznej', price: 5500, unit: 'pakiet' },
	{ id: 'o-trans', name: 'Oprawa transmisyjna', price: 6000, unit: 'pakiet' },
];
---

<BaseLayout title="Zaprojektuj własny pakiet" description="Skonfiguruj współpracę i zobacz, ile zyskujesz — Sobotka Visual Creations.">
	<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
		<div class="relative z-2 mx-auto max-w-[1080px] px-6 pt-24 pb-20 sm:px-8">
			<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">Generator</span>
			<h1 class="mt-3 text-[36px] font-bold tracking-[-0.02em] md:text-[52px]">Zaprojektuj współpracę</h1>
			<p class="mt-4 max-w-[560px] text-[18px] text-sky-mist">Przesuń suwaki, a wycena policzy się sama. Im więcej elementów, tym większy rabat — do 30%.</p>

			<!-- ZAKŁADKI -->
			<div class="mt-8 inline-flex rounded-full glass p-1">
				<button data-tab="stala" class="tab-btn rounded-full px-6 py-2.5 text-[15px] font-bold text-cloud transition-colors">Współpraca stała</button>
				<button data-tab="jednorazowa" class="tab-btn rounded-full px-6 py-2.5 text-[15px] font-bold text-sky-mist transition-colors">Jednorazowa</button>
			</div>

			<div class="mt-8 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
				<div>
					<!-- PANEL: STAŁA -->
					<div data-panel="stala">
						<h2 class="mb-4 text-lg font-bold text-cloud">Pakiet bazowy</h2>
						<div class="grid gap-3 sm:grid-cols-3">
							{packages.map((pkg, i) => (
								<label class="cursor-pointer">
									<input type="radio" name="pakiet" value={pkg.id} data-price={pkg.price} data-name={pkg.name} checked={i === 1} class="peer sr-only" />
									<span class="block h-full rounded-2xl border border-white/12 bg-white/5 p-4 transition-colors peer-checked:border-orange peer-checked:bg-orange/10">
										<span class="block font-display text-lg font-bold text-cloud">{pkg.name}</span>
										<span class="mt-0.5 block text-[12px] text-sky-mist">{pkg.desc}</span>
										<span class="mt-2 block font-semibold text-orange-glow">{pkg.price.toLocaleString('pl-PL')} zł/mies.</span>
									</span>
								</label>
							))}
						</div>
						<h2 class="mt-7 mb-3 text-lg font-bold text-cloud">Dorzuć elementy miesięczne</h2>
						<div class="glass flex flex-col gap-5 rounded-2xl p-6">
							{addons.map((a) => (
								<div class="gen-row" data-price={a.price} data-name={a.name}>
									<div class="flex items-center justify-between text-[15px]">
										<span class="font-semibold text-cloud">{a.name}</span>
										<span class="text-sky-mist"><b class="gen-qty text-cloud">0</b> × {a.price} zł</span>
									</div>
									<input type="range" min="0" max="12" value="0" class="gen-slider mt-2 w-full" />
								</div>
							))}
						</div>
					</div>

					<!-- PANEL: JEDNORAZOWA -->
					<div data-panel="jednorazowa" class="hidden">
						<h2 class="mb-3 text-lg font-bold text-cloud">Złóż projekt z elementów</h2>
						<div class="glass flex flex-col gap-5 rounded-2xl p-6">
							{oneoff.map((a) => (
								<div class="gen-row" data-price={a.price} data-name={a.name}>
									<div class="flex items-center justify-between text-[15px]">
										<span class="font-semibold text-cloud">{a.name}</span>
										<span class="text-sky-mist"><b class="gen-qty text-cloud">0</b> × {a.price} zł</span>
									</div>
									<input type="range" min="0" max="10" value="0" class="gen-slider mt-2 w-full" />
								</div>
							))}
						</div>
					</div>
				</div>

				<!-- PODSUMOWANIE -->
				<div>
					<div class="glass sticky top-24 rounded-2xl p-6">
						<!-- pasek rabatu (Duolingo) -->
						<div class="mb-1 flex items-center justify-between text-[13px]">
							<span class="text-sky-mist">Odblokowany rabat</span>
							<span id="gen-disc" class="font-bold text-emerald-400">0%</span>
						</div>
						<div class="h-2.5 w-full overflow-hidden rounded-full bg-white/10">
							<div id="gen-bar" class="h-full w-0 rounded-full bg-emerald-400 transition-all duration-300"></div>
						</div>
						<p id="gen-nudge" class="mt-2 text-[12px] text-emerald-300/90">Dodawaj elementy, aby odblokować większy rabat (do 30%).</p>

						<!-- ZYSKUJESZ -->
						<div class="mt-5 rounded-xl bg-emerald-400/10 p-4 text-center">
							<div class="text-[13px] font-bold tracking-wide text-emerald-300 uppercase">Zyskujesz do</div>
							<div id="gen-save" class="font-display text-[38px] font-bold text-emerald-400">0 zł</div>
						</div>

						<!-- cena -->
						<div class="mt-4 flex items-baseline justify-between">
							<span class="text-sm text-sky-mist">Twoja cena</span>
							<div class="text-right">
								<span id="gen-old" class="mr-2 text-sm text-slate-500 line-through"></span>
								<span id="gen-price" class="font-display text-[26px] font-bold text-cloud">0 zł</span>
								<span id="gen-per" class="text-sm text-sky-mist">/mies.</span>
							</div>
						</div>

						<div class="mt-5 flex flex-col gap-3">
							<input id="gen-firma" type="text" placeholder="Nazwa / firma" class="gen-inp" />
							<input id="gen-nip" type="text" placeholder="NIP (opcjonalnie)" class="gen-inp" />
							<input id="gen-email" type="email" placeholder="Twój e-mail *" class="gen-inp" />
							<input id="gen-tel" type="tel" placeholder="Telefon (opcjonalnie)" class="gen-inp" />
						</div>
						<button id="gen-send" type="button" class="btn-saber mt-4 w-full rounded-full bg-orange py-3.5 font-bold text-cloud transition-transform hover:-translate-y-0.5">Wyślij zapytanie</button>
						<p id="gen-info" class="mt-3 hidden text-center text-sm text-emerald-300">Dziękujemy! Odezwiemy się do 48 godzin.</p>
						<p class="mt-3 text-center text-[11px] text-slate-500">Wycena orientacyjna. Rabat przy współpracy 3+ mies.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style is:global>
	.gen-inp { border-radius:.5rem; border:1px solid rgba(255,255,255,.15); background:rgba(255,255,255,.05); padding:.625rem .875rem; color:var(--color-cloud); outline:none; }
	.gen-inp::placeholder { color:#94a3b8; } .gen-inp:focus { border-color:var(--color-orange); }
	.gen-slider { -webkit-appearance:none; appearance:none; height:6px; border-radius:999px; background:rgba(255,255,255,.15); outline:none; }
	.gen-slider::-webkit-slider-thumb { -webkit-appearance:none; appearance:none; width:20px; height:20px; border-radius:50%; background:var(--color-orange); cursor:pointer; box-shadow:0 0 0 4px rgba(237,36,78,.25); transition:transform .15s; }
	.gen-slider::-webkit-slider-thumb:hover { transform:scale(1.15); }
	.gen-slider::-moz-range-thumb { width:20px; height:20px; border:none; border-radius:50%; background:var(--color-orange); cursor:pointer; }
	.tab-btn.active { background:var(--color-orange); color:var(--color-cloud); }
</style>
<script>
	const fmt = (n: number) => Math.round(n).toLocaleString('pl-PL') + ' zł';
	let tab: 'stala' | 'jednorazowa' = 'stala';

	const $ = (id: string) => document.getElementById(id);
	const rows = () => Array.from(document.querySelectorAll<HTMLElement>(`[data-panel="${tab}"] .gen-row`));
	const pkg = () => document.querySelector<HTMLInputElement>('input[name="pakiet"]:checked');

	const calc = () => {
		let base = 0, count = 0;
		if (tab === 'stala') { const p = pkg(); if (p) { base += parseFloat(p.dataset.price || '0'); count += 1; } }
		rows().forEach((r) => {
			const q = parseInt(r.querySelector<HTMLInputElement>('.gen-slider')!.value) || 0;
			(r.querySelector('.gen-qty') as HTMLElement).textContent = String(q);
			if (q > 0) { base += q * parseFloat(r.dataset.price || '0'); count += 1; }
		});
		const disc = Math.min(30, count * 5);           // rośnie stopniowo, do 30%
		const save = base * disc / 100;
		const price = base - save;
		($('gen-disc') as HTMLElement).textContent = disc + '%';
		($('gen-bar') as HTMLElement).style.width = (disc / 30 * 100) + '%';
		($('gen-save') as HTMLElement).textContent = fmt(save);
		($('gen-price') as HTMLElement).textContent = fmt(price);
		($('gen-old') as HTMLElement).textContent = save > 0 ? fmt(base) : '';
		($('gen-per') as HTMLElement).textContent = tab === 'stala' ? '/mies.' : '';
		($('gen-nudge') as HTMLElement).textContent = disc >= 30 ? 'Maksymalny rabat 30% odblokowany! 🎉' : 'Dodawaj elementy, aby odblokować większy rabat (do 30%).';
		return { base, disc, save, price, count };
	};

	document.querySelectorAll<HTMLInputElement>('.gen-slider').forEach((s) => s.addEventListener('input', calc));
	document.querySelectorAll<HTMLInputElement>('input[name="pakiet"]').forEach((r) => r.addEventListener('change', calc));

	document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			tab = (btn.dataset.tab as 'stala' | 'jednorazowa');
			document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((b) => {
				const on = b === btn; b.classList.toggle('active', on);
				b.classList.toggle('text-cloud', on); b.classList.toggle('text-sky-mist', !on);
			});
			document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== tab));
			calc();
		});
	});

	// wstępny pakiet z ?pakiet=
	const param = new URLSearchParams(location.search).get('pakiet');
	if (param) { const m = document.querySelector<HTMLInputElement>(`input[name="pakiet"][value="${param}"]`); if (m) m.checked = true; }
	(document.querySelector('.tab-btn[data-tab="stala"]') as HTMLElement)?.classList.add('active');
	calc();

	$('gen-send')?.addEventListener('click', () => {
		const r = calc();
		const email = ($('gen-email') as HTMLInputElement).value.trim();
		if (!email) { alert('Podaj e-mail, żebyśmy mogli odpisać.'); return; }
		const lines = rows().filter((x) => (parseInt(x.querySelector<HTMLInputElement>('.gen-slider')!.value) || 0) > 0)
			.map((x) => `- ${x.dataset.name}: ${x.querySelector<HTMLInputElement>('.gen-slider')!.value} x ${x.dataset.price} zł`);
		const p = pkg();
		const body = [
			`Zapytanie z generatora — współpraca ${tab === 'stala' ? 'STAŁA' : 'JEDNORAZOWA'}`, '',
			...(tab === 'stala' && p ? [`Pakiet: ${p.dataset.name} (${p.dataset.price} zł/mies.)`, ''] : []),
			'Elementy:', ...(lines.length ? lines : ['(brak)']), '',
			`Rabat: ${r.disc}%  |  Zysk: ${fmt(r.save)}`,
			`Cena: ${fmt(r.price)}${tab === 'stala' ? '/mies.' : ''}`, '',
			`Firma: ${($('gen-firma') as HTMLInputElement).value || '-'}`,
			`NIP: ${($('gen-nip') as HTMLInputElement).value || '-'}`,
			`E-mail: ${email}`,
			`Telefon: ${($('gen-tel') as HTMLInputElement).value || '-'}`,
		].join('\n');
		window.location.href = `mailto:kontakt@sobotkavisual.pl?subject=${encodeURIComponent('Zapytanie z generatora')}&body=${encodeURIComponent(body)}`;
		$('gen-info')?.classList.remove('hidden');
	});
</script>
