---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
	{ id: 'montaz-long', name: 'Montaż długiej formy (10–20 min)', price: 1250, unit: 'szt.' },
	{ id: 'skrot', name: 'Skrót meczowy / materiał eventowy', price: 950, unit: 'szt.' },
	{ id: 'wizerunek', name: 'Materiał wizerunkowy do 2 min', price: 4500, unit: 'szt.' },
	{ id: 'rolka', name: 'Rolka pionowa / short / TikTok', price: 320, unit: 'szt.' },
	{ id: 'rolki8', name: 'Pakiet 8 rolek', price: 2000, unit: 'pakiet' },
	{ id: 'animacja', name: 'Animacja na zamówienie', price: 3200, unit: 'min' },
	{ id: 'trailer', name: 'Trailer animowany 30–45 s', price: 4300, unit: 'szt.' },
	{ id: 'miniatura', name: 'Miniatura / okładka', price: 220, unit: 'szt.' },
	{ id: 'oprawa-graf', name: 'System oprawy graficznej', price: 5500, unit: 'pakiet' },
	{ id: 'oprawa-trans', name: 'Oprawa transmisyjna (pakiet)', price: 6000, unit: 'pakiet' },
];
---

<BaseLayout title="Zaprojektuj własny pakiet" description="Skonfiguruj zakres współpracy i otrzymaj orientacyjną wycenę od Sobotka Visual Creations.">
	<section class="relative overflow-hidden bg-linear-155 from-navy to-navy-deep text-cloud">
		<span class="pointer-events-none absolute inset-0 bg-grid opacity-35"></span>
		<div class="relative z-2 mx-auto max-w-[980px] px-8 pt-24 pb-20">
			<span class="text-[13px] font-bold tracking-[0.12em] text-orange-glow uppercase">Generator</span>
			<h1 class="mt-3 text-[38px] font-bold tracking-[-0.02em] md:text-[52px]">Zaprojektuj własny pakiet</h1>
			<p class="mt-4 max-w-[560px] text-[18px] text-sky-mist">Zaznacz, czego potrzebujesz. Wycena liczy się na żywo — to kwota orientacyjna, ostateczną potwierdzam po rozmowie.</p>

			<div class="mt-10 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
				<!-- pozycje -->
				<div class="glass rounded-2xl p-6">
					<div class="flex flex-col divide-y divide-white/10">
						{items.map((it) => (
							<div class="flex items-center justify-between gap-4 py-3.5">
								<div>
									<div class="font-semibold text-cloud">{it.name}</div>
									<div class="text-[13px] text-sky-mist">{it.price} zł / {it.unit}</div>
								</div>
								<input type="number" min="0" value="0" data-price={it.price} data-name={it.name}
									class="gen-qty w-16 rounded-lg border border-white/15 bg-white/5 px-2.5 py-1.5 text-center font-semibold text-cloud outline-none focus:border-orange" />
							</div>
						))}
					</div>
				</div>

				<!-- podsumowanie + kontakt -->
				<div class="glass rounded-2xl p-6">
					<div class="flex items-baseline justify-between">
						<span class="text-sm text-sky-mist">Wycena orientacyjna</span>
						<span id="gen-total" class="font-display text-[34px] font-bold text-orange">0 zł</span>
					</div>
					<div class="mt-5 flex flex-col gap-3">
						<input id="gen-firma" type="text" placeholder="Nazwa / firma" class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-cloud placeholder:text-slate-400 outline-none focus:border-orange" />
						<input id="gen-nip" type="text" placeholder="NIP (opcjonalnie)" class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-cloud placeholder:text-slate-400 outline-none focus:border-orange" />
						<input id="gen-email" type="email" placeholder="Twój e-mail *" class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-cloud placeholder:text-slate-400 outline-none focus:border-orange" />
						<input id="gen-tel" type="tel" placeholder="Telefon (opcjonalnie)" class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-cloud placeholder:text-slate-400 outline-none focus:border-orange" />
						<textarea id="gen-opis" rows="3" placeholder="Krótko o projekcie" class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-cloud placeholder:text-slate-400 outline-none focus:border-orange"></textarea>
					</div>
					<button id="gen-send" type="button" class="btn-saber mt-5 w-full rounded-full bg-orange py-3.5 font-bold text-cloud transition-transform hover:-translate-y-0.5">Wyślij zapytanie</button>
					<p id="gen-info" class="mt-4 hidden text-center text-sm text-orange-glow">Dziękujemy! Skontaktujemy się do 48 godzin.</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const fmt = (n: number) => n.toLocaleString('pl-PL') + ' zł';
	const qtys = Array.from(document.querySelectorAll<HTMLInputElement>('.gen-qty'));
	const totalEl = document.getElementById('gen-total');
	const calc = () => {
		let sum = 0;
		qtys.forEach((q) => { sum += (parseInt(q.value) || 0) * parseFloat(q.dataset.price || '0'); });
		if (totalEl) totalEl.textContent = fmt(sum);
		return sum;
	};
	qtys.forEach((q) => q.addEventListener('input', calc));

	document.getElementById('gen-send')?.addEventListener('click', () => {
		const total = calc();
		const lines = qtys.filter((q) => (parseInt(q.value) || 0) > 0).map((q) => `- ${q.dataset.name}: ${q.value} x ${q.dataset.price} zł`);
		const email = (document.getElementById('gen-email') as HTMLInputElement)?.value.trim();
		if (!email) { alert('Podaj swój e-mail, żebyśmy mogli odpisać.'); return; }
		const firma = (document.getElementById('gen-firma') as HTMLInputElement)?.value;
		const nip = (document.getElementById('gen-nip') as HTMLInputElement)?.value;
		const tel = (document.getElementById('gen-tel') as HTMLInputElement)?.value;
		const opis = (document.getElementById('gen-opis') as HTMLTextAreaElement)?.value;
		const body = [
			'Zapytanie z generatora pakietów', '',
			'Zakres:', ...(lines.length ? lines : ['(nie wybrano pozycji)']), '',
			`Wycena orientacyjna: ${fmt(total)}`, '',
			`Firma: ${firma || '-'}`, `NIP: ${nip || '-'}`, `E-mail: ${email}`, `Telefon: ${tel || '-'}`, '',
			`Opis: ${opis || '-'}`,
		].join('\n');
		window.location.href = `mailto:kontakt@sobotkavisual.pl?subject=${encodeURIComponent('Zapytanie z generatora — ' + (firma || email))}&body=${encodeURIComponent(body)}`;
		document.getElementById('gen-info')?.classList.remove('hidden');
	});
</script>
